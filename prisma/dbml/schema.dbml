  materialAmount Decimal [not null, default: 0]
  status WorkOrderStatus [not null, default: 'draft']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'Work subcontracted on a project.'
}

Table ProjectBudget {
  id String [pk]
  companyId String [not null]
  projectId String [not null]
  project Project [not null]
  category ProjectBudgetCategory [not null]
  amount Decimal [not null]
  updatedAt DateTime [not null]

  indexes {
    (projectId, category) [unique]
  }

  Note: 'Budgeted spend per cost category, one row per category per project. Compared
against actuals sourced live from the owning modules — never stored here.'
}

Table ProjectDocument {
  id String [pk]
  companyId String [not null]
  projectId String [not null]
  project Project [not null]
  documentType String [not null]
  fileRef String [not null]
  filePath String
  remark String
  uploadedByUserId String [not null, note: '`shared.User.id`. Bare id — see the schema-level note above.']
  uploadedAt DateTime [default: `now()`, not null]

  Note: 'A file attached to a project, stored as an object-storage reference rather than
bytes — same pattern as `hr.EmployeeDocument`.'
}

Table Employee {
  id String [pk]
  userId String [unique, not null, note: 'The account this employee record belongs to (`shared.User.id`). Unique: an
account maps to exactly one employee record, which is what lets every `/my/*`
endpoint resolve the caller\'s own employee from their token alone and never
accept an employeeId parameter (FR-028).']
  companyId String [not null, note: 'RLS-protected. Bare id, not a relation — see the note on `Site.companyId`.']
  siteId String [not null, note: '`projects.Site.id`; read through `SitesService`.']
  shiftId String [not null, note: '`settings.Shift.id`; the shift duration OT is computed against, read through
`SettingsModule`\'s exported service (research.md §9).']
  employeeCode String [not null, note: 'Allocated by `settings`\' employee-code sequence (feature 002).']
  firstName String
  lastName String
  title String
  dob DateTime
  gender Gender
  maritalStatus MaritalStatus
  photoRef String
  departmentId String [note: '`settings.Department.id` / `settings.Designation.id` — bare ids, resolved via
SettingsService. No cross-schema Prisma relation (Constitution Principle I).']
  designationId String
  employmentType EmploymentType [default: 'full_time']
  dateOfJoining DateTime
  probationEndDate DateTime
  confirmationDate DateTime
  reportingToEmployeeId String
  musterCategory String
  hoursPerDay Decimal
  dailyRate Decimal
  payMode String
  calculationMode CalculationMode [default: 'monthly']
  workmanId String
  isActive Boolean [not null, default: true]
  pfApplicable Boolean [not null, default: false]
  pfUpperLimit Boolean [not null, default: false]
  esicApplicable Boolean [not null, default: false]
  esicUpperLimit Boolean [not null, default: false]
  uan String
  pfNumber String
  esicNumber String
  aadhaarEncrypted String [note: 'Regulated PII (Constitution Principle IV). Stored encrypted at rest, masked to
last 4 by PiiMaskingInterceptor, unmasked only via the audited reveal-pii path.']
  panEncrypted String
  basic Decimal
  hra Decimal
  conveyanceAllowance Decimal
  siteAllowance Decimal
  specialAllowance Decimal
  paymentMode String
  bankName String
  bankBranch String
  bankAccountNumberEncrypted String [note: 'Regulated PII — see aadhaarEncrypted.']
  ifscCode String
  mobile String
  alternateMobile String
  email String
  presentAddress String
  presentCity String
  presentState String
  presentPinCode String
  permanentAddress String
  permanentCity String
  permanentState String
  permanentPinCode String
  emergencyContactName String
  emergencyContactRelation String
  emergencyContactPhone String
  offerLetterIssued Boolean [not null, default: false]
  offerLetterIssuedDate DateTime
  appointmentLetterIssued Boolean [not null, default: false]
  appointmentLetterIssuedDate DateTime
  ndaSigned Boolean [not null, default: false]
  ndaSignedDate DateTime
  idCardIssued Boolean [not null, default: false]
  uniformProvided Boolean [not null, default: false]
  safetyInductionCompleted Boolean [not null, default: false]
  toolsIssued Boolean [not null, default: false]
  bankVerificationDone Boolean [not null, default: false]
  biometricEnrolled Boolean [not null, default: false]
  siteAccessGranted Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  faceEnrolment FaceEnrolment
  reEnrolmentRequests ReEnrolmentRequest [not null]
  punchRecords PunchRecord [not null]
  leaveBalances LeaveBalance [not null]
  leaveApplications LeaveApplication [not null]
  reimbursementClaims ReimbursementClaim [not null]
  salarySlips SalarySlip [not null]
  documents EmployeeDocument [not null]
  transfers EmployeeTransfer [not null]
  attendanceModifications AttendanceModification [not null]
  exitRecords ExitRecord [not null]
  payrollLineItems PayrollLineItem [not null]
  loans Loan [not null]
  taxDeclarations TaxDeclaration [not null]
  salaryAdvances SalaryAdvance [not null]

  indexes {
    (companyId, employeeCode) [unique]
  }

  Note: 'The minimal Employee record this feature needs: the bridge from a logged-in
account to the site, shift, and attendance data that hang off it. A future HR &
Payroll admin feature extends this (department, designation, joining date)
rather than redefining it (research.md §9).'
}

Table FaceEnrolment {
  id String [pk]
  employeeId String [unique, not null]
  employee Employee [not null]
  descriptor Bytes [note: 'The derived 128-float face descriptor, encrypted at rest — never the raw
photos, which is the whole point of storing a descriptor (research.md §2):
a punch compares one vector instead of re-running inference against every
enrolled image. Null while `status` is `not_enrolled`.']
  photoRefs String[] [not null, note: 'Encrypted object-storage references to the 3–5 captured photos. The blobs
themselves live in `StorageService`, not here — only large binaries leave
Postgres (constitution v1.4.0).']
  consentMethod ConsentMethod
  consentAcknowledgedAt DateTime
  enrolledAt DateTime
  status FaceEnrolmentStatus [not null, default: 'not_enrolled']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'Exactly one row per employee. A completed re-enrolment replaces `descriptor`,
`photoRefs`, and `enrolledAt` in place — "previous template securely deleted"
(FR-016) means the prior values are overwritten, never retained as history.'
}

Table ReEnrolmentRequest {
  id String [pk]
  employeeId String [not null]
  employee Employee [not null]
  reason String [not null]
  status ReEnrolmentRequestStatus [not null, default: 'pending']
  adminRemarks String [note: 'Mandatory when `status` is `rejected` — enforced at the DTO/service layer,
since a conditional NOT NULL is not expressible in the schema.']
  decidedByUserId String
  decidedAt DateTime
  unlockExpiresAt DateTime [note: 'Set on approval, `reEnrolment.unlockDurationDays` out (FR-015).']
  unlockConsumedAt DateTime [note: 'Set when the fresh capture completes, so one approval cannot be reused (FR-016).']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'An employee\'s request to re-capture their face template (e.g. after an injury or
a persistent match failure), and the admin decision on it. Approval opens a
time-boxed unlock that a single fresh capture consumes (FR-013–FR-016).'
}

Table PunchRecord {
  id String [pk]
  employeeId String [not null]
  employee Employee [not null]
  type PunchType [not null]
  capturedAt DateTime [not null, note: 'The official punch time, declared by the client so an offline-queued punch
records when the worker actually punched rather than when connectivity
returned (research.md §4).']
  receivedAt DateTime [default: `now()`, not null, note: 'Server receipt time. Both are retained because FR-012 requires offline syncs
to stay visible in audit rather than being flattened into one timestamp.']
  isOfflineSync Boolean [not null, default: false, note: 'Derived: `capturedAt` trails `receivedAt` by more than the configured clock-skew
tolerance. The tolerance is what stops ordinary clock drift from labelling every
normal punch an offline sync.']
  photoRef String [note: 'Encrypted object-storage reference to the captured selfie.
Null only for `admin_correction` rows, which have no capture. A CHECK
constraint keeps this mandatory for employee-sourced punches.']
  faceMatchResult FaceMatchResult
  faceMatchDistance Decimal [note: 'The measured descriptor distance behind `faceMatchResult`. Kept so an admin
resolving an exception can see how near the miss was, and so the configured
threshold can be retuned against real data instead of guesswork.']
  latitude Decimal
  longitude Decimal
  geofenceResult GeofenceResult
  geofenceDistanceMeters Decimal [note: 'Measured metres from the site centre, retained for the same reason as
`faceMatchDistance`.']
  punchDate DateTime [not null, note: 'On a punch-in, the id of the punch-out that closed it; null while the punch-in
is still open. This is what makes "at most one open punch-in per employee"
(FR-008) enforceable as a partial unique index in the database, instead of
resting solely on an application-level check that two concurrent requests can
both pass. Always null on a punch-out record.
The calendar day this punch counts for, in the configured timezone (FR-018a).

Stamped at insert rather than derived on read: `AT TIME ZONE` with a named zone
is STABLE, not IMMUTABLE, so Postgres will not build a unique index over the
expression — and FR-008c needs exactly that index. The cost is that changing
APP_TIMEZONE later does not reclassify punches already recorded, which for
payroll data is the safer direction.']
  source PunchSource [not null, default: 'employee', note: 'Who wrote this punch. The FR-008c uniqueness constraint binds only `employee`
rows, so feature 005\'s future corrections are not forbidden by the schema, and
rows predating FR-008 (`legacy`) keep their multiple pairs per day.']
  closedByPunchId String [unique]
  exceptionResolution ExceptionResolution [note: 'Null unless either result above is `exception`; then `pending` until an admin
acts (FR-011a).']
  resolvedByUserId String
  resolvedAt DateTime
  adminEdited Boolean [not null, default: false, note: 'Set when an admin created or corrected this record through the HR admin
Mark/Edit action rather than the employee\'s own punch flow. Every such edit
also writes an append-only AttendanceModification row carrying before/after.']
  editedByUserId String
  editedAt DateTime
  statusOverride AttendanceStatusOverride [note: 'Forces the derived day status instead of letting statusForDay() compute it —
used when an admin marks a day present/absent against what the punches imply.']
  remarks String
  createdAt DateTime [default: `now()`, not null]

  Note: 'One punch event. Recorded whether or not verification succeeded: a failed face
match or an out-of-geofence position becomes an exception for an admin to
resolve, never a rejected request (FR-007) — a worker who is physically present
must not be silently absent from payroll because of a bad camera angle.'
}

Table LeaveBalance {
  id String [pk]
  employeeId String [not null]
  employee Employee [not null]
  leaveType LeaveTypeCode [not null]
  financialYear String [not null, note: 'Indian financial year, e.g. "2026-27".']
  opening Decimal [not null, default: 0]
  accrued Decimal [not null, default: 0]
  used Decimal [not null, default: 0]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (employeeId, leaveType, financialYear) [unique]
  }

  Note: 'Per-employee, per-financial-year leave entitlement. `balance` is deliberately not
a column: storing `opening + accrued - used` alongside its own inputs is a second
source of truth that drifts the first time one of them is written without the
other (data-model.md "Leave Balance").'
}

Table LeaveApplication {
  id String [pk]
  employeeId String [not null]
  employee Employee [not null]
  leaveType LeaveTypeCode [not null]
  fromDate DateTime [not null]
  toDate DateTime [not null]
  dayCount Decimal [not null, note: 'Computed server-side at submission, excluding weekly offs and site holidays
(FR-019) — never taken from the client, which would let a caller understate
the cost of their own leave.']
  reason String [not null]
  status LeaveApplicationStatus [not null, default: 'pending']
  adminRemarks String [note: 'Mandatory when `status` is `rejected` (FR-022a); enforced at the service layer.']
  decidedByUserId String
  decidedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table ReimbursementClaim {
  id String [pk]
  employeeId String [not null]
  employee Employee [not null]
  companyId String [not null, note: 'Denormalized from the owning Employee so the claim can be RLS-filtered by a
plain equality. Unlike the attendance tables, a claim is a financial document
that must stay with the company it was incurred against even if the employee
later moves — so the copy here is the intended record, not a cache of
Employee\'s value.']
  categoryId String [not null, note: 'FK to `settings.ReimbursementCategory` by value only. No Prisma relation:
Principle I routes the read through `ReimbursementCategoriesService`, and a
declared relation is exactly the cross-schema join that would bypass it.']
  amount Decimal [not null]
  expenseDate DateTime [not null]
  description String [not null]
  receiptRef String [note: 'Encrypted object-storage reference to the receipt image. Mandatory above the
category\'s configured threshold (FR-030).']
  status ReimbursementClaimStatus [not null, default: 'submitted']
  paymentMode ReimbursementPaymentMode [note: 'Written by feature 005 once a claim is approved and paid; never by this one.']
  paymentReference String
  decidedByUserId String [note: 'Feature 005\'s decision fields. Present here because the table is shared, and
splitting them into a second table would make "one claim, one status" untrue.']
  decidedAt DateTime
  adminRemarks String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'An employee-originated expense claim (US8).

In `hr`, not `payroll`, because the claim exists as the employee\'s own record
long before payroll has any interest in it — the same shape Leave already has
(research.md §10). Feature 005 adds the admin review layer over this same table;
it does not get a second one. This feature writes only `draft` → `submitted` →
`withdrawn`; the approval and payment fields below are read-only here.'
}

Table EmployeeDocument {
  id String [pk]
  employeeId String [not null]
  documentTypeId String [not null, note: '`settings.DocumentType.id`; resolved via SettingsService, not a relation.']
  fileRef String [not null, note: 'Encrypted object-storage reference, same mechanism as 003\'s biometric blobs.']
  documentNumber String
  expiresAt DateTime
  uploadedByUserId String [not null]
  uploadedAt DateTime [default: `now()`, not null]
  employee Employee [not null]

  indexes {
    (employeeId, documentTypeId) [unique]
  }

  Note: 'Per-employee uploaded document, keyed to a `settings.DocumentType` (002). A
re-upload replaces the reference for that type — historical versions are not
retained (data-model.md §Employee Document).'
}

Table EmployeeTransfer {
  id String [pk]
  employeeId String [not null]
  fromCompanyId String [not null]
  toCompanyId String [not null]
  transferDate DateTime [not null]
  reason String [not null]
  codeRetained Boolean [not null, default: false, note: 'When false, a fresh code is allocated in the destination company.']
  newEmployeeCode String
  transferredByUserId String [not null]
  createdAt DateTime [default: `now()`, not null]
  employee Employee [not null]

  Note: 'Append-only record of an employee moving between companies (US8).'
}

Table Holiday {
  id String [pk]
  companyId String [not null, note: 'Company-level calendar, not employee-owned — keeps its own tenant key.']
  name String [not null]
  date DateTime [not null]
  type HolidayType [not null, default: 'company']
  appliesToAllSites Boolean [not null, default: true, note: 'When false, applicability is restricted to the sites in `sites`.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  sites HolidaySite [not null]

  indexes {
    (companyId, date, name) [unique]
  }

  Note: 'Supersedes `projects.Site.holidays` (research.md §6) — a first-class, typed,
company-scoped holiday calendar that attendance status computation reads.'
}

Table HolidaySite {
  holidayId String [not null]
  siteId String [not null, note: '`projects.Site.id` — bare id, resolved via SitesService.']
  holiday Holiday [not null]

  indexes {
    (holidayId, siteId) [pk]
  }
}

Table AttendanceModification {
  id String [pk]
  employeeId String [not null]
  date DateTime [not null]
  actorUserId String [not null]
  before Json [not null]
  after Json [not null]
  reason String
  createdAt DateTime [default: `now()`, not null]
  employee Employee [not null]

  Note: 'Append-only audit of every manual attendance edit (FR-010). Never updated.'
}

Table ExitRecord {
  id String [pk]
  employeeId String [not null]
  lastWorkingDay DateTime [not null]
  reason ExitReason [not null]
  remarks String
  fnfPayrollRunId String [note: '`payroll.PayrollRun.id` of the F&F run — bare id, cross-schema by service.']
  initiatedByUserId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  employee Employee [not null]

  Note: 'Employee offboarding record (US11). The F&F settlement itself is a normal
PayrollRun flagged `isFnf`, linked here.'
}

Table TaxDeclaration {
  id String [pk]
  employeeId String [not null]
  financialYear String [not null]
  regime TaxRegime [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  employee Employee [not null]
  lines TaxDeclarationLine [not null]

  indexes {
    (employeeId, financialYear) [unique]
  }

  Note: 'An employee\'s investment declaration for a financial year (US14, FR-052).'
}

Table TaxDeclarationLine {
  id String [pk]
  declarationId String [not null]
  sectionCode String [not null]
  declaredAmount Decimal [not null]
  cappedAmount Decimal [not null]
  status TaxDeclarationStatus [not null, default: 'declared']
  proofRef String
  verifiedByUserId String
  verifiedAt DateTime
  declaration TaxDeclaration [not null]

  indexes {
    (declarationId, sectionCode) [unique]
  }

  Note: 'One declared deduction, e.g. 80C. `cappedAmount` is what actually reduces
taxable income — the declared figure is retained so an employee can see that
their claim was capped rather than silently reduced.'
}

Table SalaryAdvance {
  id String [pk]
  employeeId String [not null]
  amount Decimal [not null]
  reason String [not null]
  recoveryMonth String [not null, note: 'Period key, `YYYY-MM`, the recovery is attempted in.']
  outstandingBalance Decimal [not null]
  exceedsLimit Boolean [not null, default: false, note: 'Above the configured multiple of monthly net; needs explicit approval.']
  status SalaryAdvanceStatus [not null, default: 'pending']
  approvedByUserId String
  disbursedOn DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  employee Employee [not null]

  Note: 'A salary advance (US15, FR-054).

Deliberately NOT a `payroll.Loan`: an advance carries no interest and no
amortisation schedule, and is recovered in full in one nominated month. Modelling
it as a one-instalment loan would put two different things behind one screen and
one set of rules.'
}

Table PayrollRun {
  id String [pk]
  companyId String [not null, note: 'RLS-protected. Bare id — see the note on `Site.companyId`.']
  period String [not null, note: 'Period key, e.g. "2026-07".']
  status PayrollRunStatus [not null, default: 'draft']
  isFnf Boolean [not null, default: false, note: 'An F&F settlement run covers exactly one exiting employee and is flagged for
reporting/audit (research.md §12, US11).']
  generatedAt DateTime
  generatedByUserId String
  processedAt DateTime
  paidAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  lineItems PayrollLineItem [not null]

  Note: 'Status only. This feature reads it for two things: whether a period is locked to
further attendance writes (FR-010), and whether a salary slip may be served at
all (a `draft` run has no publishable figures).'
}

Table PayrollLineItem {
  id String [pk]
  payrollRunId String [not null]
  employeeId String [not null]
  projectId String [note: '`projects.Project.id` — nullable; null for HO/overhead staff. Resolved via
ProjectsService, never a cross-schema Prisma relation (FR-046).']
  monthDays Int [not null]
  payableDays Decimal [not null]
  lopDays Decimal [not null, default: 0]
  otHours Decimal [not null, default: 0]
  otWages Decimal [not null, default: 0]
  basic Decimal [not null, default: 0]
  hra Decimal [not null, default: 0]
  conveyanceAllowance Decimal [not null, default: 0]
  siteAllowance Decimal [not null, default: 0]
  specialAllowance Decimal [not null, default: 0]
  employeePf Decimal [not null, default: 0]
  employeeEsic Decimal [not null, default: 0]
  professionalTax Decimal [not null, default: 0]
  tds Decimal [not null, default: 0, note: 'Manual entry, default 0 (spec clarification — TDS computation arrives with
the 2026-09-01 amendment, US14).']
  loanEmiDeduction Decimal [not null, default: 0]
  netPay Decimal [not null, default: 0]
  employerPf Decimal [not null, default: 0]
  employerEps Decimal [not null, default: 0]
  employerEdli Decimal [not null, default: 0]
  adminCharges Decimal [not null, default: 0]
  employerEsic Decimal [not null, default: 0]
  gratuity Decimal [not null, default: 0]
  bonus Decimal [not null, default: 0]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  payrollRun PayrollRun [not null]
  employee Employee [not null]

  indexes {
    (payrollRunId, employeeId) [unique]
  }

  Note: 'The per-employee, per-period computed payroll figures — the single source of
truth that `/hr/challans/*`, 003\'s `/my/salary`, and 008\'s Project P&L labour
cost line all read from (data-model.md §Payroll Line Item). Immutable once its
run reaches `processed` (FR-015), enforced at the write path.'
}

Table Loan {
  id String [pk]
  companyId String [not null, note: 'DELIBERATE deviation from the "scope through Employee" pattern the 003 RLS
migration establishes. A loan is a financial obligation issued *by a company*,
so US8\'s transfer-between-companies must not silently hand visibility of an
outstanding debt to the destination tenant. Kept as its own tenant key, and
the transfer flow deliberately does not rewrite it.']
  employeeId String [not null]
  amount Decimal [not null]
  emiAmount Decimal [not null]
  disbursementDate DateTime [not null]
  reason String [not null]
  remarks String
  status LoanStatus [not null, default: 'pending']
  approvedByUserId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  employee Employee [not null]
  schedule LoanScheduleEntry [not null]

  Note: 'An employee advance/loan with an auto-generated EMI schedule that feeds payroll
deductions (US7).'
}

Table LoanScheduleEntry {
  id String [pk]
  loanId String [not null]
  month String [not null, note: 'Period key, e.g. "2026-07".']
  emiAmount Decimal [not null]
  principal Decimal [not null]
  interest Decimal [not null, default: 0]
  remainingBalance Decimal [not null]
  status LoanScheduleStatus [not null, default: 'upcoming']
  paidInPayrollRunId String
  loan Loan [not null]

  indexes {
    (loanId, month) [unique]
  }

  Note: 'One month of a loan\'s amortisation schedule. Generated on approval; the payroll
engine marks an entry `paid` and stamps `paidInPayrollRunId` when it deducts.'
}

Table SalarySlip {
  id String [pk]
  employeeId String [not null]
  employee Employee [not null]
  period String [not null, note: 'Matches `PayrollRun.period`, e.g. "2026-07". Referenced by value rather than
by FK because a run is company-scoped while a slip is employee-scoped; the
service pairs them explicitly so the `draft` check can never be skipped.']
  monthDays Int [not null]
  payableDays Decimal [not null]
  lopDays Decimal [not null]
  otHours Decimal [not null]
  earningBasic Decimal [not null]
  earningHra Decimal [not null]
  earningConveyance Decimal [not null]
  earningSiteAllowance Decimal [not null]
  earningSpecialAllowance Decimal [not null]
  earningOt Decimal [not null]
  deductionPf Decimal [not null]
  deductionEsic Decimal [not null]
  deductionPt Decimal [not null]
  deductionTds Decimal [not null]
  deductionLoanEmi Decimal [not null]
  deductionAdvanceRecovery Decimal [not null]
  employerPf Decimal [not null, note: 'Informational on the payslip — shown to the employee, not subtracted from
`netPay`.']
  employerEps Decimal [not null]
  employerEdli Decimal [not null]
  employerAdminCharges Decimal [not null]
  employerGratuity Decimal [not null]
  employerBonus Decimal [not null]
  netPay Decimal [not null, note: 'Stored rather than derived on read: a payslip already issued must keep showing
the figure it was issued with, even if a later correction changes its inputs.']
  minimumWagesNote String [note: 'The statutory-compliance line the payslip carries.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (employeeId, period) [unique]
  }

  Note: 'The per-employee, per-period payslip figures this feature serves as JSON and
PDF (data-model.md "Salary Slip").

A stored projection, not a computation: feature 003 formats a payslip, it does
not calculate one. Whichever feature owns payroll processing writes these rows
when a run moves to `processed`; a slip whose run is still `draft` is never
served (FR-024).

Every figure is `Decimal`, never `Float` — these are money, and binary rounding
drift in a payslip is a wage dispute.'
}

Table CodeSequence {
  id String [pk]
  companyId String [not null]
  company Company [not null]
  seriesType CodeSeriesType [not null]
  lastNumber Int [not null, default: 0, note: 'Advanced by an atomic `UPDATE ... RETURNING`, the same way employee codes are
allocated, so concurrent callers can never observe the same number twice.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (companyId, seriesType) [unique]
  }
}

Table VendorCategory {
  id String [pk]
  companyId String [not null]
  company Company [not null]
  name String [not null]
  description String
  isDefault Boolean [not null, default: false, note: 'True for the six rows seeded with a new company. Advisory — it does not block
deletion; the `VendorDealsIn` guard does that (FR-014).']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (companyId, name) [unique]
  }

  Note: 'What a vendor deals in. A company master, not a fixed enum: the PRD\'s six
defaults are seeded but a company may add its own (FR-002a).'
}

Table Vendor {
  id String [pk]
  companyId String [not null, note: 'Plain column, not a cross-schema relation — the same treatment `hr.Employee`
gives its company reference. RLS is what scopes it.']
  code String [not null, note: 'Allocated from the company\'s VENDORS series: `{shortCode}-VEN-0001`.']
  name String [not null]
  type VendorType [not null]
  gstin String [note: 'Format-validated at the DTO boundary (FR-002b). Nullable because an unregistered
local supplier legitimately has neither.']
  pan String
  tdsSection String [note: 'Open-ended by design: the Income Tax Act\'s section list changes, and the master
PRD specifies a free-text section rather than a closed enum.']
  tdsRate Decimal
  active Boolean [not null, default: true]
  address String
  city String
  state String
  pinCode String
  vendorCurrency String [not null, default: 'INR', note: 'Almost always INR. Carried per-vendor because import suppliers are invoiced in
their own currency and the rate at which that was converted must be recorded
with the vendor rather than inferred later.']
  exchangeRate Decimal [not null, default: 1]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  contacts VendorContact [not null]
  dealsIn VendorDealsIn [not null]
  hireDetail VendorHireDetail
  contractor ContractorProfile

  indexes {
    (companyId, code) [unique]
  }
}

Table VendorContact {
  id String [pk]
  vendorId String [not null]
  vendor Vendor [not null]
  name String [not null]
  phone String
  email String
  createdAt DateTime [default: `now()`, not null, note: 'No `updatedAt`: contacts are replaced wholesale on vendor update rather than
edited row by row (research.md §10), so a per-row modification time would
always equal the row\'s creation time and mislead.']
}

Table VendorDealsIn {
  vendorId String [not null]
  vendor Vendor [not null]
  categoryId String [not null]

  indexes {
    (vendorId, categoryId) [pk]
  }

  Note: 'Vendor ↔ VendorCategory. `categoryId` crosses into `settings` as a plain UUID and
is validated on write via the exported settings service rather than by a database
FK — Principle I keeps cross-module integrity in the service layer.'
}

Table VendorHireDetail {
  id String [pk]
  vendorId String [unique, not null]
  vendor Vendor [not null]
  hireType HireType [not null]
  contractCode String
  periodFrom DateTime
  periodTo DateTime
  machineCategory String
  machineName String
  requiredAvg Decimal
  chargesBase ChargesBase [not null, default: 'monthly']
  rate Decimal
  minWorkingDays Int
  allowBdDays Boolean [not null, default: false]
  allowIdleDays Boolean [not null, default: false]
  operatorCharges Decimal
  helperCharges Decimal
  maintenanceCharges Decimal
  fuelCharges Decimal
  termsAndConditions String
  requirements String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'Hire terms, for `hire` and `subcontractor` vendors. Split from Vendor rather than
widening it: fourteen columns that are null for every material supplier belong in
their own optional row.'
}

Table ContractorProfile {
  id String [pk]
  companyId String [not null]
  vendorId String [unique, not null]
  vendor Vendor [not null]
  licenceNumber String
  pfRegistration String
  esicRegistration String
  bocwRegistration String
  insurancePolicyNumber String
  complianceStatus ContractorComplianceStatus [not null, default: 'non_compliant', note: 'Derived, never set directly by a caller. Recomputed from the most recently
concluded month\'s MonthlyCompliance row on every compliance change (FR-005),
and persisted so the contractor list can filter on it without recomputing per
row. Defaults to non_compliant: a contractor with no filing history has not
demonstrated compliance, and defaulting the other way would read as a clean
record.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  documents ContractorDocument [not null]
  compliance MonthlyCompliance [not null]

  indexes {
    (companyId, vendorId) [unique]
  }

  Note: 'The compliance extension of a vendor that supplies labour. 1:1 with Vendor and
only for `subcontractor` / `labour_contractor` types — enforced in the service,
since the constraint is on a column of the related row.'
}

Table ContractorDocument {
  id String [pk]
  contractorProfileId String [not null]
  contractorProfile ContractorProfile [not null]
  documentType ContractorDocumentType [not null]
  fileRef String [not null, note: 'Object-storage key, never a public URL — resolved to a short-lived signed URL at
read time, the same treatment employee documents get.']
  fileName String
  expiresAt DateTime [note: 'Statutory registrations expire. `expiryWarning` is derived at read time rather
than stored, because a stored flag is wrong the day after it is written.']
  uploadedByUserId String [not null]
  uploadedAt DateTime [default: `now()`, not null]
}

Table MonthlyCompliance {
  id String [pk]
  companyId String [not null]
  contractorProfileId String [not null]
  contractorProfile ContractorProfile [not null]
  month String [not null, note: '`YYYY-MM`. A string rather than a date because the row is about a month, and a
date would invite a spurious day component that every consumer must then ignore.']
  pfChallanNumber String
  pfAmount Decimal
  pfDate DateTime
  esicChallanNumber String
  esicAmount Decimal
  esicDate DateTime
  status MonthlyComplianceStatus [not null, default: 'missing', note: 'Auto-derived from which challans are present (FR-006), except `verified`, which
only the explicit verify endpoint sets.']
  verifiedByUserId String
  verifiedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (contractorProfileId, month) [unique]
  }

  Note: 'One contractor\'s PF/ESIC filing for one month.'
}

Table BOCWPayment {
  id String [pk]
  companyId String [not null]
  projectId String [not null, note: 'Cross-schema reference to `projects.Project`, stored as a plain UUID and
resolved through ProjectsService. Feature 008 owns that table and has not been
built, so today this is validated only for presence.']
  amountPaid Decimal [not null]
  paymentDate DateTime [not null]
  referenceNumber String [not null]
  remarks String
  recordedByUserId String [not null]
  createdAt DateTime [default: `now()`, not null]

  Note: 'A cess payment against a project. Liability, total paid and balance are computed
on demand rather than stored (research.md §5) — a stored balance is a second
source of truth that drifts the moment a payment is corrected.'
}

Table ReminderRule {
  id String [pk]
  ruleKey String [unique, not null, note: 'Stable identity, chosen by the registering module: `machinery-service-due`.
Unique across the installation — it is half of a reminder\'s composite id.']
  sourceModule String [not null, note: 'Which module owns the rule and resolves its entities: `machinery`, `settings`.']
  type String [not null, note: 'The reminder family, for the list\'s type filter: `document_expiry`.']
  entityType String [not null, note: 'What the rule evaluates over, e.g. `EQUIPMENT_DOCUMENT`. Free text for the
reason given above the enum block.']
  leadDays Int [not null, note: 'How far ahead of the due date the rule starts producing reminders (FR-029).']
  severityLadder Json [not null, note: 'The severity ladder (FR-029), stored as `{ warnWithinDays: number }`. JSON
rather than a column so a future ladder with more bands does not need a
migration in this feature.']
  enabled Boolean [not null, default: true, note: 'Set false to stop evaluating the rule without removing its provider.']
  companyId String [note: 'NULL means the declaration applies to every company — which is the normal case,
since rules are declared in code. A non-null value scopes an override to one
company; the RLS policy admits both.']
  company Company
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  snoozes ReminderSnooze [not null]
  notifications ReminderNotification [not null]

  Note: 'The persisted catalogue of registered reminder rules.

The rule\'s *logic* lives in code — a `ReminderRuleProvider` in the owning module
(src/dashboard/reminders/reminder-rule.types.ts), which is what makes FR-028\'s
"no edit to this feature" guarantee possible. This table is the mirror of those
declarations, synced on boot by `ReminderRuleRegistry`, and it earns its place by
giving an operator one queryable list of what the engine will evaluate and an
`enabled` flag that silences a misbehaving rule without a deploy.'
}

Table ReminderSnooze {
  id String [pk]
  companyId String [not null]
  company Company [not null]
  ruleKey String [not null]
  rule ReminderRule [not null]
  entityType String [not null]
  entityId String [not null]
  snoozeUntil DateTime [not null, note: 'Inclusive: the reminder reappears the day *after* this date. Stored as a date,
not a timestamp — "snoozed until the 14th" is a calendar statement, and a
timestamp would make it mean something different in every timezone.']
  reason String [not null]
  createdByUserId String [not null]
  createdAt DateTime [default: `now()`, not null]

  Note: 'A suppression of one reminder until a date (spec FR-034).

Keyed by (rule, entity) rather than by a reminder id, because a reminder is
computed and has no stored row — the pair is what actually persists between
evaluations.'
}

Table ReminderNotification {
  id String [pk]
  companyId String [not null]
  company Company [not null]
  ruleKey String [not null]
  rule ReminderRule [not null]
  entityType String [not null]
  entityId String [not null]
  subject String [not null, note: 'Copied at emission time so a closed notification still reads sensibly after the
underlying record is renamed or deleted.']
  dueDate DateTime [not null]
  severity ReminderSeverity [not null]
  emittedAt DateTime [default: `now()`, not null]
  closedAt DateTime [note: 'Null while open. Set when the condition is resolved (FR-033), when the reminder
escalates out of this band (FR-032), or when it is snoozed (FR-034).']
  closeReason String [note: 'Why it closed, for the audit trail a bare timestamp cannot give: `resolved`,
`escalated`, `snoozed`.']

  Note: 'The emitted-notification ledger — what makes FR-032/FR-033 possible.

DELIBERATE ADDITION beyond the spec\'s Key Entities list, which names only
ReminderRule, Reminder (computed) and ReminderSnooze. FR-032 requires "at most one
notification per entity, per rule, per severity band" with escalation emitting
anew, and FR-033 requires a resolved reminder\'s open notification to be *closed*.
Both are statements about what was emitted before, and nothing stateless can
answer them: recomputing the list from scratch can tell you a reminder exists, but
never whether it has already been announced. See specs/004-dashboard-backend/
tasks.md, the 2026-09-03 implementation note.'
}

Table ItemCategory {
  id String [pk]
  companyId String [not null]
  company Company [not null]
  name String [not null, note: 'Stored uppercase (FR-016\'s spec text) so "Cement" and "CEMENT" cannot coexist
as two categories with the same meaning.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  items Item [not null]

  indexes {
    (companyId, name) [unique]
  }
}

Table Item {
  id String [pk]
  companyId String [not null]
  company Company [not null]
  code String [not null, note: 'Allocated from the company\'s ITEMS series: `{shortCode}-ITM-0001`.']
  name String [not null]
  categoryId String [not null]
  category ItemCategory [not null]
  unit ItemUnit [not null]
  reorderLevel Decimal [note: 'The per-item stock floor (FR-017). Nullable because most items never need one,
and a default of 0 would claim every item is exactly at its threshold. Compared
against computed `inStock` at read time — `belowReorderLevel` is never stored
(research.md §12).']
  hsnCode String [note: 'HS code for GST returns (FR-017). Free text: the schedule changes, and an enum
would make every rate revision a migration.']
  description String
  active Boolean [not null, default: true, note: 'Soft-retired rather than deleted once stock history exists, so a purchase from
two years ago still resolves its item name.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (companyId, name) [unique]
    (companyId, code) [unique]
  }
}

Table StockBalance {
  id String [pk]
  companyId String [not null]
  itemId String [not null]
  siteId String [not null]
  received Decimal [not null, default: 0]
  issued Decimal [not null, default: 0]
  transferIn Decimal [not null, default: 0]
  transferOut Decimal [not null, default: 0]
  avgRate Decimal [not null, default: 0, note: 'Weighted average rate. Six decimal places rather than the two money elsewhere
carries: this is a computed average, not a transacted amount, and rounding it
to paise on every purchase would drift the stock valuation of a
frequently-received item measurably over a year.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (itemId, siteId) [unique]
  }

  Note: 'Running totals per item per site, updated inside the same transaction as the
ledger write (FR-002). The ledger is the record of truth; this is the O(1) read
of it, and `StockService.recomputeWAR()` can rebuild `avgRate` from the ledger
whenever a purchase is reversed.'
}

Table StockLedgerEntry {
  id String [pk]
  companyId String [not null]
  itemId String [not null]
  siteId String [not null]
  type StockLedgerType [not null]
  quantity Decimal [not null]
  rate Decimal [note: 'Populated for `purchase`/`purchase_reversal` only: an issue consumes at the
running average, so recording a rate against it would invent a number.']
  referenceId String [not null, note: 'The Purchase, Issue or StockTransfer this entry came from. A plain column: the
three possible parents make a Prisma relation impossible to declare, and the
reversal pairs are found by this id.']
  date DateTime [not null]
  createdAt DateTime [default: `now()`, not null]

  Note: 'Append-only. No update or delete path exists in the service layer, and the
absence of an `updatedAt` here is deliberate — a row that can be amended is not
a ledger.'
}

Table Purchase {
  id String [pk]
  companyId String [not null]
  siteId String [not null]
  itemId String [not null]
  vendorId String [not null]
  date DateTime [not null]
  quantity Decimal [not null]
  rate Decimal [not null]
  amount Decimal [not null, note: 'Stored rather than derived: `quantity × rate` rounded once at write time is
what the vendor billed, and recomputing it on every read would let a rounding
change silently restate historical spend.']
  billFileRef String [note: 'Object-storage reference for the uploaded bill, same encrypted-reference
pattern as `EmployeeDocument`/`ProjectDocument`.']
  remarks String
  indentLineId String [note: 'The indent line this purchase fulfils, if it came from one (FR-023).']
  indentLine MaterialIndentLine
  deleted Boolean [not null, default: false]
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  bill PurchaseBill
  grn GoodsReceiptNote
}

Table GoodsReceiptNote {
  id String [pk]
  companyId String [not null]
  purchaseId String [unique, not null]
  purchase Purchase [not null]
  grnNumber String [not null, note: '`{shortCode}-GRN-0001`, allocated from the purchase\'s own sequence at creation.']
  siteId String [not null]
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (companyId, grnNumber) [unique]
  }

  Note: 'Auto-created 1:1 with every purchase (FR-020). Separate from `PurchaseBill`
because they answer different questions: a GRN records that material physically
arrived, a bill records that money is owed for it.'
}

Table PurchaseBill {
  id String [pk]
  companyId String [not null]
  purchaseId String [unique, not null]
  purchase Purchase [not null]
  vendorId String [not null]
  totalAmount Decimal [not null]
  paidAmount Decimal [not null, default: 0]
  paymentStatus PurchaseBillStatus [not null, default: 'unpaid', note: 'Derived from the two amounts above and rewritten in the same transaction that
moves `paidAmount` — stored so the FIFO query can filter on it without
recomputing every bill\'s status to find the unpaid ones.']
  billDate DateTime [not null, note: 'The bill\'s own date drives FIFO order (FR-005), copied from the purchase so
allocation never has to join back to it.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  allocations PaymentAllocation [not null]
}

Table Issue {
  id String [pk]
  companyId String [not null]
  siteId String [not null]
  itemId String [not null]
  date DateTime [not null]
  quantity Decimal [not null]
  issuedTo String [not null]
  activityId String [note: 'What the material was consumed for (FR-019). Both optional: the link is
recorded when the site\'s project has BOQ or activity data to point at, and
requiring one would make material un-issuable at a project whose BOQ has not
been loaded yet. Validated against `ProjectsService` when supplied.']
  boqItemId String
  remarks String
  indentLineId String [note: 'The indent line this issue fulfils, if it came from one (FR-023).']
  indentLine MaterialIndentLine
  deleted Boolean [not null, default: false]
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table StockTransfer {
  id String [pk]
  companyId String [not null]
  fromSiteId String [not null]
  toSiteId String [not null]
  itemId String [not null]
  date DateTime [not null]
  quantity Decimal [not null]
  remarks String
  status TransferStatus [not null, default: 'pending', note: 'Physical-movement tracking only. Both balances move at creation regardless of
this value: the material has left the source store the moment the transfer is
recorded, and holding the decrement until "received" would let the same units
be issued twice.']
  deleted Boolean [not null, default: false]
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table Payment {
  id String [pk]
  companyId String [not null]
  vendorId String [not null]
  amount Decimal [not null]
  date DateTime [not null]
  paymentMode PaymentMode [not null]
  referenceNumber String [not null]
  allocatedAmount Decimal [not null, default: 0, note: 'How much of `amount` reached bills. Stored because FIFO allocation writes it in
the same transaction as the `PaymentAllocation` rows; `unallocatedBalance` is
`amount − allocatedAmount`, derived on read.']
  deleted Boolean [not null, default: false]
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  allocations PaymentAllocation [not null]
}

Table PaymentAllocation {
  id String [pk]
  companyId String [not null]
  paymentId String [not null]
  payment Payment [not null]
  billId String [not null]
  bill PurchaseBill [not null]
  allocatedAmount Decimal [not null]
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (paymentId, billId) [unique]
  }

  Note: 'Which bill received how much from which payment (FR-006). The join row is what
makes a payment reversible: deleting a payment walks these and gives each bill
its amount back.'
}

Table MaterialIndent {
  id String [pk]
  companyId String [not null]
  siteId String [not null]
  projectId String [note: 'Denormalised from the site so the indent list can filter by project without
asking ProjectsService per row. Nullable: a site need not belong to a project.']
  indentNumber String [not null, note: '`{shortCode}-IND-0001`.']
  requiredByDate DateTime [not null]
  justification String [not null]
  status IndentStatus [not null, default: 'submitted']
  requestedByUserId String [not null]
  approvedByUserId String
  approvedAt DateTime
  decisionReason String [note: 'Set when an approver rejects or cancels; both require a reason (FR-026).']
  deleted Boolean [not null, default: false]
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  lines MaterialIndentLine [not null]

  indexes {
    (companyId, indentNumber) [unique]
  }

  Note: 'A site\'s request for material (FR-021). Approving one records intent; it does
not touch any balance (FR-025) — issue-time validation stays the single point of
stock enforcement, which is what keeps this amendment unable to produce a
negative balance.'
}

Table MaterialIndentLine {
  id String [pk]
  companyId String [not null]
  indentId String [not null]
  indent MaterialIndent [not null]
  itemId String [not null]
  requestedQuantity Decimal [not null, note: 'All three quantities are kept, never collapsed (FR-022): the reduction an
approver made is only auditable while the requested figure survives beside the
approved one. Outstanding is `approved − fulfilled`, derived on read.']
  approvedQuantity Decimal
  fulfilledQuantity Decimal [not null, default: 0]
  reductionReason String [note: 'Why the approved quantity is below the requested one (FR-022).']
  activityId String
  boqItemId String
  procurementPending Boolean [not null, default: false, note: 'Set by `mark-procurement-needed`: this line cannot be met from stock and needs
buying (FR-027).']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  issues Issue [not null]
  purchases Purchase [not null]
}

Table EquipmentCategory {
  id String [pk]
  companyId String [not null]
  company Company [not null]
  name String [not null, note: 'Stored uppercase, like `ItemCategory.name`, so "Excavator" and "EXCAVATOR"
cannot coexist as two categories meaning the same thing.']
  meterType MeterType [not null]
  fuelBenchmark Decimal [note: 'Expected consumption per meter unit (litres/hour or litres/km). Nullable
because an electric or manual category has none, and 0 would read as a
benchmark of zero rather than as its absence.']
  fuelVarianceThresholdPercent Decimal [not null, default: 15, note: 'How far past the benchmark a fuel entry may sit before it is flagged (FR-004).
Per category and stored, never the hardcoded `> 15` the original spec carried:
a tower crane and a tipper do not deserve the same tolerance.']
  targetHoursPerMonth Int [not null, default: 176, note: 'Denominator for utilisation % (FR-007). 176 = 22 working days × 8 hours.']
  active Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  hireRates HireRate [not null]

  indexes {
    (companyId, name) [unique]
  }
}

Table EquipmentDocType {
  id String [pk]
  companyId String [not null]
  company Company [not null]
  name String [not null]
  alertDays Int [not null, default: 30, note: 'How many days before expiry a document of this type starts flagging
`expiryAlert` (FR-010). Per type and stored, never the hardcoded 30-day literal
the original spec carried: an insurance policy and a pollution certificate are
not renewed on the same notice.']
  active Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (companyId, name) [unique]
  }
}

Table HireRate {
  id String [pk]
  companyId String [not null]
  company Company [not null]
  categoryId String [not null]
  category EquipmentCategory [not null]
  ratePerUnit Decimal [not null]
  effectiveFrom DateTime [not null]
  effectiveTo DateTime [note: 'Null means "current" — the open end of the history.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'An effective-dated hire rate per category (FR-014).

Non-overlapping by construction: creating a new open-ended rate closes the prior
current one\'s `effectiveTo` to the day before. That invariant is what lets a hire
bill raised last March still resolve last March\'s rate after this year\'s revision
lands (SC-006) — a single mutable "current rate" column could not.'
}

Table Equipment {
  id String [pk]
  companyId String [not null]
  code String [not null, note: 'Allocated from the company\'s EQUIPMENT series (`{shortCode}-EQP-0001`) when the
caller does not supply one — most machines already carry a plate or asset
number the yard knows them by, and overwriting it would be unhelpful.']
  name String [not null]
  categoryId String [not null, note: '→ `settings.EquipmentCategory`. Resolved via `EquipmentCategoriesService`.']
  ownership EquipmentOwnership [not null]
  vendorId String [note: '→ `partners.Vendor`, for hired equipment. Resolved via `PartnersService`.']
  powerSource PowerSource [not null]
  purchaseDate DateTime
  purchaseCost Decimal
  depreciationRate Decimal [note: 'Straight-line, % per annum. Feeds the owned half of `getMachineryCostByProject`.']
  meterType MeterType [not null, note: 'Mirrors the category\'s at creation time. Copied rather than joined because a
category\'s meter type must not silently reinterpret readings already recorded
against machines under it.']
  currentReading Decimal [not null, default: 0]
  deployedSiteId String [note: '→ `projects.Site`. Resolved via `SitesService`; this is what ties a machine to
a project for the P&L.']
  status EquipmentStatus [not null, default: 'active']
  utilizationPercent Decimal [not null, default: 0, note: 'Stored, recomputed on every logbook write for the current month (FR-007), so a
register listing 500 machines does not run 500 aggregates.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  documents EquipmentDocument [not null]
  logbookEntries LogbookEntry [not null]
  fuelEntries FuelEntry [not null]
  serviceSchedules ServiceSchedule [not null]
  maintenanceJobs MaintenanceJob [not null]
  hireBills HireBill [not null]

  indexes {
    (companyId, code) [unique]
  }
}

Table EquipmentDocument {
  id String [pk]
  companyId String [not null]
  equipmentId String [not null]
  equipment Equipment [not null]
  docTypeId String [not null, note: '→ `settings.EquipmentDocType`, whose `alertDays` is the alert window.']
  fileRef String [not null, note: 'Object-storage key, never a public URL — resolved to a short-lived signed URL
at read time, the same treatment contractor and employee documents get.']
  fileName String
  mimeType String
  expiresAt DateTime
  uploadedByUserId String [not null]
  uploadedAt DateTime [default: `now()`, not null]
}

Table LogbookEntry {
  id String [pk]
  companyId String [not null]
  equipmentId String [not null]
  equipment Equipment [not null]
  date DateTime [not null]
  openingReading Decimal [not null]
  closingReading Decimal [not null]
  totalHours Decimal [not null, note: 'Stored: `closingReading − openingReading`. Zero is legitimate (a machine that
stood idle all day still gets an entry).']
  fuelConsumed Decimal
  operatorId String [note: '→ `hr.Employee`. Resolved via `EmployeesService`.']
  projectId String [note: '→ `projects.Project`. A machine can work a project that is not its deployed
site\'s, so this is recorded per entry rather than inferred.']
  remarks String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (equipmentId, date) [unique]
  }
}

Table FuelEntry {
  id String [pk]
  companyId String [not null]
  equipmentId String [not null]
  equipment Equipment [not null]
  date DateTime [not null]
  quantity Decimal [not null]
  rate Decimal [not null]
  amount Decimal [not null]
  vendorId String [note: '→ `partners.Vendor` (the filling station or diesel supplier).']
  variancePercent Decimal [note: 'Computed against the category\'s threshold at save time and stored (research.md
§3): a later edit to the category\'s benchmark must not retroactively rewrite
what was flagged, or unflag, months of history.']
  varianceAlert Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table ServiceSchedule {
  id String [pk]
  companyId String [not null]
  equipmentId String [not null]
  equipment Equipment [not null]
  serviceType String [not null]
  intervalHours Decimal
  intervalKm Decimal
  lastDoneReading Decimal [not null]
  nextDueReading Decimal [not null, note: 'Stored: `lastDoneReading + interval`. `status` is *not* stored — it is derived
on read from the equipment\'s current reading (FR-006, research.md §4), because
storing it would mean touching every schedule on every logbook entry.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  maintenanceJobs MaintenanceJob [not null]
}

Table MaintenanceJob {
  id String [pk]
  companyId String [not null]
  equipmentId String [not null]
  equipment Equipment [not null]
  type MaintenanceType [not null]
  description String [not null]
  openedAt DateTime [default: `now()`, not null]
  closedAt DateTime
  closingReading Decimal
  partsDescription String
  labourCost Decimal [note: 'The workshop\'s own labour. Distinct from `partsCost`, which accrues from spare
part consumption, and from service bills, which are a third party\'s invoice —
FR-026 requires all three to be separable.']
  partsCost Decimal [not null, default: 0, note: 'Accrued by `SparePartMovement` consumptions and reversals (FR-018), never set
by a client.']
  totalCost Decimal
  linkedServiceScheduleId String
  linkedServiceSchedule ServiceSchedule
  status MaintenanceStatus [not null, default: 'open']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  partMovements SparePartMovement [not null]
  serviceBills ServiceBill [not null]
}

Table HireBill {
  id String [pk]
  companyId String [not null]
  equipmentId String [not null]
  equipment Equipment [not null]
  vendorId String [not null, note: '→ `partners.Vendor`, the hire vendor. Required: a hire bill without an owner to
pay is not a hire bill.']
  billedHours Decimal [not null]
  rate Decimal [not null, note: 'Defaults from the effective `settings.HireRate` for the equipment\'s category on
`billingPeriodFrom` (FR-014), overridable per bill.']
  grossAmount Decimal [not null]
  billingPeriodFrom DateTime [not null]
  billingPeriodTo DateTime [not null]
  logbookHours Decimal [not null, note: 'Snapshot taken at creation, not a live join (research.md §8): the bill must
stay verifiable against what the logbook said when it was raised, even if a
logbook entry is corrected afterwards.']
  variance Decimal [not null]
  tdsRate Decimal [note: 'From `PartnersService.getVendorTds()` at creation. Never client-supplied
(FR-005).']
  tdsAmount Decimal [not null, default: 0]
  netPayable Decimal [not null]
  status HireBillStatus [not null, default: 'pending_verification']
  verifiedByUserId String
  verifiedAt DateTime
  paymentDate DateTime
  paymentReference String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table SparePart {
  id String [pk]
  companyId String [not null]
  partNumber String [not null]
  name String [not null]
  unitOfMeasure String [not null, note: 'Free text rather than 009\'s `ItemUnit` enum: workshop parts come in units that
master does not carry (sets, pairs, metres of hose), and widening a settings
enum for plant\'s benefit would couple the two masters.']
  reorderLevel Decimal
  compatibleCategoryIds String[] [not null, note: '`settings.EquipmentCategory` ids this part fits. Empty means "unrestricted" —
consumption against any category is fine and unflagged. A populated list that
excludes the machine\'s category flags but never blocks (FR-020).']
  linkedInventoryItemId String [note: '→ `settings.Item` (009). Declared, never joined: the two stocks stay
independent by design (FR-024).']
  stockQuantity Decimal [not null, default: 0, note: 'Running balance, updated in-transaction on every movement (FR-016) rather than
summed from history on read — the same trade 009 FR-002 makes.']
  avgRate Decimal [not null, default: 0, note: 'Weighted average, recomputed on every receipt by 009 FR-008\'s formula (FR-017).
Six decimal places for the same reason `StockBalance.avgRate` has them: a rate
rounded to paise drifts once it is multiplied back out by a quantity.']
  active Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  movements SparePartMovement [not null]

  indexes {
    (companyId, partNumber) [unique]
  }

  Note: 'A workshop-stocked replacement part (FR-015).

Deliberately not a `settings.Item` (009\'s material master): a spare part is
consumed against a *machine* and costed to that machine\'s maintenance history,
where an inventory item is consumed against a BOQ activity and costed to a
project. Different stock location, different costing dimension, different
consumer. `linkedInventoryItemId` declares the overlap where one physical thing
is registered in both, so FR-024\'s reconciliation can show the divergence rather
than the two silently double-counting.'
}

Table SparePartMovement {
  id String [pk]
  companyId String [not null]
  sparePartId String [not null]
  sparePart SparePart [not null]
  type SparePartMovementType [not null]
  quantity Decimal [not null]
  rate Decimal [not null, note: 'The rate in force when the movement happened. Frozen (FR-017): a later receipt
moves the part\'s weighted average, never what an earlier consumption cost.']
  amount Decimal [not null]
  movementDate DateTime [not null]
  maintenanceJobId String [note: 'Set on consumptions and their reversals; null on receipts.']
  maintenanceJob MaintenanceJob
  vendorId String [note: 'Receipt provenance.']
  billReference String
  incompatiblePart Boolean [not null, default: false, note: 'True when the part\'s `compatibleCategoryIds` excluded the machine\'s category
(FR-020) or when parts were consumed on hired equipment — recorded so the cost
can be recovered from the hire vendor, never enforced.']
  reversalOfId String [unique, note: 'A reversal points at the consumption it undoes.']
  reversalOf SparePartMovement
  reversedBy SparePartMovement
  reason String [note: 'Required on a reversal (FR-019).']
  createdByUserId String [not null]
  deletedAt DateTime [note: 'Soft-delete only (FR-027) — stock and cost history is never hard-deleted.']
  createdAt DateTime [default: `now()`, not null]
}

Table ServiceBill {
  id String [pk]
  companyId String [not null]
  maintenanceJobId String [not null]
  maintenanceJob MaintenanceJob [not null]
  vendorId String [not null, note: '→ `partners.Vendor`, the workshop.']
  billNumber String [not null]
  billDate DateTime [not null]
  grossAmount Decimal [not null]
  taxAmount Decimal [not null, default: 0]
  tdsPercent Decimal [not null, default: 0, note: 'Computed server-side from gross, tax and percent (FR-021); never accepted from
the client, the same rule `HireBill` follows.']
  tdsAmount Decimal [not null]
  netPayable Decimal [not null]
  status ServiceBillStatus [not null, default: 'pending_verification']
  verifiedByUserId String
  verifiedAt DateTime
  paymentStatus ServiceBillPaymentStatus [not null, default: 'unpaid']
  paidAmount Decimal [not null, default: 0]
  paidOn DateTime
  paymentReference String
  deletedAt DateTime [note: 'Soft-delete only (FR-027).']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (companyId, vendorId, billNumber) [unique]
  }

  Note: 'A third-party workshop\'s invoice for repairing owned equipment (FR-021, FR-022).

Distinct from `HireBill`, which is a rental charge for hired equipment. The two
are never the same document: one is what you pay to use a machine, the other is
what you pay to fix one you own.'
}

Table WageRate {
  id String [pk]
  companyId String [not null]
  projectId String [not null, note: '→ projects, resolved via ProjectsService (FR-034).']
  skillCategoryId String [not null, note: '→ settings.SkillCategory.']
  dailyRate Decimal [not null]
  effectiveFrom DateTime [not null]
  effectiveTo DateTime [note: 'Null = the current open-ended rate. Set to the day before a newer rate\'s
`effectiveFrom` when one is appended.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  createdBy String
  deletedAt DateTime
  deletedBy String

  Note: 'A per-project, per-skill-category daily wage rate with a non-overlapping
effective-dated history (013 FR-004 to FR-007) — the same pattern 006 FR-014 uses
for equipment hire rates. `effectiveTo` is null for the current rate and is
auto-closed to the day before a newer rate\'s `effectiveFrom` on append.'
}

Table LabourWorker {
  id String [pk]
  companyId String [not null]
  labourCode String [not null, note: 'Auto-generated, unique per company (e.g. LAB-0001).']
  fullName String [not null]
  phone String [not null]
  gender String [not null]
  dateOfBirth DateTime [not null]
  aadhaarNumber String
  bankAccount String
  skillCategoryId String [not null, note: '→ settings.SkillCategory.']
  engagementType EngagementType [not null]
  contractorId String [note: 'Required when `engagementType` is contractor (FR-008); → partners vendor
resolved via PartnersService (FR-034).']
  siteId String [not null, note: '→ projects.Site.']
  rateOverride Decimal [note: 'Optional per-worker rate that takes precedence over the project rate (FR-006).']
  faceEnrolmentId String [note: '→ feature 003\'s face enrolment, reused not reimplemented (FR-011).']
  status WorkerStatus [not null, default: 'active']
  lastWorkingDate DateTime
  deactivationReason String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  createdBy String
  deletedAt DateTime
  deletedBy String
  gangMemberships GangMember [not null]

  indexes {
    (companyId, labourCode) [unique]
  }

  Note: 'A labour worker — direct (company-engaged, paid from the cash sheet) or
contractor-engaged (paid through a contractor from 007\'s vault). Supersedes 005\'s
Daily Worker. PII (`aadhaarNumber`, `bankAccount`) is masked in list responses
(FR-009) and unique among active workers for Aadhaar (FR-010).'
}

Table LabourGang {
  id String [pk]
  companyId String [not null]
  name String [not null]
  gangLeaderWorkerId String [not null]
  siteId String [not null]
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  createdBy String
  deletedAt DateTime
  deletedBy String
  members GangMember [not null]

  Note: 'A gang: a group of workers under a gang leader, selectable as a batch during
muster capture (FR-012).'
}

Table GangMember {
  id String [pk]
  companyId String [not null]
  gangId String [not null]
  gang LabourGang [not null]
  workerId String [not null]
  worker LabourWorker [not null]
  isActive Boolean [not null, default: true, note: 'Denormalised from the gang so the partial unique index (single active
membership) can be evaluated without a join.']
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (gangId, workerId) [unique]
  }

  Note: 'Gang membership join. A worker belongs to at most one active gang at a time
(FR-012) — enforced by a partial unique index on `workerId` where `isActive`,
added in the migration (Prisma cannot express a partial unique index).'
}

Table MusterRoll {
  id String [pk]
  companyId String [not null]
  siteId String [not null]
  date DateTime [not null, note: 'Company-timezone calendar day (003 FR-018a basis, FR-021).']
  supervisorId String [not null, note: 'The account (supervisor) that opened the session.']
  latitude Decimal [not null]
  longitude Decimal [not null]
  accuracyMetres Decimal [not null]
  geofenceViolation Boolean [not null, default: false]
  lowGpsAccuracy Boolean [not null, default: false]
  distanceFromFenceMetres Decimal
  source MusterSource [not null, default: 'mobile']
  capturedAt DateTime [not null, note: 'Both retained for offline sync (FR-018); `capturedAt` is the client\'s,
`receivedAt` the server\'s.']
  receivedAt DateTime [default: `now()`, not null]
  isOfflineSynced Boolean [not null, default: false]
  status MusterStatus [not null, default: 'draft']
  approvedBy String
  approvedAt DateTime
  returnReason String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  createdBy String
  deletedAt DateTime
  deletedBy String
  lines MusterLine [not null]

  Note: 'A muster roll: one supervisor capture session for a site and date, validated
against the site geofence by a single GPS reading (FR-013, FR-016). Geofence and
low-accuracy violations are recorded and flagged, never rejected (FR-013).'
}

Table MusterLine {
  id String [pk]
  companyId String [not null]
  musterId String [not null]
  muster MusterRoll [not null]
  workerId String [not null]
  attendanceType AttendanceType [not null]
  overtimeHours Decimal
  photoRef String [note: 'Encrypted object-storage ref (FR-015). Nullable so a gang bulk-add can create a
line before its photo is captured; submission requires every line to have one
(FR-010).']
  faceMatchScore Decimal
  faceMatchLow Boolean [not null, default: false]
  skillCategoryIdOnDay String [not null, note: 'Snapshot of the worker\'s skill category at capture time so a mid-period skill
change prices historical days correctly.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (musterId, workerId) [unique]
  }

  Note: 'One worker\'s line on a muster roll: attendance type, optional overtime, the
captured photo (encrypted object storage — FR-015), and an advisory face-match
result (FR-014 — flagged, never blocking). `skillCategoryIdOnDay` snapshots the
worker\'s skill so a mid-period change still prices correctly.'
}

Table LabourPaymentSheet {
  id String [pk]
  companyId String [not null]
  projectId String [not null]
  periodFrom DateTime [not null]
  periodTo DateTime [not null]
  engagementType EngagementType [not null]
  status PaymentSheetStatus [not null, default: 'draft']
  grossTotal Decimal [not null, default: 0]
  deductionTotal Decimal [not null, default: 0]
  netTotal Decimal [not null, default: 0]
  denominationBreakup Json [note: 'Minimal note-count breakup with per-worker residual (FR-027) — direct sheets
only. Null for contractor sheets (FR-028).']
  approvedBy String
  approvedAt DateTime
  reopenReason String
  closedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  createdBy String
  deletedAt DateTime
  deletedBy String
  lines PaymentSheetLine [not null]

  Note: 'A cash payment sheet: one per project, per wage period, per engagement type
(FR-023, FR-026 to FR-028). Frozen on approval; direct sheets carry a jsonb
denomination breakup, contractor sheets do not.'
}

Table PaymentSheetLine {
  id String [pk]
  companyId String [not null]
  sheetId String [not null]
  sheet LabourPaymentSheet [not null]
  workerId String [not null]
  daysWorked Decimal [not null, note: 'Full days = 1, half days = 0.5 (FR-022).']
  overtimeHours Decimal [not null, default: 0]
  resolvedRate Decimal [not null]
  rateSource RateSource [not null]
  grossWage Decimal [not null]
  deductions Json [not null, note: 'Advance instalments and fines applied this period (jsonb list).']
  netPayable Decimal [not null]
  paymentMode LabourPaymentMode
  paidOn DateTime
  paidAmount Decimal
  shortPaymentReason String
  acknowledgementRef String [note: 'Encrypted object-storage ref, required for a cash disbursement (FR-029).']
  carriedForwardBalance Decimal [not null, default: 0, note: 'Unpaid remainder (short payment) carried to the next period (FR-030).']
  status PaymentSheetLineStatus [not null, default: 'pending']
  reversalReason String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'One worker\'s aggregated line on a payment sheet, then the disbursement record
against it. `deductions` is a jsonb list (advance instalments, fines).'
}

Table LabourAdvance {
  id String [pk]
  companyId String [not null]
  workerId String [not null]
  amount Decimal [not null]
  reason String [not null]
  recoveryInstalments Int [not null]
  instalmentAmount Decimal [not null, note: '`amount / recoveryInstalments`, rounded — the per-period deduction.']
  recoveryStartPeriod DateTime [not null, note: 'The wage period (its `periodFrom` date) recovery starts from.']
  outstandingBalance Decimal [not null, default: 0]
  exceedsLimit Boolean [not null, default: false, note: 'Amount exceeds the configured multiple of the worker\'s daily rate (FR-024/US7);
requires LABOUR_APPROVE to be approved.']
  status AdvanceStatus [not null, default: 'pending']
  approvedBy String
  approvedAt DateTime
  disbursedOn DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  createdBy String
  deletedAt DateTime
  deletedBy String

  Note: 'A labour advance against future wages, recovered in instalments through payment
sheets (FR-024, FR-025). `outstandingBalance` is reduced only on disbursement of
the recovering sheet line, never on sheet generation.'
}

