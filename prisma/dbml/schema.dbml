  ADMIN_PASSWORD_RESET
}

Enum FaceEnrolmentStatus {
  not_enrolled
  enrolled
  re_enrolment_requested
}

Enum ConsentMethod {
  signed_paper
  digital
  verbal
}

Enum ReEnrolmentRequestStatus {
  pending
  approved
  rejected
  completed
  expired
}

Enum PunchType {
  in
  out
}

Enum PunchSource {
  employee
  admin_correction
  legacy
}

Enum FaceMatchResult {
  matched
  exception
}

Enum GeofenceResult {
  in_range
  exception
}

Enum AttendanceStatusOverride {
  present
  absent
  on_leave
  weekly_off
  holiday
}

