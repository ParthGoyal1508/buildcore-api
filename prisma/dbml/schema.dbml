  active
  inactive
}

Enum PayCycle {
  monthly
}

Enum TaxRegime {
  old
  new
}

Enum AuditEntityType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
