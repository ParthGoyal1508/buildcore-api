datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["shared", "settings", "hr", "projects", "payroll", "partners"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

// `shared` is the cross-module schema for concerns that don't belong to any single
// named business module (hr, payroll, projects, plant, inventory, partners, settings)
// — see the constitution's schema-per-module principle and specs/001-user-login-backend/
// research.md §10. Account/session/audit data lives here.
//
// `settings` normally belongs to 002-settings-backend, which hasn't been built yet.
// Role/Permission/UserRole are pulled forward into this feature (2026-08-28 design
// decision, prompted by a direct question about why Super Admin was schema-special-
// cased instead of being an ordinary, dynamically-editable role) because login/access
// control cannot work without a real permission model — 002 owns *managing* roles
// (CRUD, the other eight default roles from the PRD) but does not own the schema
// itself once this feature exists first.

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email       String  @unique
  /// Auto-generated from the email local-part at invite time (010 data-model.md),
  /// not supplied by the admin. Nullable because a `pending` row is created before
  /// anything has been generated for it, and because rows predating feature 010
  /// were never guaranteed one by any code path other than the seed.
  username    String? @unique
  /// Null until the invitee sets it (010). Every row created before feature 010
  /// already has one, so relaxing this is additive rather than a change to
  /// existing data.
  password    String?
  /// Shown in the account list when no `hr.Employee` is linked — a Super Admin or a
  /// vendor-facing login has no HR record to take a name from. Required by
  /// `UsersService.create()` in exactly that case, enforced at the service layer
  /// since a conditional NOT NULL is not expressible here (010 data-model.md).
  displayName String?
  firstname   String?
  lastname    String?

  /// A user can hold more than one role at once (2026-08-28 clarification) — their
  /// effective permissions are the union across every assigned role's permissions.
  userRoles UserRole[]

  /// The account's home company. Still present even for a user who also holds a
  /// role with CROSS_COMPANY_ACCESS (research.md §5 update) — cross-company access
  /// is now a permission, not a null-companyId special case, so a "super admin"
  /// account can still meaningfully belong to one home company.
  companyId String?

  /// Set on every successful authentication (001 FR-017); read by 002's Users list
  /// (FR-013) via the exported UsersService, never by a direct cross-schema query.
  lastLoginAt DateTime?

  status              UserStatus       @default(active)
  mustChangePassword  Boolean          @default(false)
  /// How this account's first password came to exist (010 FR-017a-i).
  ///
  /// `mustChangePassword` alone cannot carry this: the forced-change refusal applies
  /// to `admin_direct` accounts only, so the same flag means *enforced* on one
  /// account and *advisory* on an admin-reset one, and nothing else separates them.
  /// Only an explicit `admin_direct` is ever refused — an absent or unrecognised
  /// value must not lock a real user out over missing metadata.
  credentialOrigin    CredentialOrigin @default(invite)
  /// Resets to 0 on next successful login (FR-013).
  consecutiveFailures Int              @default(0)
  /// Set when consecutiveFailures reaches the configured threshold (FR-012).
  lockedUntil         DateTime?

  refreshTokens   RefreshToken[]
  inviteTokens    InviteToken[]
  auditLogEntries AuditLogEntry[]

  @@schema("shared")
}

enum CredentialOrigin {
  /// Chosen by the account holder, via an invite token. The default, and what every
  /// account created before feature 010's 2026-09-01 amendment is.
  invite
  /// Set by an admin at creation time (FR-015). The only origin the forced-change
  /// refusal applies to.
  admin_direct
  /// Set by an admin resetting an existing account's password. Deliberately left
  /// unenforced for now (FR-017a-ii).
  admin_reset

  @@schema("shared")
}

enum UserStatus {
  /// Invited but not yet activated: the row exists so the account can be listed,
  /// audited and re-invited, but it has no password and cannot authenticate until
  /// the invitee consumes their token (010 research.md §3).
  pending
  active
  deactivated

  @@schema("shared")
}

/// A named, editable set of permissions (`settings` schema — see header comment on
/// why this feature creates it ahead of 002). Seeded here with only the one
/// permanent, protected role this feature itself depends on (Super Admin); the
/// other eight default roles from the PRD are 002-settings-backend's own seeding
/// work, once it exists.
///
/// Deliberately NOT row-level-secured: role *definitions* are global reference data
/// shared across every company (one system-wide "Super Admin" role, not one per
/// company), so Principle IV's per-tenant isolation requirement doesn't apply here
/// — every authenticated user can read what a role grants. UserRole (who
/// actually *holds* a role) is the tenant-scoped side, and is RLS-protected.
model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions Permission[]
  /// True only for the seeded Super Admin role — blocks rename/permission-change/
  /// delete (002-settings-backend FR-008; enforced there once it owns role editing —
  /// this feature only ever reads roles, it doesn't expose role management).
  isProtected Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userRoles UserRole[]

  @@schema("settings")
}

/// Join table — a user can hold multiple roles, a role can be held by multiple users.
/// Unlike Role itself (global reference data, not tenant-scoped — see Role's own
/// comment), *who has which role* is tenant data: carries companyId, denormalized
/// from the user at assignment time, so it follows the same RLS pattern as every
/// other tenant-scoped table this feature relies on (FR-020).
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  companyId String?
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@schema("settings")
}

enum Permission {
  DASHBOARD
  EMPLOYEES
  ATTENDANCE
  PROJECTS
  DWR
  PROJECT_FINANCIALS
  MACHINERY
  INVENTORY
  PARTNERS
  REPORTS
  PAYROLL
  CHALLANS
  LOANS
  LOGBOOK
  FUEL
  DAILY_WORKER_REGISTRY
  MY_WORKSPACE
  SETTINGS
  USER_MANAGEMENT
  COMPANY_SETTINGS
  DATA_EXPORT
  DATA_DELETE
  /// New, added by this feature (not in 002-settings-backend's original list): the
  /// capability that lets a role's holder see/act across every company rather than
  /// just their own — replaces the old hardcoded "role === SUPER_ADMIN" schema
  /// exception (research.md §5 update, FR-020a).
  CROSS_COMPANY_ACCESS

  @@schema("settings")
}

/// The tenant root — not itself `companyId`-scoped, so deliberately NOT RLS-filtered
/// (a company has no companyId; it *is* the company). Access is gated by the
/// COMPANY_SETTINGS permission instead (research.md §8, FR-001).
model Company {
  id String @id @default(cuid())

  name      String
  /// Unique across all companies, case-insensitively — normalized to trimmed
  /// uppercase on write, with a `lower()` functional unique index as the
  /// database-level backstop (FR-004). Drives employee code generation.
  shortCode String  @unique
  logoUrl   String?

  status CompanyStatus @default(active)

  // Statutory registration identifiers. GSTIN/PAN are format-validated at the DTO
  // boundary (research.md §10) because downstream Challan generation depends on
  // them being well-formed.
  gstin String?
  pan   String?
  cin   String?
  tan   String?

  address String?
  city    String?
  state   String?
  pinCode String?

  pfEstablishmentCode      String?
  esicCode                 String?
  professionalTaxRegNumber String?
  bocwRegNumber            String?

  /// Fixed at `monthly` per the PRD; modeled as an enum of one for forward
  /// compatibility rather than a bare constant.
  payCycle       PayCycle @default(monthly)
  /// Day-of-month after which attendance edits lock for payroll processing.
  payrollLockDay Int

  // Seeded from SettingsConfig at creation time, per-company editable thereafter
  // (FR-002, research.md §11). Decimal, not Float — these are money-adjacent
  // statutory percentages where binary rounding drift is unacceptable.
  pfEmployerRate   Decimal @db.Decimal(5, 2)
  esicEmployerRate Decimal @db.Decimal(5, 2)
  gratuityRate     Decimal @db.Decimal(5, 2)
  bonusRate        Decimal @db.Decimal(5, 2)

  /// Overtime pay multiplier applied to the derived hourly rate when computing OT
  /// wages (FR-014a). Company-configurable rather than a hardcoded 2× literal —
  /// Constitution Principle III. Read by the payroll engine via SettingsService.
  otMultiplier Decimal @default(2.00) @db.Decimal(5, 2)

  /// BOCW cess levied on a project's contract value, as a fraction (0.01 = 1%).
  /// Statutory and revisable, so it is company configuration rather than a literal
  /// in the cess calculation — Constitution Principle III. Read by 007's BOCWService
  /// via `SettingsService.getBocwCessRate()`. Four decimal places because the rate is
  /// a fraction, not a percentage: 1% is 0.0100 and a future 1.25% is 0.0125.
  bocwCessRate Decimal @default(0.0100) @db.Decimal(6, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments     Department[]
  designations    Designation[]
  documentTypes   DocumentType[]
  shifts          Shift[]
  employeeCodeSeq EmployeeCodeSequence?

  reimbursementCategories ReimbursementCategory[]
  vendorCategories        VendorCategory[]
  codeSequences           CodeSequence[]

  // Feature 004's reminders engine. Company-scoped so a deleted company takes its
  // reminder state with it rather than leaving orphan rows the engine would keep
  // evaluating.
  reminderRuleOverrides ReminderRule[]
  reminderSnoozes       ReminderSnooze[]
  reminderNotifications ReminderNotification[]

  @@schema("settings")
}

enum CompanyStatus {
  active
  inactive

  @@schema("settings")
}

enum PayCycle {
  monthly

  @@schema("settings")
}

enum TaxRegime {
  old
  new

  @@schema("settings")
}

/// One band of an income-tax slab set (005 amendment US14, FR-050).
///
/// Company-scoped rather than global: a slab set is a statutory fact, but which
/// financial years a company has configured is not, and a multi-company install
/// should not have one company's incomplete configuration break another's payroll.
model TaxSlab {
  id        String @id @default(cuid())
  companyId String

  /// e.g. "2026-27".
  financialYear String
  regime        TaxRegime

  /// Inclusive lower bound of the band.
  lowerBound  Decimal  @db.Decimal(14, 2)
  /// Exclusive upper bound; null marks the final open-ended band.
  upperBound  Decimal? @db.Decimal(14, 2)
  ratePercent Decimal  @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, financialYear, regime, lowerBound])
  @@index([companyId, financialYear, regime])
  @@schema("settings")
}

/// Per-company Employee master reference data. Feeds the Employee form's dropdowns;
/// deletion is blocked while an Employee still references it (FR-018).
model Department {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

/// Same shape and deletion-guard behavior as Department (data-model.md).
model Designation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

/// Per-company employee document types. The display flag
/// (MandatoryNumber/Mandatory/ExpiryNumber/Expiry/Number/Optional) is deliberately
/// NOT stored — it is a pure function of the three booleans below, computed on read
/// so it can never drift from them (research.md §7).
model DocumentType {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code String
  name String

  /// Gates attendance marking for an employee missing this document (FR-021).
  isMandatory Boolean @default(false)
  hasExpiry   Boolean @default(false)
  needsNumber Boolean @default(false)

  sortOrder Int     @default(0)
  /// Inactive types are excluded from new-upload selection; historical employee
  /// records referencing them are unaffected (FR-019).
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("settings")
}

/// Per-company shift definitions feeding the Employee form and overtime
/// calculation; deletion blocked while referenced by an Employee (FR-022).
model Shift {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  /// Wall-clock times of day, not instants — Postgres `time`, no date or zone
  /// component (data-model.md "Shift").
  inTime       DateTime @db.Time(0)
  outTime      DateTime @db.Time(0)
  /// Late-arrival tolerance, in minutes.
  graceMinutes Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

/// One counter row per company, incremented via a single atomic
/// `UPDATE ... RETURNING` so concurrent employee creation can never produce a
/// duplicate or a gap (research.md §6, SC-007). Never read or written directly by
/// another module — only through `EmployeeCodeService.getNextEmployeeCode()`.
model EmployeeCodeSequence {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  lastNumber Int @default(0)

  @@schema("settings")
}

/// The master a reimbursement claim's category and receipt rule come from.
///
/// Lives in `settings` because it is per-company configuration, not employee data
/// (research.md §10). Feature 005 owns its admin CRUD; feature 003 only reads it,
/// through `ReimbursementCategoriesService`, to answer one question per claim: is a
/// receipt mandatory at this amount?
model ReimbursementCategory {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code String
  name String

  /// Claims strictly above this amount must carry a receipt (FR-030). Null means a
  /// receipt is never required for this category — distinct from `0`, which would
  /// require one on every claim.
  receiptRequiredAbove Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("settings")
}

/// One signed-in period on one device/client, as a chain of rotating refresh tokens
/// sharing a `familyId` — see data-model.md "Refresh Token".
/// A single-use, time-limited invite carrying the right to set an account's first
/// password. Only the SHA-256 hash of the token is stored, mirroring how
/// `RefreshToken` already handles its own opaque value (010 research.md §2) — so a
/// database dump alone can never be turned back into a working invite link.
model InviteToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hex of the raw token. The raw value exists only inside the email.
  tokenHash String @unique

  expiresAt  DateTime
  /// Set when the invite is redeemed, which is what makes it single-use.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  /// Resend inserts a new row rather than deleting the old one, so the invite
  /// history stays auditable (FR-014). "Usable" is therefore derived — unconsumed,
  /// unexpired, and the newest row for the user — rather than tracked in a boolean
  /// that would be a second source of truth for the same fact.
  @@index([userId, createdAt])
  @@schema("shared")
}

model RefreshToken {
  id        String  @id @default(cuid())
  /// HMAC-hashed opaque token value (SecurityConfig.refreshTokenHashSecret as pepper) —
  /// the raw value is never stored, mirroring password hashing practice.
  tokenHash String  @unique
  familyId  String
  accountId String
  account   User    @relation(fields: [accountId], references: [id])
  /// Copied from the owning account at issuance — every tenant-scoped table this
  /// feature relies on carries a company identifier (FR-020); null when the owning
  /// account has no home company.
  companyId String?

  /// Copied from the family's original login onto every rotated token — determines
  /// each rotation's cookie Max-Age and server-side expiry (FR-006).
  rememberMe Boolean
  /// Set true the moment this token is rotated (exchanged for a new one).
  used       Boolean   @default(false)
  /// When `used` was set — lets rotation tell a genuine replay apart from a benign
  /// concurrent-refresh race within a short grace window (research.md §2).
  usedAt     DateTime?
  /// Set on logout, reuse detection, account deactivation, or admin-reset-password.
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([familyId])
  @@index([accountId])
  @@schema("shared")
}

/// Immutable security-event record — write-only in this feature (spec.md 2026-08-26
/// clarification: reading/querying is a separate, later Activity Log feature).
model AuditLogEntry {
  id String @id @default(cuid())

  /// What the event was *about* — a login-lifecycle event (feature 001) or a
  /// settings entity that was changed (feature 002). Generalized from feature 001's
  /// flat `eventType` so every module shares one audit trail rather than growing a
  /// per-module enum (002 research.md §9).
  entityType AuditEntityType
  /// What happened to it — separated from `entityType` so `COMPANY`+`UPDATE` and
  /// `COMPANY`+`DELETE` don't need distinct enum values.
  action     AuditAction
  /// The Company/Role/Department/... row affected; null for login-related events,
  /// which key off `accountId`/`attemptedEmail` as before.
  entityId   String?
  /// Optional before/after snapshot for update actions.
  changes    Json?

  accountId      String?
  account        User?   @relation(fields: [accountId], references: [id])
  /// Populated only when accountId is null (an unregistered-identifier login_failure),
  /// so that failure is still traceable without inventing an account reference.
  attemptedEmail String?
  /// Copied from the account at event time; null for an unregistered-identifier
  /// failure and for any event with no company-scoped account.
  companyId      String?

  ipAddress String
  createdAt DateTime @default(now())

  @@index([accountId])
  @@schema("shared")
}

enum AuditEntityType {
  // Login-lifecycle values carried over from feature 001 (uppercased in the 002
  // generalization so both halves of the enum read consistently).
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  REFRESH_REUSE_DETECTED
  ADMIN_PASSWORD_RESET

  // Settings entities audited by feature 002 (FR-025).
  COMPANY
  ROLE
  DEPARTMENT
  DESIGNATION
  DOCUMENT_TYPE
  SHIFT
  /// Shared with 010-account-creation-backend so both features' writes to the same
  /// account surface under one type in the Activity Log (002 tasks T048).
  USER_ACCOUNT

  // My Workspace entities audited by feature 003 (FR-027). Biometric enrolment is
  // audited on *read* as well as write — Principle IV puts face data in the same
  // protection tier as Aadhaar/PAN, where every access is accountable.
  PUNCH
  LEAVE_APPLICATION
  FACE_ENROLMENT
  RE_ENROLMENT_REQUEST
  /// Shared with 005-hr-payroll-backend, which adds the approve/reject/pay layer
  /// over the same claims this feature's employees create (research.md §10).
  REIMBURSEMENT_CLAIM

  // HR & Payroll entities audited by feature 005 (FR-030).
  EMPLOYEE
  EMPLOYEE_DOCUMENT
  EMPLOYEE_TRANSFER
  ATTENDANCE
  HOLIDAY
  PAYROLL_RUN
  LOAN
  EXIT_RECORD
  TAX_DECLARATION
  SALARY_ADVANCE

  // Partners entities audited by feature 007 (FR-013).
  VENDOR
  VENDOR_CATEGORY
  CONTRACTOR_PROFILE
  CONTRACTOR_DOCUMENT
  MONTHLY_COMPLIANCE
  BOCW_PAYMENT

  // Projects entities audited by feature 008 (contracts/projects-api.md "Audit
  // logging"). PROJECT covers create/edit and the lock/unlock transition — the
  // transition is an ordinary UPDATE whose before/after payload carries `isLocked`,
  // rather than a distinct action, so a reader sees who froze a project in the same
  // place they see who changed its contract value.
  PROJECT
  CLIENT
  SITE
  BOQ_GROUP
  BOQ_ITEM
  DWR
  REVENUE
  RA_BILL
  WORK_ORDER
  PROJECT_BUDGET
  PROJECT_DOCUMENT

  /// Feature 004's reminders engine. Only the snooze is audited (FR-034): evaluation
  /// itself is a read, and emitting a notification is already recorded by the
  /// `ReminderNotification` ledger, which carries more than an audit row could.
  REMINDER

  @@schema("shared")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  /// Added by feature 003: Principle IV puts biometric data in the same protection
  /// tier as Aadhaar/PAN, where every *access* is accountable, not just every change
  /// (research.md §8). CREATE/UPDATE/DELETE cannot express "someone looked at this".
  READ

  // Login-lifecycle actions — the action *is* the event for these.
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  REFRESH_REUSE_DETECTED
  ADMIN_PASSWORD_RESET

  @@schema("shared")
}

// ============================================================================
// projects schema — feature 003 (My Workspace) adds only the slice of Site that
// attendance needs. A later Projects feature owns the rest of a site's data and is
// expected to extend this model rather than redefine it (research.md §1).
// ============================================================================

/// A construction site: the geofence centre a punch is validated against, plus the
/// non-working-day calendar that attendance-status computation reads.
///
/// Lives in `projects`, not `hr`, even though this feature is its only current
/// consumer — a site is a projects-module concept per the constitution's module
/// list, and putting it in `hr` would misplace a concept that already has a home
/// (research.md §1). `hr` reaches it only through `SitesService`.
model Site {
  id        String @id @default(cuid())
  /// RLS-protected. No Prisma relation to `settings.Company` on purpose: Principle I
  /// routes every cross-module read through the owning module's exported service, and
  /// declaring a relation here is what would make an accidental cross-schema join
  /// possible in the first place. Same rationale as `shared.User.companyId`.
  companyId String

  name String

  /// Geofence centre. Decimal, not Float — 7 decimal places is ~1 cm of latitude, and
  /// binary floating point would make a boundary punch's in/out verdict depend on
  /// representation error rather than on where the worker actually stood.
  latitude             Decimal @db.Decimal(10, 7)
  longitude            Decimal @db.Decimal(10, 7)
  geofenceRadiusMeters Int

  /// Day-of-week treated as Weekly Off, 0 = Sunday (research.md §6).
  weeklyOffDay Int

  /// ── Added by feature 008. Every column below is nullable or defaulted, so the
  /// migration is additive and the rows 003 already created stay valid. The four
  /// columns above are deliberately untouched: HR reads them through
  /// `SitesService.getGeofence()`/`.getWeeklyOffDay()` on every punch, and widening
  /// them to nullable would push a null check into that hot path for no gain.

  /// The project this site belongs to. Nullable because sites created by 003 predate
  /// the Project table entirely, and a site can legitimately outlive its project.
  /// `SetNull` rather than `Cascade`: deleting a project must not silently delete the
  /// attendance geofence its workers are still punching against.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Postal address, distinct from the geofence centre — the coordinates say where a
  /// punch counts, this says where to send a delivery.
  address String?

  status SiteStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([projectId])
  @@schema("projects")
}

// ============================================================================
// projects schema — feature 008 (Projects: portfolio, clients, sites, BOQ, DWR,
// revenue, P&L). Site above is 003's, extended in place rather than replaced.
//
// Cross-schema references (`projectManagerEmployeeId`, `supervisorEmployeeId`,
// `partnerId`, `approvedByUserId`) are stored as bare ids with no Prisma relation,
// the same rule `Site.companyId` follows: Principle I routes every cross-module read
// through the owning module's exported service, and a declared relation is precisely
// what would make an accidental cross-schema join possible.
// ============================================================================

enum SiteStatus {
  active
  inactive

  @@schema("projects")
}

enum ClientStatus {
  active
  inactive

  @@schema("projects")
}

enum ProjectStatus {
  planning
  ongoing
  on_hold
  completed

  @@schema("projects")
}

enum ProjectDivision {
  contract
  own

  @@schema("projects")
}

enum ProjectSiteType {
  site
  toll
  plant

  @@schema("projects")
}

enum DwrWeather {
  clear
  rainy
  overcast

  @@schema("projects")
}

enum DwrStatus {
  draft
  submitted
  approved

  @@schema("projects")
}

enum DwrPaymentMode {
  work_basis
  day_basis

  @@schema("projects")
}

enum RevenueStatus {
  received
  pending

  @@schema("projects")
}

enum RaBillStatus {
  draft
  submitted
  approved

  @@schema("projects")
}

enum WorkOrderStatus {
  draft
  active
  completed

  @@schema("projects")
}

enum ProjectBudgetCategory {
  labour
  materials
  machinery
  fuel
  subcontractors
  overheads

  @@schema("projects")
}

/// The party a project is executed for.
model Client {
  id        String @id @default(cuid())
  /// RLS-protected. Bare id, not a relation — see the note on `Site.companyId`.
  companyId String

  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  /// Unique per company *when present*. Enforced by a partial unique index rather
  /// than `@@unique`, which in Postgres treats every NULL as distinct and would
  /// therefore admit unlimited GSTIN-less clients — correct here, but only by
  /// accident. The partial index in the migration states the rule explicitly.
  gstin         String?

  status ClientStatus @default(active)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@schema("projects")
}

/// A construction project: the root every BOQ item, work report, bill and cost row
/// in this schema ultimately hangs off.
model Project {
  id        String @id @default(cuid())
  companyId String

  /// Allocated from the company's PROJECTS series by `CodeSeriesService` when the
  /// caller omits it, so two concurrent creates can never collide.
  code String
  name String

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  location      String?
  /// Decimal, not Float: this is money, and it is the denominator of every margin
  /// percentage the P&L reports.
  contractValue Decimal @db.Decimal(18, 2)

  startDate       DateTime
  expectedEndDate DateTime?

  status ProjectStatus @default(planning)

  /// `hr.Employee.id`, resolved through `EmployeesService` on the reads that need a
  /// name. Bare id — see the schema-level note above.
  projectManagerEmployeeId String?

  division       ProjectDivision @default(contract)
  departmentType String?
  projectType    String?
  siteType       ProjectSiteType @default(site)
  isHO           Boolean         @default(false)

  /// The freeze switch. Every write endpoint in this module passes through
  /// `ProjectLockGuard`, which refuses with 423 while this is true (research.md §6).
  isLocked Boolean @default(false)

  siteStartDate  DateTime?
  purchaseLimit  Decimal?  @db.Decimal(18, 2)
  orderNumber    String?
  cgstApplicable Boolean   @default(false)
  description    String?

  sites          Site[]
  boqTaskGroups  BOQTaskGroup[]
  dailyWorkReports DailyWorkReport[]
  revenues       Revenue[]
  raBills        RABill[]
  workOrders     WorkOrder[]
  budgets        ProjectBudget[]
  documents      ProjectDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([clientId])
  @@schema("projects")
}

/// A billable section of a project's Bill of Quantities.
model BOQTaskGroup {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  boqNo      String
  name       String
  startDate  DateTime
  finishDate DateTime
  scopeQty   Decimal  @db.Decimal(18, 3)
  isEstimate Boolean  @default(false)

  items BOQTaskItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@schema("projects")
}

/// One measurable line of work. `doneQty` is a running total that moves **only** when
/// a DWR is approved, never when it is submitted (research.md §13) — the two are
/// different claims, and counting a submission as progress is what makes a BOQ
/// disagree with the site.
model BOQTaskItem {
  id        String @id @default(cuid())
  companyId String

  groupId String
  group   BOQTaskGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  boqNo      String
  taskName   String
  unit       String
  scopeQty   Decimal  @db.Decimal(18, 3)
  startDate  DateTime
  finishDate DateTime
  /// Planned working days, used to derive the per-day target.
  duration   Int
  perDayQty  Decimal  @db.Decimal(18, 3)
  doneQty    Decimal  @default(0) @db.Decimal(18, 3)
  isEstimate Boolean  @default(false)

  dwrTasks DWRTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([groupId])
  @@schema("projects")
}

/// A day's site record. `draft → submitted → approved`; only the last transition
/// moves BOQ progress.
model DailyWorkReport {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workDate  DateTime
  dprNumber String

  /// `hr.Employee.id`. Bare id — see the schema-level note above.
  supervisorEmployeeId String?

  weather DwrWeather @default(clear)
  status  DwrStatus  @default(draft)

  workerCount    Int    @default(0)
  machineryCount Int    @default(0)
  /// Supervisor's own 0–100 assessment, distinct from the quantity-derived progress
  /// the BOQ computes — the two are reported separately rather than reconciled.
  progress       Int    @default(0)
  location       String?
  description    String?

  contractFor    String  @default("self")
  contractNumber String?
  rfiNo          String?
  layer          String?

  /// `shared.User.id`. Bare id — see the schema-level note above.
  approvedByUserId String?
  approvedAt       DateTime?

  /// Object-storage references, same pattern as `hr.EmployeeDocument`.
  fileRefs String[]

  tasks DWRTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, dprNumber])
  @@index([companyId])
  @@index([projectId, workDate])
  @@schema("projects")
}

/// One measurement line within a work report. `actualQty` is computed server-side
/// from the six factors so the arithmetic cannot differ between clients.
model DWRTask {
  id String @id @default(cuid())

  dwrId String
  dwr   DailyWorkReport @relation(fields: [dwrId], references: [id], onDelete: Cascade)

  /// Nullable: a task can be freeform work that no BOQ line covers.
  boqItemId String?
  boqItem   BOQTaskItem? @relation(fields: [boqItemId], references: [id])

  layer        String?
  chainageFrom Decimal? @db.Decimal(18, 3)
  chainageTo   Decimal? @db.Decimal(18, 3)
  roadSide     String?

  paymentMode DwrPaymentMode @default(work_basis)

  /// The six measurement factors. All default to 1 so an unused dimension is
  /// multiplicatively neutral rather than zeroing the result.
  nos1    Decimal @default(1) @db.Decimal(18, 3)
  nos2    Decimal @default(1) @db.Decimal(18, 3)
  length  Decimal @default(1) @db.Decimal(18, 3)
  breadth Decimal @default(1) @db.Decimal(18, 3)
  depth   Decimal @default(1) @db.Decimal(18, 3)
  density Decimal @default(1) @db.Decimal(18, 3)

  /// nos1 × nos2 × length × breadth × depth × density, computed by the server.
  actualQty Decimal @db.Decimal(18, 3)

  /// Flagged, not refused: the site did the work, and a BOQ line that turns out to
  /// have been under-scoped is a commercial question, not a data-entry error.
  exceedsScope Boolean @default(false)

  engineerName String?
  remark       String?
  layerNo      String?
  section      String?

  @@index([dwrId])
  @@index([boqItemId])
  @@schema("projects")
}

/// Money received or expected against a project, outside the RA bill process.
model Revenue {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal       @db.Decimal(18, 2)
  date        DateTime
  status      RevenueStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@schema("projects")
}

/// A running account bill. `draft → submitted → approved`, with `submitted → draft`
/// via reject; approved bills are immutable (research.md §7).
model RABill {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  billNumber  String
  description String?
  amount      Decimal      @db.Decimal(18, 2)
  billingDate DateTime
  status      RaBillStatus @default(draft)

  submittedAt      DateTime?
  /// `shared.User.id`. Bare id — see the schema-level note above.
  approvedByUserId String?
  approvedAt       DateTime?
  rejectionRemark  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@schema("projects")
}

/// Work subcontracted on a project.
model WorkOrder {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// `partners.Vendor.id`, read through `PartnersService`. Bare id — see the
  /// schema-level note above.
  partnerId String?

  workDetail   String
  terms        String?
  requirements String?
  hireContract String?

  labourAmount   Decimal @default(0) @db.Decimal(18, 2)
  materialAmount Decimal @default(0) @db.Decimal(18, 2)

  status WorkOrderStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@schema("projects")
}

/// Budgeted spend per cost category, one row per category per project. Compared
/// against actuals sourced live from the owning modules — never stored here.
model ProjectBudget {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category ProjectBudgetCategory
  amount   Decimal               @db.Decimal(18, 2)

  updatedAt DateTime @updatedAt

  @@unique([projectId, category])
  @@index([companyId])
  @@schema("projects")
}

/// A file attached to a project, stored as an object-storage reference rather than
/// bytes — same pattern as `hr.EmployeeDocument`.
model ProjectDocument {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  documentType String
  fileRef      String
  filePath     String?
  remark       String?

  /// `shared.User.id`. Bare id — see the schema-level note above.
  uploadedByUserId String
  uploadedAt       DateTime @default(now())

  @@index([companyId])
  @@index([projectId])
  @@schema("projects")
}

// ============================================================================
// hr schema — feature 003 (My Workspace)
// ============================================================================

/// The minimal Employee record this feature needs: the bridge from a logged-in
/// account to the site, shift, and attendance data that hang off it. A future HR &
/// Payroll admin feature extends this (department, designation, joining date)
/// rather than redefining it (research.md §9).
model Employee {
  id String @id @default(cuid())

  /// The account this employee record belongs to (`shared.User.id`). Unique: an
  /// account maps to exactly one employee record, which is what lets every `/my/*`
  /// endpoint resolve the caller's own employee from their token alone and never
  /// accept an employeeId parameter (FR-028).
  userId    String @unique
  /// RLS-protected. Bare id, not a relation — see the note on `Site.companyId`.
  companyId String
  /// `projects.Site.id`; read through `SitesService`.
  siteId    String
  /// `settings.Shift.id`; the shift duration OT is computed against, read through
  /// `SettingsModule`'s exported service (research.md §9).
  shiftId   String

  /// Allocated by `settings`' employee-code sequence (feature 002).
  employeeCode String

  // ── Identity (005 US1) ────────────────────────────────────────────────────
  firstName     String?
  lastName      String?
  title         String?
  dob           DateTime?      @db.Date
  gender        Gender?
  maritalStatus MaritalStatus?
  photoRef      String?

  // ── Employment ────────────────────────────────────────────────────────────
  /// `settings.Department.id` / `settings.Designation.id` — bare ids, resolved via
  /// SettingsService. No cross-schema Prisma relation (Constitution Principle I).
  departmentId          String?
  designationId         String?
  employmentType        EmploymentType?  @default(full_time)
  dateOfJoining         DateTime?        @db.Date
  probationEndDate      DateTime?        @db.Date
  confirmationDate      DateTime?        @db.Date
  reportingToEmployeeId String?
  musterCategory        String?
  hoursPerDay           Decimal?         @db.Decimal(4, 2)
  dailyRate             Decimal?         @db.Decimal(12, 2)
  payMode               String?
  calculationMode       CalculationMode? @default(monthly)
  workmanId             String?
  isActive              Boolean          @default(true)

  // ── Statutory ─────────────────────────────────────────────────────────────
  pfApplicable     Boolean @default(false)
  pfUpperLimit     Boolean @default(false)
  esicApplicable   Boolean @default(false)
  esicUpperLimit   Boolean @default(false)
  uan              String?
  pfNumber         String?
  esicNumber       String?
  /// Regulated PII (Constitution Principle IV). Stored encrypted at rest, masked to
  /// last 4 by PiiMaskingInterceptor, unmasked only via the audited reveal-pii path.
  aadhaarEncrypted String?
  panEncrypted     String?

  // ── Pay & Bank ────────────────────────────────────────────────────────────
  basic                      Decimal? @db.Decimal(12, 2)
  hra                        Decimal? @db.Decimal(12, 2)
  conveyanceAllowance        Decimal? @db.Decimal(12, 2)
  siteAllowance              Decimal? @db.Decimal(12, 2)
  specialAllowance           Decimal? @db.Decimal(12, 2)
  paymentMode                String?
  bankName                   String?
  bankBranch                 String?
  /// Regulated PII — see aadhaarEncrypted.
  bankAccountNumberEncrypted String?
  ifscCode                   String?

  // ── Contact ───────────────────────────────────────────────────────────────
  mobile                   String?
  alternateMobile          String?
  email                    String?
  presentAddress           String?
  presentCity              String?
  presentState             String?
  presentPinCode           String?
  permanentAddress         String?
  permanentCity            String?
  permanentState           String?
  permanentPinCode         String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  // ── Letters ───────────────────────────────────────────────────────────────
  offerLetterIssued           Boolean   @default(false)
  offerLetterIssuedDate       DateTime? @db.Date
  appointmentLetterIssued     Boolean   @default(false)
  appointmentLetterIssuedDate DateTime? @db.Date
  ndaSigned                   Boolean   @default(false)
  ndaSignedDate               DateTime? @db.Date

  // ── Onboarding checklist ──────────────────────────────────────────────────
  idCardIssued             Boolean @default(false)
  uniformProvided          Boolean @default(false)
  safetyInductionCompleted Boolean @default(false)
  toolsIssued              Boolean @default(false)
  bankVerificationDone     Boolean @default(false)
  biometricEnrolled        Boolean @default(false)
  siteAccessGranted        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faceEnrolment           FaceEnrolment?
  reEnrolmentRequests     ReEnrolmentRequest[]
  punchRecords            PunchRecord[]
  leaveBalances           LeaveBalance[]
  leaveApplications       LeaveApplication[]
  reimbursementClaims     ReimbursementClaim[]
  salarySlips             SalarySlip[]
  documents               EmployeeDocument[]
  transfers               EmployeeTransfer[]
  attendanceModifications AttendanceModification[]
  exitRecords             ExitRecord[]
  payrollLineItems        PayrollLineItem[]
  loans                   Loan[]
  taxDeclarations         TaxDeclaration[]
  salaryAdvances          SalaryAdvance[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([siteId])
  @@schema("hr")
}

/// Exactly one row per employee. A completed re-enrolment replaces `descriptor`,
/// `photoRefs`, and `enrolledAt` in place — "previous template securely deleted"
/// (FR-016) means the prior values are overwritten, never retained as history.
model FaceEnrolment {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// The derived 128-float face descriptor, encrypted at rest — never the raw
  /// photos, which is the whole point of storing a descriptor (research.md §2):
  /// a punch compares one vector instead of re-running inference against every
  /// enrolled image. Null while `status` is `not_enrolled`.
  descriptor Bytes?
  /// Encrypted object-storage references to the 3–5 captured photos. The blobs
  /// themselves live in `StorageService`, not here — only large binaries leave
  /// Postgres (constitution v1.4.0).
  photoRefs  String[]

  consentMethod         ConsentMethod?
  consentAcknowledgedAt DateTime?
  enrolledAt            DateTime?

  status FaceEnrolmentStatus @default(not_enrolled)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("hr")
}

enum FaceEnrolmentStatus {
  not_enrolled
  enrolled
  re_enrolment_requested

  @@schema("hr")
}

enum ConsentMethod {
  signed_paper
  digital
  verbal

  @@schema("hr")
}

/// An employee's request to re-capture their face template (e.g. after an injury or
/// a persistent match failure), and the admin decision on it. Approval opens a
/// time-boxed unlock that a single fresh capture consumes (FR-013–FR-016).
model ReEnrolmentRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reason String
  status ReEnrolmentRequestStatus @default(pending)

  /// Mandatory when `status` is `rejected` — enforced at the DTO/service layer,
  /// since a conditional NOT NULL is not expressible in the schema.
  adminRemarks String?

  decidedByUserId String?
  decidedAt       DateTime?

  /// Set on approval, `reEnrolment.unlockDurationDays` out (FR-015).
  unlockExpiresAt  DateTime?
  /// Set when the fresh capture completes, so one approval cannot be reused (FR-016).
  unlockConsumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@schema("hr")
}

enum ReEnrolmentRequestStatus {
  pending
  approved
  rejected
  completed
  expired

  @@schema("hr")
}

/// One punch event. Recorded whether or not verification succeeded: a failed face
/// match or an out-of-geofence position becomes an exception for an admin to
/// resolve, never a rejected request (FR-007) — a worker who is physically present
/// must not be silently absent from payroll because of a bad camera angle.
model PunchRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type PunchType

  /// The official punch time, declared by the client so an offline-queued punch
  /// records when the worker actually punched rather than when connectivity
  /// returned (research.md §4).
  capturedAt    DateTime
  /// Server receipt time. Both are retained because FR-012 requires offline syncs
  /// to stay visible in audit rather than being flattened into one timestamp.
  receivedAt    DateTime @default(now())
  /// Derived: `capturedAt` trails `receivedAt` by more than the configured clock-skew
  /// tolerance. The tolerance is what stops ordinary clock drift from labelling every
  /// normal punch an offline sync.
  isOfflineSync Boolean  @default(false)

  /// Encrypted object-storage reference to the captured selfie.
  /// Null only for `admin_correction` rows, which have no capture. A CHECK
  /// constraint keeps this mandatory for employee-sourced punches.
  photoRef String?

  faceMatchResult   FaceMatchResult?
  /// The measured descriptor distance behind `faceMatchResult`. Kept so an admin
  /// resolving an exception can see how near the miss was, and so the configured
  /// threshold can be retuned against real data instead of guesswork.
  faceMatchDistance Decimal?         @db.Decimal(6, 4)

  latitude               Decimal?        @db.Decimal(10, 7)
  longitude              Decimal?        @db.Decimal(10, 7)
  geofenceResult         GeofenceResult?
  /// Measured metres from the site centre, retained for the same reason as
  /// `faceMatchDistance`.
  geofenceDistanceMeters Decimal?        @db.Decimal(10, 2)

  /// On a punch-in, the id of the punch-out that closed it; null while the punch-in
  /// is still open. This is what makes "at most one open punch-in per employee"
  /// (FR-008) enforceable as a partial unique index in the database, instead of
  /// resting solely on an application-level check that two concurrent requests can
  /// both pass. Always null on a punch-out record.
  /// The calendar day this punch counts for, in the configured timezone (FR-018a).
  ///
  /// Stamped at insert rather than derived on read: `AT TIME ZONE` with a named zone
  /// is STABLE, not IMMUTABLE, so Postgres will not build a unique index over the
  /// expression — and FR-008c needs exactly that index. The cost is that changing
  /// APP_TIMEZONE later does not reclassify punches already recorded, which for
  /// payroll data is the safer direction.
  punchDate DateTime @db.Date

  /// Who wrote this punch. The FR-008c uniqueness constraint binds only `employee`
  /// rows, so feature 005's future corrections are not forbidden by the schema, and
  /// rows predating FR-008 (`legacy`) keep their multiple pairs per day.
  source PunchSource @default(employee)

  closedByPunchId String? @unique

  /// Null unless either result above is `exception`; then `pending` until an admin
  /// acts (FR-011a).
  exceptionResolution ExceptionResolution?
  resolvedByUserId    String?
  resolvedAt          DateTime?

  // ── Admin edit surface (005 US3, research.md §7) ──────────────────────────
  /// Set when an admin created or corrected this record through the HR admin
  /// Mark/Edit action rather than the employee's own punch flow. Every such edit
  /// also writes an append-only AttendanceModification row carrying before/after.
  adminEdited    Boolean                   @default(false)
  editedByUserId String?
  editedAt       DateTime?
  /// Forces the derived day status instead of letting statusForDay() compute it —
  /// used when an admin marks a day present/absent against what the punches imply.
  statusOverride AttendanceStatusOverride?
  remarks        String?

  createdAt DateTime @default(now())

  /// Serves both the open-punch-in lookup on the write path and the month-range
  /// history query on the read path.
  @@index([employeeId, capturedAt])
  @@index([employeeId, punchDate])
  @@index([exceptionResolution])
  @@schema("hr")
}

enum PunchType {
  in
  out

  @@schema("hr")
}

enum PunchSource {
  /// Self-service, made through `/my/punch`. The only kind FR-008 constrains.
  employee
  /// Reserved for feature 005's administrative fix-ups.
  admin_correction
  /// Recorded before FR-008 existed, when a day could hold several pairs.
  legacy

  @@schema("hr")
}

enum FaceMatchResult {
  matched
  exception

  @@schema("hr")
}

enum GeofenceResult {
  in_range
  exception

  @@schema("hr")
}

/// Mirrors the `AttendanceStatus` union in
/// src/hr/punch/attendance-history.service.ts. Kept in sync by hand — the union is
/// the source of truth for computation, this enum only stores an admin's override.
enum AttendanceStatusOverride {
  present
  absent
  on_leave
  weekly_off
  holiday

  @@schema("hr")
}

enum ExceptionResolution {
  pending
  confirmed
  rejected

  @@schema("hr")
}

/// Per-employee, per-financial-year leave entitlement. `balance` is deliberately not
/// a column: storing `opening + accrued - used` alongside its own inputs is a second
/// source of truth that drifts the first time one of them is written without the
/// other (data-model.md "Leave Balance").
model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType     LeaveTypeCode
  /// Indian financial year, e.g. "2026-27".
  financialYear String

  opening Decimal @default(0) @db.Decimal(6, 2)
  accrued Decimal @default(0) @db.Decimal(6, 2)
  used    Decimal @default(0) @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveType, financialYear])
  @@schema("hr")
}

model LeaveApplication {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveTypeCode
  fromDate  DateTime      @db.Date
  toDate    DateTime      @db.Date
  /// Computed server-side at submission, excluding weekly offs and site holidays
  /// (FR-019) — never taken from the client, which would let a caller understate
  /// the cost of their own leave.
  dayCount  Decimal       @db.Decimal(5, 2)

  reason String
  status LeaveApplicationStatus @default(pending)

  /// Mandatory when `status` is `rejected` (FR-022a); enforced at the service layer.
  adminRemarks    String?
  decidedByUserId String?
  decidedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([employeeId, fromDate, toDate])
  @@schema("hr")
}

enum LeaveTypeCode {
  earned
  casual
  sick
  /// Leave without pay — the one type not checked against a balance (FR-020).
  lwp

  @@schema("hr")
}

enum LeaveApplicationStatus {
  pending
  approved
  rejected
  cancelled

  @@schema("hr")
}

/// An employee-originated expense claim (US8).
///
/// In `hr`, not `payroll`, because the claim exists as the employee's own record
/// long before payroll has any interest in it — the same shape Leave already has
/// (research.md §10). Feature 005 adds the admin review layer over this same table;
/// it does not get a second one. This feature writes only `draft` → `submitted` →
/// `withdrawn`; the approval and payment fields below are read-only here.
model ReimbursementClaim {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Denormalized from the owning Employee so the claim can be RLS-filtered by a
  /// plain equality. Unlike the attendance tables, a claim is a financial document
  /// that must stay with the company it was incurred against even if the employee
  /// later moves — so the copy here is the intended record, not a cache of
  /// Employee's value.
  companyId String

  /// FK to `settings.ReimbursementCategory` by value only. No Prisma relation:
  /// Principle I routes the read through `ReimbursementCategoriesService`, and a
  /// declared relation is exactly the cross-schema join that would bypass it.
  categoryId String

  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @db.Date
  description String

  /// Encrypted object-storage reference to the receipt image. Mandatory above the
  /// category's configured threshold (FR-030).
  receiptRef String?

  status           ReimbursementClaimStatus  @default(submitted)
  /// Written by feature 005 once a claim is approved and paid; never by this one.
  paymentMode      ReimbursementPaymentMode?
  paymentReference String?

  /// Feature 005's decision fields. Present here because the table is shared, and
  /// splitting them into a second table would make "one claim, one status" untrue.
  decidedByUserId String?
  decidedAt       DateTime?
  adminRemarks    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([companyId, status])
  @@schema("hr")
}

enum ReimbursementClaimStatus {
  draft
  submitted
  approved
  rejected
  paid
  /// Employee-initiated retraction while still pending review (FR-032). Distinct
  /// from `rejected`, which is an admin's verdict — collapsing the two would lose
  /// the difference between "I changed my mind" and "this was refused".
  withdrawn

  @@schema("hr")
}

enum ReimbursementPaymentMode {
  payroll
  direct

  @@schema("hr")
}

// ============================================================================
// payroll schema — feature 003 reads these; it does not compute payroll.
// ============================================================================

enum Gender {
  male
  female
  other

  @@schema("hr")
}

enum MaritalStatus {
  single
  married
  divorced
  widowed

  @@schema("hr")
}

enum EmploymentType {
  full_time
  contract
  daily_wage

  @@schema("hr")
}

enum CalculationMode {
  monthly
  daily

  @@schema("hr")
}

/// Per-employee uploaded document, keyed to a `settings.DocumentType` (002). A
/// re-upload replaces the reference for that type — historical versions are not
/// retained (data-model.md §Employee Document).
model EmployeeDocument {
  id         String @id @default(cuid())
  employeeId String

  /// `settings.DocumentType.id`; resolved via SettingsService, not a relation.
  documentTypeId String
  /// Encrypted object-storage reference, same mechanism as 003's biometric blobs.
  fileRef        String
  documentNumber String?
  expiresAt      DateTime? @db.Date

  uploadedByUserId String
  uploadedAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, documentTypeId])
  @@index([expiresAt])
  @@schema("hr")
}

/// Append-only record of an employee moving between companies (US8).
model EmployeeTransfer {
  id         String @id @default(cuid())
  employeeId String

  fromCompanyId String
  toCompanyId   String
  transferDate  DateTime @db.Date
  reason        String

  /// When false, a fresh code is allocated in the destination company.
  codeRetained    Boolean @default(false)
  newEmployeeCode String?

  transferredByUserId String
  createdAt           DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@schema("hr")
}

enum HolidayType {
  national
  regional
  company

  @@schema("hr")
}

/// Supersedes `projects.Site.holidays` (research.md §6) — a first-class, typed,
/// company-scoped holiday calendar that attendance status computation reads.
model Holiday {
  id        String @id @default(cuid())
  /// Company-level calendar, not employee-owned — keeps its own tenant key.
  companyId String

  name String
  date DateTime    @db.Date
  type HolidayType @default(company)

  /// When false, applicability is restricted to the sites in `sites`.
  appliesToAllSites Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites HolidaySite[]

  @@unique([companyId, date, name])
  @@index([companyId, date])
  @@schema("hr")
}

model HolidaySite {
  holidayId String
  /// `projects.Site.id` — bare id, resolved via SitesService.
  siteId    String

  holiday Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@id([holidayId, siteId])
  @@index([siteId])
  @@schema("hr")
}

/// Append-only audit of every manual attendance edit (FR-010). Never updated.
model AttendanceModification {
  id         String @id @default(cuid())
  employeeId String

  date        DateTime @db.Date
  actorUserId String
  before      Json
  after       Json
  reason      String?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@schema("hr")
}

enum ExitReason {
  resignation
  termination
  contract_end

  @@schema("hr")
}

/// Employee offboarding record (US11). The F&F settlement itself is a normal
/// PayrollRun flagged `isFnf`, linked here.
model ExitRecord {
  id         String @id @default(cuid())
  employeeId String

  lastWorkingDay DateTime   @db.Date
  reason         ExitReason
  remarks        String?

  /// `payroll.PayrollRun.id` of the F&F run — bare id, cross-schema by service.
  fnfPayrollRunId String?

  initiatedByUserId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@schema("hr")
}

enum TaxDeclarationStatus {
  declared
  verified

  @@schema("hr")
}

/// An employee's investment declaration for a financial year (US14, FR-052).
model TaxDeclaration {
  id         String @id @default(cuid())
  employeeId String

  financialYear String
  regime        TaxRegime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines    TaxDeclarationLine[]

  @@unique([employeeId, financialYear])
  @@index([employeeId])
  @@schema("hr")
}

/// One declared deduction, e.g. 80C. `cappedAmount` is what actually reduces
/// taxable income — the declared figure is retained so an employee can see that
/// their claim was capped rather than silently reduced.
model TaxDeclarationLine {
  id            String @id @default(cuid())
  declarationId String

  sectionCode    String
  declaredAmount Decimal @db.Decimal(14, 2)
  cappedAmount   Decimal @db.Decimal(14, 2)

  status           TaxDeclarationStatus @default(declared)
  proofRef         String?
  verifiedByUserId String?
  verifiedAt       DateTime?

  declaration TaxDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@unique([declarationId, sectionCode])
  @@schema("hr")
}

enum SalaryAdvanceStatus {
  pending
  approved
  disbursed
  closed

  @@schema("hr")
}

/// A salary advance (US15, FR-054).
///
/// Deliberately NOT a `payroll.Loan`: an advance carries no interest and no
/// amortisation schedule, and is recovered in full in one nominated month. Modelling
/// it as a one-instalment loan would put two different things behind one screen and
/// one set of rules.
model SalaryAdvance {
  id         String @id @default(cuid())
  employeeId String

  amount Decimal @db.Decimal(12, 2)
  reason String

  /// Period key, `YYYY-MM`, the recovery is attempted in.
  recoveryMonth      String
  outstandingBalance Decimal @db.Decimal(12, 2)
  /// Above the configured multiple of monthly net; needs explicit approval.
  exceedsLimit       Boolean @default(false)

  status SalaryAdvanceStatus @default(pending)

  approvedByUserId String?
  disbursedOn      DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([recoveryMonth])
  @@schema("hr")
}

/// Status only. This feature reads it for two things: whether a period is locked to
/// further attendance writes (FR-010), and whether a salary slip may be served at
/// all (a `draft` run has no publishable figures).
model PayrollRun {
  id        String @id @default(cuid())
  /// RLS-protected. Bare id — see the note on `Site.companyId`.
  companyId String

  /// Period key, e.g. "2026-07".
  period String
  status PayrollRunStatus @default(draft)

  /// An F&F settlement run covers exactly one exiting employee and is flagged for
  /// reporting/audit (research.md §12, US11).
  isFnf Boolean @default(false)

  generatedAt       DateTime?
  generatedByUserId String?
  processedAt       DateTime?
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems PayrollLineItem[]

  /// NOTE: uniqueness is a *partial* index applied in the migration —
  /// one non-F&F run per (companyId, period), but many F&F runs per period
  /// (one per exiting employee). Prisma cannot express a partial unique index,
  /// so it is created as raw SQL in the migration instead.
  @@index([companyId, period])
  @@schema("payroll")
}

enum PayrollRunStatus {
  draft
  processed
  paid

  @@schema("payroll")
}

/// The per-employee, per-period computed payroll figures — the single source of
/// truth that `/hr/challans/*`, 003's `/my/salary`, and 008's Project P&L labour
/// cost line all read from (data-model.md §Payroll Line Item). Immutable once its
/// run reaches `processed` (FR-015), enforced at the write path.
model PayrollLineItem {
  id           String @id @default(cuid())
  payrollRunId String
  employeeId   String

  /// `projects.Project.id` — nullable; null for HO/overhead staff. Resolved via
  /// ProjectsService, never a cross-schema Prisma relation (FR-046).
  projectId String?

  // ── Attendance basis ──────────────────────────────────────────────────────
  monthDays   Int
  payableDays Decimal @db.Decimal(6, 2)
  lopDays     Decimal @default(0) @db.Decimal(6, 2)
  otHours     Decimal @default(0) @db.Decimal(8, 2)
  otWages     Decimal @default(0) @db.Decimal(12, 2)

  // ── Earnings ──────────────────────────────────────────────────────────────
  basic               Decimal @default(0) @db.Decimal(12, 2)
  hra                 Decimal @default(0) @db.Decimal(12, 2)
  conveyanceAllowance Decimal @default(0) @db.Decimal(12, 2)
  siteAllowance       Decimal @default(0) @db.Decimal(12, 2)
  specialAllowance    Decimal @default(0) @db.Decimal(12, 2)

  // ── Employee deductions ───────────────────────────────────────────────────
  employeePf       Decimal @default(0) @db.Decimal(12, 2)
  employeeEsic     Decimal @default(0) @db.Decimal(12, 2)
  professionalTax  Decimal @default(0) @db.Decimal(12, 2)
  /// Manual entry, default 0 (spec clarification — TDS computation arrives with
  /// the 2026-09-01 amendment, US14).
  tds              Decimal @default(0) @db.Decimal(12, 2)
  loanEmiDeduction Decimal @default(0) @db.Decimal(12, 2)

  netPay Decimal @default(0) @db.Decimal(12, 2)

  // ── Employer contributions ────────────────────────────────────────────────
  employerPf   Decimal @default(0) @db.Decimal(12, 2)
  employerEps  Decimal @default(0) @db.Decimal(12, 2)
  employerEdli Decimal @default(0) @db.Decimal(12, 2)
  adminCharges Decimal @default(0) @db.Decimal(12, 2)
  employerEsic Decimal @default(0) @db.Decimal(12, 2)
  gratuity     Decimal @default(0) @db.Decimal(12, 2)
  bonus        Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@index([projectId])
  @@schema("payroll")
}

enum LoanStatus {
  pending
  active
  closed

  @@schema("payroll")
}

/// An employee advance/loan with an auto-generated EMI schedule that feeds payroll
/// deductions (US7).
model Loan {
  id String @id @default(cuid())

  /// DELIBERATE deviation from the "scope through Employee" pattern the 003 RLS
  /// migration establishes. A loan is a financial obligation issued *by a company*,
  /// so US8's transfer-between-companies must not silently hand visibility of an
  /// outstanding debt to the destination tenant. Kept as its own tenant key, and
  /// the transfer flow deliberately does not rewrite it.
  companyId  String
  employeeId String

  amount           Decimal    @db.Decimal(12, 2)
  emiAmount        Decimal    @db.Decimal(12, 2)
  disbursementDate DateTime   @db.Date
  reason           String
  remarks          String?
  status           LoanStatus @default(pending)

  approvedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule LoanScheduleEntry[]

  @@index([companyId])
  @@index([employeeId, status])
  @@schema("payroll")
}

enum LoanScheduleStatus {
  upcoming
  paid
  overdue

  @@schema("payroll")
}

/// One month of a loan's amortisation schedule. Generated on approval; the payroll
/// engine marks an entry `paid` and stamps `paidInPayrollRunId` when it deducts.
model LoanScheduleEntry {
  id     String @id @default(cuid())
  loanId String

  /// Period key, e.g. "2026-07".
  month            String
  emiAmount        Decimal @db.Decimal(12, 2)
  principal        Decimal @db.Decimal(12, 2)
  interest         Decimal @default(0) @db.Decimal(12, 2)
  remainingBalance Decimal @db.Decimal(12, 2)

  status             LoanScheduleStatus @default(upcoming)
  paidInPayrollRunId String?

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, month])
  @@index([status])
  @@schema("payroll")
}

/// The per-employee, per-period payslip figures this feature serves as JSON and
/// PDF (data-model.md "Salary Slip").
///
/// A stored projection, not a computation: feature 003 formats a payslip, it does
/// not calculate one. Whichever feature owns payroll processing writes these rows
/// when a run moves to `processed`; a slip whose run is still `draft` is never
/// served (FR-024).
///
/// Every figure is `Decimal`, never `Float` — these are money, and binary rounding
/// drift in a payslip is a wage dispute.
model SalarySlip {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Matches `PayrollRun.period`, e.g. "2026-07". Referenced by value rather than
  /// by FK because a run is company-scoped while a slip is employee-scoped; the
  /// service pairs them explicitly so the `draft` check can never be skipped.
  period String

  monthDays   Int
  payableDays Decimal @db.Decimal(5, 2)
  lopDays     Decimal @db.Decimal(5, 2)
  otHours     Decimal @db.Decimal(6, 2)

  earningBasic            Decimal @db.Decimal(12, 2)
  earningHra              Decimal @db.Decimal(12, 2)
  earningConveyance       Decimal @db.Decimal(12, 2)
  earningSiteAllowance    Decimal @db.Decimal(12, 2)
  earningSpecialAllowance Decimal @db.Decimal(12, 2)
  earningOt               Decimal @db.Decimal(12, 2)

  deductionPf              Decimal @db.Decimal(12, 2)
  deductionEsic            Decimal @db.Decimal(12, 2)
  deductionPt              Decimal @db.Decimal(12, 2)
  deductionTds             Decimal @db.Decimal(12, 2)
  deductionLoanEmi         Decimal @db.Decimal(12, 2)
  deductionAdvanceRecovery Decimal @db.Decimal(12, 2)

  /// Informational on the payslip — shown to the employee, not subtracted from
  /// `netPay`.
  employerPf           Decimal @db.Decimal(12, 2)
  employerEps          Decimal @db.Decimal(12, 2)
  employerEdli         Decimal @db.Decimal(12, 2)
  employerAdminCharges Decimal @db.Decimal(12, 2)
  employerGratuity     Decimal @db.Decimal(12, 2)
  employerBonus        Decimal @db.Decimal(12, 2)

  /// Stored rather than derived on read: a payslip already issued must keep showing
  /// the figure it was issued with, even if a later correction changes its inputs.
  netPay Decimal @db.Decimal(12, 2)

  /// The statutory-compliance line the payslip carries.
  minimumWagesNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, period])
  @@index([employeeId])
  @@schema("payroll")
}

// ─────────────────────────────────────────────────────────────────────────────
// 007-partners-backend
//
// Vendors and the contractor compliance vault. Two models land in `settings`
// rather than `partners`: VendorCategory, because it is a company master edited
// under Settings and referenced from several modules (research.md §1), and
// CodeSequence, because vendor codes are one instance of a per-company numbering
// concern that 008's project codes will reuse.
// ─────────────────────────────────────────────────────────────────────────────

/// Named per-company numbering series. Generalises the pattern
/// `EmployeeCodeSequence` established for employees, which stays as it is — it
/// predates this table and carries its own 1:1 relation to Company.
enum CodeSeriesType {
  VENDORS
  /// Added by 008. `CodeSeriesService` was written anticipating this ("vendors
  /// today, project codes when 008 lands") — the series is per company, so two
  /// companies' projects number independently.
  PROJECTS

  @@schema("settings")
}

model CodeSequence {
  id String @id @default(cuid())

  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  seriesType CodeSeriesType
  /// Advanced by an atomic `UPDATE ... RETURNING`, the same way employee codes are
  /// allocated, so concurrent callers can never observe the same number twice.
  lastNumber Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, seriesType])
  @@schema("settings")
}

/// What a vendor deals in. A company master, not a fixed enum: the PRD's six
/// defaults are seeded but a company may add its own (FR-002a).
model VendorCategory {
  id String @id @default(cuid())

  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  name        String
  description String?
  /// True for the six rows seeded with a new company. Advisory — it does not block
  /// deletion; the `VendorDealsIn` guard does that (FR-014).
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

enum VendorType {
  material
  fuel
  hire
  service
  subcontractor
  labour_contractor

  @@schema("partners")
}

model Vendor {
  id String @id @default(cuid())

  /// Plain column, not a cross-schema relation — the same treatment `hr.Employee`
  /// gives its company reference. RLS is what scopes it.
  companyId String
  /// Allocated from the company's VENDORS series: `{shortCode}-VEN-0001`.
  code      String

  name String
  type VendorType

  /// Format-validated at the DTO boundary (FR-002b). Nullable because an unregistered
  /// local supplier legitimately has neither.
  gstin String?
  pan   String?

  /// Open-ended by design: the Income Tax Act's section list changes, and the master
  /// PRD specifies a free-text section rather than a closed enum.
  tdsSection String?
  tdsRate    Decimal? @db.Decimal(5, 2)

  active Boolean @default(true)

  address String?
  city    String?
  state   String?
  pinCode String?

  /// Almost always INR. Carried per-vendor because import suppliers are invoiced in
  /// their own currency and the rate at which that was converted must be recorded
  /// with the vendor rather than inferred later.
  vendorCurrency String  @default("INR")
  exchangeRate   Decimal @default(1.0) @db.Decimal(12, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   VendorContact[]
  dealsIn    VendorDealsIn[]
  hireDetail VendorHireDetail?
  contractor ContractorProfile?

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, type])
  @@schema("partners")
}

model VendorContact {
  id String @id @default(cuid())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  email String?

  /// No `updatedAt`: contacts are replaced wholesale on vendor update rather than
  /// edited row by row (research.md §10), so a per-row modification time would
  /// always equal the row's creation time and mislead.
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@schema("partners")
}

/// Vendor ↔ VendorCategory. `categoryId` crosses into `settings` as a plain UUID and
/// is validated on write via the exported settings service rather than by a database
/// FK — Principle I keeps cross-module integrity in the service layer.
model VendorDealsIn {
  vendorId   String
  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([vendorId, categoryId])
  @@index([categoryId])
  @@schema("partners")
}

enum HireType {
  taken
  given

  @@schema("partners")
}

enum ChargesBase {
  monthly
  daily

  @@schema("partners")
}

/// Hire terms, for `hire` and `subcontractor` vendors. Split from Vendor rather than
/// widening it: fourteen columns that are null for every material supplier belong in
/// their own optional row.
model VendorHireDetail {
  id String @id @default(cuid())

  vendorId String @unique
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  hireType HireType

  contractCode String?
  periodFrom   DateTime? @db.Date
  periodTo     DateTime? @db.Date

  machineCategory String?
  machineName     String?
  requiredAvg     Decimal? @db.Decimal(12, 2)

  chargesBase    ChargesBase @default(monthly)
  rate           Decimal?    @db.Decimal(12, 2)
  minWorkingDays Int?
  allowBdDays    Boolean     @default(false)
  allowIdleDays  Boolean     @default(false)

  operatorCharges    Decimal? @db.Decimal(12, 2)
  helperCharges      Decimal? @db.Decimal(12, 2)
  maintenanceCharges Decimal? @db.Decimal(12, 2)
  fuelCharges        Decimal? @db.Decimal(12, 2)

  termsAndConditions String?
  requirements       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("partners")
}

enum ContractorComplianceStatus {
  compliant
  partially_compliant
  non_compliant

  @@schema("partners")
}

/// The compliance extension of a vendor that supplies labour. 1:1 with Vendor and
/// only for `subcontractor` / `labour_contractor` types — enforced in the service,
/// since the constraint is on a column of the related row.
model ContractorProfile {
  id String @id @default(cuid())

  companyId String
  vendorId  String @unique
  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  licenceNumber         String?
  pfRegistration        String?
  esicRegistration      String?
  bocwRegistration      String?
  insurancePolicyNumber String?

  /// Derived, never set directly by a caller. Recomputed from the most recently
  /// concluded month's MonthlyCompliance row on every compliance change (FR-005),
  /// and persisted so the contractor list can filter on it without recomputing per
  /// row. Defaults to non_compliant: a contractor with no filing history has not
  /// demonstrated compliance, and defaulting the other way would read as a clean
  /// record.
  complianceStatus ContractorComplianceStatus @default(non_compliant)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents  ContractorDocument[]
  compliance MonthlyCompliance[]

  @@unique([companyId, vendorId])
  @@index([companyId])
  @@schema("partners")
}

enum ContractorDocumentType {
  labour_license
  pf_registration
  esic_registration
  insurance
  bocw_registration

  @@schema("partners")
}

model ContractorDocument {
  id String @id @default(cuid())

  contractorProfileId String
  contractorProfile   ContractorProfile @relation(fields: [contractorProfileId], references: [id], onDelete: Cascade)

  documentType ContractorDocumentType
  /// Object-storage key, never a public URL — resolved to a short-lived signed URL at
  /// read time, the same treatment employee documents get.
  fileRef      String
  fileName     String?
  /// Statutory registrations expire. `expiryWarning` is derived at read time rather
  /// than stored, because a stored flag is wrong the day after it is written.
  expiresAt    DateTime?              @db.Date

  uploadedByUserId String
  uploadedAt       DateTime @default(now())

  @@index([contractorProfileId])
  @@schema("partners")
}

enum MonthlyComplianceStatus {
  missing
  partial
  submitted
  verified

  @@schema("partners")
}

/// One contractor's PF/ESIC filing for one month.
model MonthlyCompliance {
  id String @id @default(cuid())

  companyId           String
  contractorProfileId String
  contractorProfile   ContractorProfile @relation(fields: [contractorProfileId], references: [id], onDelete: Cascade)

  /// `YYYY-MM`. A string rather than a date because the row is about a month, and a
  /// date would invite a spurious day component that every consumer must then ignore.
  month String

  pfChallanNumber String?
  pfAmount        Decimal?  @db.Decimal(12, 2)
  pfDate          DateTime? @db.Date

  esicChallanNumber String?
  esicAmount        Decimal?  @db.Decimal(12, 2)
  esicDate          DateTime? @db.Date

  /// Auto-derived from which challans are present (FR-006), except `verified`, which
  /// only the explicit verify endpoint sets.
  status MonthlyComplianceStatus @default(missing)

  verifiedByUserId String?
  verifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractorProfileId, month])
  @@index([companyId, month])
  @@schema("partners")
}

/// A cess payment against a project. Liability, total paid and balance are computed
/// on demand rather than stored (research.md §5) — a stored balance is a second
/// source of truth that drifts the moment a payment is corrected.
model BOCWPayment {
  id String @id @default(cuid())

  companyId String
  /// Cross-schema reference to `projects.Project`, stored as a plain UUID and
  /// resolved through ProjectsService. Feature 008 owns that table and has not been
  /// built, so today this is validated only for presence.
  projectId String

  amountPaid      Decimal  @db.Decimal(14, 2)
  paymentDate     DateTime @db.Date
  referenceNumber String
  remarks         String?

  recordedByUserId String
  createdAt        DateTime @default(now())

  @@index([companyId, projectId])
  @@schema("partners")
}

// ────────────────────────────────────────────────────────────────────────────
// Feature 004 — cross-module reminders engine (spec FR-028 to FR-035).
//
// These live in `shared` for the same reason `AuditLogEntry` does: a reminder is not
// a machinery record or an asset record, it is the cross-cutting statement "something
// owned by *some* module falls due on this date". The rows below therefore reference
// their subject by (`sourceModule`, `entityType`, `entityId`) rather than by a foreign
// key — a real FK would have to point at a different schema per rule, which is exactly
// the cross-schema coupling Principle I exists to prevent. The owning module resolves
// its own ids through its own exported service.
//
// `sourceModule` and `entityType` are plain strings, not enums, deliberately: FR-028
// requires a module to contribute a new reminder type *without editing this feature*,
// and an enum would make every new rule a migration in a file this feature owns.
// ────────────────────────────────────────────────────────────────────────────

/// The severity band a reminder currently sits in (spec FR-030). A band, not a score:
/// de-duplication (FR-032) keys off it, so it has to be a small closed set.
enum ReminderSeverity {
  info
  warning
  overdue

  @@schema("shared")
}

/// The persisted catalogue of registered reminder rules.
///
/// The rule's *logic* lives in code — a `ReminderRuleProvider` in the owning module
/// (src/dashboard/reminders/reminder-rule.types.ts), which is what makes FR-028's
/// "no edit to this feature" guarantee possible. This table is the mirror of those
/// declarations, synced on boot by `ReminderRuleRegistry`, and it earns its place by
/// giving an operator one queryable list of what the engine will evaluate and an
/// `enabled` flag that silences a misbehaving rule without a deploy.
model ReminderRule {
  id String @id @default(cuid())

  /// Stable identity, chosen by the registering module: `machinery-service-due`.
  /// Unique across the installation — it is half of a reminder's composite id.
  ruleKey String @unique

  /// Which module owns the rule and resolves its entities: `machinery`, `settings`.
  sourceModule String
  /// The reminder family, for the list's type filter: `document_expiry`.
  type         String
  /// What the rule evaluates over, e.g. `EQUIPMENT_DOCUMENT`. Free text for the
  /// reason given above the enum block.
  entityType   String

  /// How far ahead of the due date the rule starts producing reminders (FR-029).
  leadDays        Int
  /// The severity ladder (FR-029), stored as `{ warnWithinDays: number }`. JSON
  /// rather than a column so a future ladder with more bands does not need a
  /// migration in this feature.
  severityLadder  Json

  /// Set false to stop evaluating the rule without removing its provider.
  enabled Boolean @default(true)

  /// NULL means the declaration applies to every company — which is the normal case,
  /// since rules are declared in code. A non-null value scopes an override to one
  /// company; the RLS policy admits both.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snoozes       ReminderSnooze[]
  notifications ReminderNotification[]

  @@index([sourceModule])
  @@index([companyId])
  @@schema("shared")
}

/// A suppression of one reminder until a date (spec FR-034).
///
/// Keyed by (rule, entity) rather than by a reminder id, because a reminder is
/// computed and has no stored row — the pair is what actually persists between
/// evaluations.
model ReminderSnooze {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ruleKey String
  rule    ReminderRule @relation(fields: [ruleKey], references: [ruleKey], onDelete: Cascade)

  entityType String
  entityId   String

  /// Inclusive: the reminder reappears the day *after* this date. Stored as a date,
  /// not a timestamp — "snoozed until the 14th" is a calendar statement, and a
  /// timestamp would make it mean something different in every timezone.
  snoozeUntil DateTime @db.Date
  reason      String

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([companyId, ruleKey, entityId])
  @@index([snoozeUntil])
  @@schema("shared")
}

/// The emitted-notification ledger — what makes FR-032/FR-033 possible.
///
/// DELIBERATE ADDITION beyond the spec's Key Entities list, which names only
/// ReminderRule, Reminder (computed) and ReminderSnooze. FR-032 requires "at most one
/// notification per entity, per rule, per severity band" with escalation emitting
/// anew, and FR-033 requires a resolved reminder's open notification to be *closed*.
/// Both are statements about what was emitted before, and nothing stateless can
/// answer them: recomputing the list from scratch can tell you a reminder exists, but
/// never whether it has already been announced. See specs/004-dashboard-backend/
/// tasks.md, the 2026-09-03 implementation note.
model ReminderNotification {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ruleKey String
  rule    ReminderRule @relation(fields: [ruleKey], references: [ruleKey], onDelete: Cascade)

  entityType String
  entityId   String
  /// Copied at emission time so a closed notification still reads sensibly after the
  /// underlying record is renamed or deleted.
  subject    String
  dueDate    DateTime @db.Date

  severity ReminderSeverity

  emittedAt DateTime  @default(now())
  /// Null while open. Set when the condition is resolved (FR-033), when the reminder
  /// escalates out of this band (FR-032), or when it is snoozed (FR-034).
  closedAt  DateTime?
  /// Why it closed, for the audit trail a bare timestamp cannot give: `resolved`,
  /// `escalated`, `snoozed`.
  closeReason String?

  @@index([companyId, ruleKey, entityId])
  @@index([companyId, closedAt])
  @@schema("shared")
}
