enum SalaryAdvanceStatus {
  pending
  approved
  disbursed
  closed

  @@schema("hr")
}

/// A salary advance (US15, FR-054).
///
/// Deliberately NOT a `payroll.Loan`: an advance carries no interest and no
/// amortisation schedule, and is recovered in full in one nominated month. Modelling
/// it as a one-instalment loan would put two different things behind one screen and
/// one set of rules.
model SalaryAdvance {
  id         String @id @default(cuid())
  employeeId String

  amount Decimal @db.Decimal(12, 2)
  reason String

  /// Period key, `YYYY-MM`, the recovery is attempted in.
  recoveryMonth      String
  outstandingBalance Decimal @db.Decimal(12, 2)
  /// Above the configured multiple of monthly net; needs explicit approval.
  exceedsLimit       Boolean @default(false)

  status SalaryAdvanceStatus @default(pending)

  approvedByUserId String?
  disbursedOn      DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([recoveryMonth])
  @@schema("hr")
}

/// Status only. This feature reads it for two things: whether a period is locked to
/// further attendance writes (FR-010), and whether a salary slip may be served at
/// all (a `draft` run has no publishable figures).
model PayrollRun {
  id        String @id @default(cuid())
  /// RLS-protected. Bare id — see the note on `Site.companyId`.
  companyId String

  /// Period key, e.g. "2026-07".
  period String
  status PayrollRunStatus @default(draft)

  /// An F&F settlement run covers exactly one exiting employee and is flagged for
  /// reporting/audit (research.md §12, US11).
  isFnf Boolean @default(false)

  generatedAt       DateTime?
  generatedByUserId String?
  processedAt       DateTime?
  paidAt            DateTime?

  /// True when the monthly schedule created this run rather than a person (016 FR-013).
  ///
  /// Not decoration: the production API is deployed on an instance class that suspends
  /// when idle, and a suspended instance runs no schedule (research.md §4). Without this
  /// column, "did the 1st-of-the-month run actually fire?" can only be answered by
  /// inferring from timestamps. With it, an operator can see at a glance whether the
  /// automation is working or whether somebody has been quietly creating runs by hand.
  createdBySchedule Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems PayrollLineItem[]

  /// NOTE: uniqueness is a *partial* index applied in the migration —
  /// one non-F&F run per (companyId, period), but many F&F runs per period
  /// (one per exiting employee). Prisma cannot express a partial unique index,
  /// so it is created as raw SQL in the migration instead.
  @@index([companyId, period])
  @@schema("payroll")
}

enum PayrollRunStatus {
  draft
  processed
  paid

  @@schema("payroll")
}

/// The per-employee, per-period computed payroll figures — the single source of
/// truth that `/hr/challans/*`, 003's `/my/salary`, and 008's Project P&L labour
/// cost line all read from (data-model.md §Payroll Line Item). Immutable once its
/// run reaches `processed` (FR-015), enforced at the write path.
model PayrollLineItem {
  id           String @id @default(cuid())
  payrollRunId String
  employeeId   String

  /// `projects.Project.id` — nullable; null for HO/overhead staff. Resolved via
  /// ProjectsService, never a cross-schema Prisma relation (FR-046).
  projectId String?

  // ── Attendance basis ──────────────────────────────────────────────────────
  monthDays   Int
  payableDays Decimal @db.Decimal(6, 2)
  lopDays     Decimal @default(0) @db.Decimal(6, 2)
  otHours     Decimal @default(0) @db.Decimal(8, 2)
  otWages     Decimal @default(0) @db.Decimal(12, 2)

  // ── Earnings ──────────────────────────────────────────────────────────────
  basic               Decimal @default(0) @db.Decimal(12, 2)
  hra                 Decimal @default(0) @db.Decimal(12, 2)
  conveyanceAllowance Decimal @default(0) @db.Decimal(12, 2)
  siteAllowance       Decimal @default(0) @db.Decimal(12, 2)
  specialAllowance    Decimal @default(0) @db.Decimal(12, 2)

  // ── Employee deductions ───────────────────────────────────────────────────
  employeePf       Decimal @default(0) @db.Decimal(12, 2)
  employeeEsic     Decimal @default(0) @db.Decimal(12, 2)
  professionalTax  Decimal @default(0) @db.Decimal(12, 2)
  /// Manual entry, default 0 (spec clarification — TDS computation arrives with
  /// the 2026-09-01 amendment, US14).
  tds              Decimal @default(0) @db.Decimal(12, 2)
  loanEmiDeduction Decimal @default(0) @db.Decimal(12, 2)

  /// Fuel lost on a machine, recovered from the operator who ran it (020 FR-007).
  ///
  /// **Its own column, not `loanEmiDeduction`.** FR-007 says a *named* deduction, and the task
  /// generating it says named as a fuel recovery and not as an advance. The distinction is the
  /// employee's: a loan instalment is money they asked for and agreed to repay, and this is money
  /// taken for a loss. Folding it into either would leave somebody reading their payslip unable to
  /// tell why their pay fell, which FR-007 exists to prevent.
  fuelRecoveryDeduction Decimal @default(0) @db.Decimal(12, 2)

  netPay Decimal @default(0) @db.Decimal(12, 2)

  // ── Employer contributions ────────────────────────────────────────────────
  employerPf   Decimal @default(0) @db.Decimal(12, 2)
  employerEps  Decimal @default(0) @db.Decimal(12, 2)
  employerEdli Decimal @default(0) @db.Decimal(12, 2)
  adminCharges Decimal @default(0) @db.Decimal(12, 2)
  employerEsic Decimal @default(0) @db.Decimal(12, 2)
  gratuity     Decimal @default(0) @db.Decimal(12, 2)
  bonus        Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@index([projectId])
  @@schema("payroll")
}

enum LoanStatus {
  pending
  active
  closed

  @@schema("payroll")
}

/// An employee advance/loan with an auto-generated EMI schedule that feeds payroll
/// deductions (US7).
model Loan {
  id String @id @default(cuid())

  /// DELIBERATE deviation from the "scope through Employee" pattern the 003 RLS
  /// migration establishes. A loan is a financial obligation issued *by a company*,
  /// so US8's transfer-between-companies must not silently hand visibility of an
  /// outstanding debt to the destination tenant. Kept as its own tenant key, and
  /// the transfer flow deliberately does not rewrite it.
  companyId  String
  employeeId String

  amount           Decimal    @db.Decimal(12, 2)
  emiAmount        Decimal    @db.Decimal(12, 2)
  disbursementDate DateTime   @db.Date
  reason           String
  remarks          String?
  status           LoanStatus @default(pending)

  approvedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule LoanScheduleEntry[]

  @@index([companyId])
  @@index([employeeId, status])
  @@schema("payroll")
}

enum LoanScheduleStatus {
  upcoming
  paid
  overdue

  @@schema("payroll")
}

/// One month of a loan's amortisation schedule. Generated on approval; the payroll
/// engine marks an entry `paid` and stamps `paidInPayrollRunId` when it deducts.
model LoanScheduleEntry {
  id     String @id @default(cuid())
  loanId String

  /// Period key, e.g. "2026-07".
  month            String
  emiAmount        Decimal @db.Decimal(12, 2)
  principal        Decimal @db.Decimal(12, 2)
  interest         Decimal @default(0) @db.Decimal(12, 2)
  remainingBalance Decimal @db.Decimal(12, 2)

  status             LoanScheduleStatus @default(upcoming)
  paidInPayrollRunId String?

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, month])
  @@index([status])
  @@schema("payroll")
}

/// The per-employee, per-period payslip figures this feature serves as JSON and
/// PDF (data-model.md "Salary Slip").
///
/// A stored projection, not a computation: feature 003 formats a payslip, it does
/// not calculate one. Whichever feature owns payroll processing writes these rows
/// when a run moves to `processed`; a slip whose run is still `draft` is never
/// served (FR-024).
///
/// Every figure is `Decimal`, never `Float` — these are money, and binary rounding
/// drift in a payslip is a wage dispute.
model SalarySlip {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Matches `PayrollRun.period`, e.g. "2026-07". Referenced by value rather than
  /// by FK because a run is company-scoped while a slip is employee-scoped; the
  /// service pairs them explicitly so the `draft` check can never be skipped.
  period String

  monthDays   Int
  payableDays Decimal @db.Decimal(5, 2)
  lopDays     Decimal @db.Decimal(5, 2)
  otHours     Decimal @db.Decimal(6, 2)

  earningBasic            Decimal @db.Decimal(12, 2)
  earningHra              Decimal @db.Decimal(12, 2)
  earningConveyance       Decimal @db.Decimal(12, 2)
  earningSiteAllowance    Decimal @db.Decimal(12, 2)
  earningSpecialAllowance Decimal @db.Decimal(12, 2)
  earningOt               Decimal @db.Decimal(12, 2)

  /// The **unprorated** monthly entitlement for each component (021 FR-008f, task T105).
  ///
  /// `docs/NC0060_Payslip_Feb 2026.pdf` prints earnings as two columns, Full and Actual: what the
  /// salary structure says per month, beside what LOP left of it. The `earning*` columns above are
  /// the Actual ones.
  ///
  /// **Stored, not derived from the employee master on read.** A salary revision next year would
  /// otherwise retroactively rewrite the Full column of a payslip already issued — and the figures
  /// above are stored for exactly that reason, so deriving these would make one half of the same
  /// table authoritative and the other half not.
  ///
  /// Nullable, and only because every slip issued before 2026-10-02 predates them. The PDF prints
  /// an em dash rather than repeating the Actual figure where they are null: Full equal to Actual
  /// means "no LOP this month", and a reader must not be unable to tell that from "we never
  /// recorded it".
  fullEarningBasic            Decimal? @db.Decimal(12, 2)
  fullEarningHra              Decimal? @db.Decimal(12, 2)
  fullEarningConveyance       Decimal? @db.Decimal(12, 2)
  fullEarningSiteAllowance    Decimal? @db.Decimal(12, 2)
  fullEarningSpecialAllowance Decimal? @db.Decimal(12, 2)

  deductionPf              Decimal @db.Decimal(12, 2)
  deductionEsic            Decimal @db.Decimal(12, 2)
  deductionPt              Decimal @db.Decimal(12, 2)
  deductionTds             Decimal @db.Decimal(12, 2)
  deductionLoanEmi         Decimal @db.Decimal(12, 2)
  deductionAdvanceRecovery Decimal @db.Decimal(12, 2)
  /// 020 FR-007. Defaulted, unlike its neighbours, because every slip already issued predates it
  /// and a required column would need every historical row rewritten to a figure that was never
  /// deducted.
  deductionFuelRecovery    Decimal @default(0) @db.Decimal(12, 2)

  /// Informational on the payslip — shown to the employee, not subtracted from
  /// `netPay`.
  employerPf           Decimal @db.Decimal(12, 2)
  employerEps          Decimal @db.Decimal(12, 2)
  employerEdli         Decimal @db.Decimal(12, 2)
  employerAdminCharges Decimal @db.Decimal(12, 2)
  employerGratuity     Decimal @db.Decimal(12, 2)
  employerBonus        Decimal @db.Decimal(12, 2)

  /// Stored rather than derived on read: a payslip already issued must keep showing
  /// the figure it was issued with, even if a later correction changes its inputs.
  netPay Decimal @db.Decimal(12, 2)

  /// The statutory-compliance line the payslip carries.
  minimumWagesNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, period])
  @@index([employeeId])
  @@schema("payroll")
}

/// One attempt to email one employee their payslip (021 FR-005 to FR-007) — `bugs.md` item 8.
///
/// **`@@unique([payrollRunId, employeeId])` is what makes the retry safe**, and it is the whole
/// design. With it, a retry is an upsert per employee: running it twice sends once. Without it,
/// "retry the failures" and "retry everything" differ only by the correctness of a filter, and the
/// failure mode is 500 employees receiving a second copy of their salary slip — from a control
/// somebody pressed because the first attempt looked incomplete.
///
/// Keyed on the **employee**, not the address. Several employees at one site can share a mailbox,
/// and each must get their own row and their own slip; de-duplicating by address would silently send
/// one of them and mark the rest done.
model SlipDelivery {
  id        String @id @default(cuid())
  companyId String

  payrollRunId String
  employeeId   String

  /// The address **as sent**, stored rather than joined at read time.
  ///
  /// An employee whose email is corrected after a failure must not have the old failure read as
  /// though it went to the new address — which is exactly what a join would show, and exactly the
  /// reading that stops anybody retrying it.
  ///
  /// Personal data, which is why this table's RLS policy carries an explicit `WITH CHECK` and the
  /// read endpoint needs a payroll permission rather than merely being authenticated.
  address String

  status        SlipDeliveryStatus @default(pending)
  /// The provider's own words where there are any. Stored so a retry decision can be made from the
  /// screen instead of from a log nobody has access to.
  failureReason String?
  sentAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollRunId, employeeId])
  @@index([companyId])
  @@index([payrollRunId, status])
  @@schema("payroll")
}

enum SlipDeliveryStatus {
  pending
  sent
  failed
  /// No address on file. Distinct from `failed`, because the two need different actions from
  /// different people: a failure is retried, an undeliverable one needs somebody to find an address
  /// first. A retry that swept both up would keep failing on the same employees forever.
  undeliverable

  @@schema("payroll")
}

/// An advance recovered from a **transfer**, not from the approved run (021 FR-010 to FR-013) —
/// `bugs.md` item 9.
///
/// **`@@unique([payrollRunId, salaryAdvanceId])` *is* FR-013** — "MUST NOT recover the same advance
/// twice" — enforced by the database rather than by a check somebody has to remember in a code path
/// that regenerates a bank sheet. Producing the sheet a second time recovers nothing further.
///
/// The recovery adjusts the transfer and leaves the run's figures untouched. That is the point of
/// item 9: an advance taken *between* approval and payment day must still come out of the money that
/// actually moves, and an approved run is immutable.
model BankSheetRecovery {
  id        String @id @default(cuid())
  companyId String

  payrollRunId    String
  employeeId      String
  salaryAdvanceId String

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollRunId, salaryAdvanceId])
  @@index([companyId])
  @@index([payrollRunId])
  @@schema("payroll")
}

/// One line of the bank's own transaction sheet, as uploaded (021 FR-008 to FR-011).
///
/// **Stored whether or not it matched** (task T055). SC-004 asks that every line be either matched or
/// reported, and a parser that rejects the file on its first unrecognised row reports none of them.
/// So an unreadable row is a row here with an `unmatchedReason`, not an exception — the upload
/// succeeds and the *reconciliation* is what is incomplete.
///
/// Replaced wholesale per run on each upload rather than appended to: a second upload is a correction
/// of the first, and two sets of lines for one run would make "unmatched" a number nobody could
/// interpret.
model BankTransactionLine {
  id        String @id @default(cuid())
  companyId String

  payrollRunId String

  /// Where in the file this came from, so a reported problem can be pointed at.
  rowNumber Int

  /// The raw fields, exactly as the file gave them. Not normalised: matching normalises a copy, and
  /// storing the normalised form would lose the leading zero that is part of the account number.
  beneficiaryName    String?
  beneficiaryAccount String?
  ifsc               String?
  amount             Decimal? @db.Decimal(12, 2)

  /// The payroll line this was matched to, or null.
  matchedPayrollLineItemId String?
  /// Why it did not match, in words. Null when it did.
  unmatchedReason          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([payrollRunId])
  @@schema("payroll")
}

// ─────────────────────────────────────────────────────────────────────────────
// 007-partners-backend
//
// Vendors and the contractor compliance vault. Two models land in `settings`
// rather than `partners`: VendorCategory, because it is a company master edited
// under Settings and referenced from several modules (research.md §1), and
// CodeSequence, because vendor codes are one instance of a per-company numbering
// concern that 008's project codes will reuse.
// ─────────────────────────────────────────────────────────────────────────────

/// Named per-company numbering series. Generalises the pattern
/// `EmployeeCodeSequence` established for employees, which stays as it is — it
/// predates this table and carries its own 1:1 relation to Company.
enum CodeSeriesType {
  VENDORS
  /// Added by 008. `CodeSeriesService` was written anticipating this ("vendors
  /// today, project codes when 008 lands") — the series is per company, so two
  /// companies' projects number independently.
  PROJECTS
  /// Added by 009. Item codes (`{shortCode}-ITM-0001`) and material indent numbers
  /// (`{shortCode}-IND-0001`) — both per company, both allocated the same way
  /// vendor and project codes are.
  ITEMS
  INDENT
  /// Goods receipt notes, numbered per company like everything else here. A GRN is
  /// 1:1 with a purchase, but purchases carry no code of their own to derive from.
  GRN
  /// Added by 006. Equipment codes (`{shortCode}-EQP-0001`) for machines registered
  /// without a manufacturer plate number of their own.
  EQUIPMENT

  /// Added by 011. Manpower requisition numbers (`{shortCode}-REQ-0001`), per company.
  REQUISITION

  /// Added by 012. Asset codes (`{shortCode}-AST-0001`) and asset request numbers
  /// (`{shortCode}-ARQ-0001`) — per company, allocated the same way every series
  /// above is.
  ASSETS
  ASSET_REQUEST

  /// Added by 027. Work order numbers (`{shortCode}-WO-0001`), per company.
  ///
  /// A work order had no identifier of its own — only its free-text detail — so the one screen
  /// that has to name one, composing a bill to a subcontractor, had nothing to show but a cuid.
  WORK_ORDER

  @@schema("settings")
}

model CodeSequence {
  id String @id @default(cuid())

  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  seriesType CodeSeriesType
  /// Advanced by an atomic `UPDATE ... RETURNING`, the same way employee codes are
  /// allocated, so concurrent callers can never observe the same number twice.
  lastNumber Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, seriesType])
  @@schema("settings")
}

/// What a vendor deals in. A company master, not a fixed enum: the PRD's six
/// defaults are seeded but a company may add its own (FR-002a).
model VendorCategory {
  id String @id @default(cuid())

  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  name        String
  description String?
  /// True for the six rows seeded with a new company. Advisory — it does not block
  /// deletion; the `VendorDealsIn` guard does that (FR-014).
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

enum VendorType {
  material
  fuel
  hire
  service
  subcontractor
  labour_contractor

  @@schema("partners")
}

model Vendor {
  id String @id @default(cuid())

  /// Plain column, not a cross-schema relation — the same treatment `hr.Employee`
  /// gives its company reference. RLS is what scopes it.
  companyId String
  /// Allocated from the company's VENDORS series: `{shortCode}-VEN-0001`.
  code      String

  name String
  type VendorType

  /// Format-validated at the DTO boundary (FR-002b). Nullable because an unregistered
  /// local supplier legitimately has neither.
  gstin String?
  pan   String?

  /// Open-ended by design: the Income Tax Act's section list changes, and the master
  /// PRD specifies a free-text section rather than a closed enum.
  tdsSection String?
  tdsRate    Decimal? @db.Decimal(5, 2)

  active Boolean @default(true)

  address String?
  city    String?
  state   String?
  pinCode String?

  /// Almost always INR. Carried per-vendor because import suppliers are invoiced in
  /// their own currency and the rate at which that was converted must be recorded
  /// with the vendor rather than inferred later.
  vendorCurrency String  @default("INR")
  exchangeRate   Decimal @default(1.0) @db.Decimal(12, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   VendorContact[]
  dealsIn    VendorDealsIn[]
  hireDetail VendorHireDetail?
  contractor ContractorProfile?

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, type])
  @@schema("partners")
}

model VendorContact {
  id String @id @default(cuid())

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  email String?

  /// No `updatedAt`: contacts are replaced wholesale on vendor update rather than
  /// edited row by row (research.md §10), so a per-row modification time would
  /// always equal the row's creation time and mislead.
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@schema("partners")
}

/// Vendor ↔ VendorCategory. `categoryId` crosses into `settings` as a plain UUID and
/// is validated on write via the exported settings service rather than by a database
/// FK — Principle I keeps cross-module integrity in the service layer.
model VendorDealsIn {
  vendorId   String
  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([vendorId, categoryId])
  @@index([categoryId])
  @@schema("partners")
}

enum HireType {
  taken
  given

  @@schema("partners")
}

enum ChargesBase {
  monthly
  daily

  @@schema("partners")
}

/// Hire terms, for `hire` and `subcontractor` vendors. Split from Vendor rather than
/// widening it: fourteen columns that are null for every material supplier belong in
/// their own optional row.
model VendorHireDetail {
  id String @id @default(cuid())

  vendorId String @unique
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  hireType HireType

  contractCode String?
  periodFrom   DateTime? @db.Date
  periodTo     DateTime? @db.Date

  machineCategory String?
  machineName     String?
  requiredAvg     Decimal? @db.Decimal(12, 2)

  chargesBase    ChargesBase @default(monthly)
  rate           Decimal?    @db.Decimal(12, 2)
  minWorkingDays Int?
  allowBdDays    Boolean     @default(false)
  allowIdleDays  Boolean     @default(false)

  operatorCharges    Decimal? @db.Decimal(12, 2)
  helperCharges      Decimal? @db.Decimal(12, 2)
  maintenanceCharges Decimal? @db.Decimal(12, 2)
  fuelCharges        Decimal? @db.Decimal(12, 2)

  termsAndConditions String?
  requirements       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("partners")
}

enum ContractorComplianceStatus {
  compliant
  partially_compliant
  non_compliant

  @@schema("partners")
}

/// The compliance extension of a vendor that supplies labour. 1:1 with Vendor and
/// only for `subcontractor` / `labour_contractor` types — enforced in the service,
/// since the constraint is on a column of the related row.
model ContractorProfile {
  id String @id @default(cuid())

  companyId String
  vendorId  String @unique
  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  licenceNumber         String?
  pfRegistration        String?
  esicRegistration      String?
  bocwRegistration      String?
  insurancePolicyNumber String?

  /// Derived, never set directly by a caller. Recomputed from the most recently
  /// concluded month's MonthlyCompliance row on every compliance change (FR-005),
  /// and persisted so the contractor list can filter on it without recomputing per
  /// row. Defaults to non_compliant: a contractor with no filing history has not
  /// demonstrated compliance, and defaulting the other way would read as a clean
  /// record.
  complianceStatus ContractorComplianceStatus @default(non_compliant)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents  ContractorDocument[]
  compliance MonthlyCompliance[]

  @@unique([companyId, vendorId])
  @@index([companyId])
  @@schema("partners")
}

enum ContractorDocumentType {
  labour_license
  pf_registration
  esic_registration
  insurance
  bocw_registration

  @@schema("partners")
}

model ContractorDocument {
  id String @id @default(cuid())

  contractorProfileId String
  contractorProfile   ContractorProfile @relation(fields: [contractorProfileId], references: [id], onDelete: Cascade)

  documentType ContractorDocumentType
  /// Object-storage key, never a public URL — resolved to a short-lived signed URL at
  /// read time, the same treatment employee documents get.
  fileRef      String
  fileName     String?
  /// Statutory registrations expire. `expiryWarning` is derived at read time rather
  /// than stored, because a stored flag is wrong the day after it is written.
  expiresAt    DateTime?              @db.Date

  uploadedByUserId String
  uploadedAt       DateTime @default(now())

  @@index([contractorProfileId])
  @@schema("partners")
}

enum MonthlyComplianceStatus {
  missing
  partial
  submitted
  verified

  @@schema("partners")
}

/// One contractor's PF/ESIC filing for one month.
model MonthlyCompliance {
  id String @id @default(cuid())

  companyId           String
  contractorProfileId String
  contractorProfile   ContractorProfile @relation(fields: [contractorProfileId], references: [id], onDelete: Cascade)

  /// `YYYY-MM`. A string rather than a date because the row is about a month, and a
  /// date would invite a spurious day component that every consumer must then ignore.
  month String

  pfChallanNumber String?
  pfAmount        Decimal?  @db.Decimal(12, 2)
  pfDate          DateTime? @db.Date

  esicChallanNumber String?
  esicAmount        Decimal?  @db.Decimal(12, 2)
  esicDate          DateTime? @db.Date

  /// Auto-derived from which challans are present (FR-006), except `verified`, which
  /// only the explicit verify endpoint sets.
  status MonthlyComplianceStatus @default(missing)

  verifiedByUserId String?
  verifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractorProfileId, month])
  @@index([companyId, month])
  @@schema("partners")
}

/// A cess payment against a project. Liability, total paid and balance are computed
/// on demand rather than stored (research.md §5) — a stored balance is a second
/// source of truth that drifts the moment a payment is corrected.
model BOCWPayment {
  id String @id @default(cuid())

  companyId String
  /// Cross-schema reference to `projects.Project`, stored as a plain UUID and
  /// resolved through ProjectsService. Feature 008 owns that table and has not been
  /// built, so today this is validated only for presence.
  projectId String

  amountPaid      Decimal  @db.Decimal(14, 2)
  paymentDate     DateTime @db.Date
  referenceNumber String
  remarks         String?

  recordedByUserId String
  createdAt        DateTime @default(now())

  @@index([companyId, projectId])
  @@schema("partners")
}

// ────────────────────────────────────────────────────────────────────────────
// Feature 004 — cross-module reminders engine (spec FR-028 to FR-035).
//
// These live in `shared` for the same reason `AuditLogEntry` does: a reminder is not
// a machinery record or an asset record, it is the cross-cutting statement "something
// owned by *some* module falls due on this date". The rows below therefore reference
// their subject by (`sourceModule`, `entityType`, `entityId`) rather than by a foreign
// key — a real FK would have to point at a different schema per rule, which is exactly
// the cross-schema coupling Principle I exists to prevent. The owning module resolves
// its own ids through its own exported service.
//
// `sourceModule` and `entityType` are plain strings, not enums, deliberately: FR-028
// requires a module to contribute a new reminder type *without editing this feature*,
// and an enum would make every new rule a migration in a file this feature owns.
// ────────────────────────────────────────────────────────────────────────────

/// The severity band a reminder currently sits in (spec FR-030). A band, not a score:
/// de-duplication (FR-032) keys off it, so it has to be a small closed set.
enum ReminderSeverity {
  info
  warning
  overdue

  @@schema("shared")
}

/// The persisted catalogue of registered reminder rules.
///
/// The rule's *logic* lives in code — a `ReminderRuleProvider` in the owning module
/// (src/dashboard/reminders/reminder-rule.types.ts), which is what makes FR-028's
/// "no edit to this feature" guarantee possible. This table is the mirror of those
/// declarations, synced on boot by `ReminderRuleRegistry`, and it earns its place by
/// giving an operator one queryable list of what the engine will evaluate and an
/// `enabled` flag that silences a misbehaving rule without a deploy.
model ReminderRule {
  id String @id @default(cuid())

  /// Stable identity, chosen by the registering module: `machinery-service-due`.
  /// Unique across the installation — it is half of a reminder's composite id.
  ruleKey String @unique

  /// Which module owns the rule and resolves its entities: `machinery`, `settings`.
  sourceModule String
  /// The reminder family, for the list's type filter: `document_expiry`.
  type         String
  /// What the rule evaluates over, e.g. `EQUIPMENT_DOCUMENT`. Free text for the
  /// reason given above the enum block.
  entityType   String

  /// How far ahead of the due date the rule starts producing reminders (FR-029).
  leadDays       Int
  /// The severity ladder (FR-029), stored as `{ warnWithinDays: number }`. JSON
  /// rather than a column so a future ladder with more bands does not need a
  /// migration in this feature.
  severityLadder Json

  /// Set false to stop evaluating the rule without removing its provider.
  enabled Boolean @default(true)

  /// NULL means the declaration applies to every company — which is the normal case,
  /// since rules are declared in code. A non-null value scopes an override to one
  /// company; the RLS policy admits both.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snoozes       ReminderSnooze[]
  notifications ReminderNotification[]

  @@index([sourceModule])
  @@index([companyId])
  @@schema("shared")
}

/// A suppression of one reminder until a date (spec FR-034).
///
/// Keyed by (rule, entity) rather than by a reminder id, because a reminder is
/// computed and has no stored row — the pair is what actually persists between
/// evaluations.
model ReminderSnooze {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ruleKey String
  rule    ReminderRule @relation(fields: [ruleKey], references: [ruleKey], onDelete: Cascade)

  entityType String
  entityId   String

  /// Inclusive: the reminder reappears the day *after* this date. Stored as a date,
  /// not a timestamp — "snoozed until the 14th" is a calendar statement, and a
  /// timestamp would make it mean something different in every timezone.
  snoozeUntil DateTime @db.Date
  reason      String

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([companyId, ruleKey, entityId])
  @@index([snoozeUntil])
  @@schema("shared")
}

/// The emitted-notification ledger — what makes FR-032/FR-033 possible.
///
/// DELIBERATE ADDITION beyond the spec's Key Entities list, which names only
/// ReminderRule, Reminder (computed) and ReminderSnooze. FR-032 requires "at most one
/// notification per entity, per rule, per severity band" with escalation emitting
/// anew, and FR-033 requires a resolved reminder's open notification to be *closed*.
/// Both are statements about what was emitted before, and nothing stateless can
/// answer them: recomputing the list from scratch can tell you a reminder exists, but
/// never whether it has already been announced. See specs/004-dashboard-backend/
/// tasks.md, the 2026-09-03 implementation note.
model ReminderNotification {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ruleKey String
  rule    ReminderRule @relation(fields: [ruleKey], references: [ruleKey], onDelete: Cascade)

  entityType String
  entityId   String
  /// Copied at emission time so a closed notification still reads sensibly after the
  /// underlying record is renamed or deleted.
  subject    String
  dueDate    DateTime @db.Date

  severity ReminderSeverity

  emittedAt   DateTime  @default(now())
  /// Null while open. Set when the condition is resolved (FR-033), when the reminder
  /// escalates out of this band (FR-032), or when it is snoozed (FR-034).
  closedAt    DateTime?
  /// Why it closed, for the audit trail a bare timestamp cannot give: `resolved`,
  /// `escalated`, `snoozed`.
  closeReason String?

  @@index([companyId, ruleKey, entityId])
  @@index([companyId, closedAt])
  @@schema("shared")
}

// ============================================================================
// shared schema — feature 016's approval spine.
//
// Five tables that together say: *this record moves through named people in a fixed
// order, everyone can see who acted, and somebody has the last word.*
//
// They live in `shared` because an approval chain spans seven modules — hr
// (attendance), payroll (runs), inventory (indents), labour (muster rolls, payment
// sheets), projects (RA bills), plant (hire bills) and recruitment. A table holding a
// real relation to any one of those would belong to that module, and seven of them
// would be seven Principle I violations.
//
// THE ABSENCE OF A FOREIGN KEY TO THE GOVERNED ITEM IS THE DESIGN. `ApprovalInstance`
// names its item as an opaque `(entityType, entityId)` pair, and the spine never
// dereferences it — doing so would be the cross-schema query this shape exists to
// avoid. Modules reach the spine through the exported `ApprovalService`; the spine
// reaches nobody, and knows nothing about an item beyond what its owning module hands
// over at submit time (research.md §1, contracts/approval-service.md).
//
// The cost, put here so a future reader meets it rather than discovers it: there is no
// referential integrity. A hard-deleted item leaves an instance pointing at nothing.
// Three things carry that — modules soft-delete already, `abandon()` closes a chain
// explicitly when an item is cancelled, and a reconciliation sweep reports orphans.
// ============================================================================

/// Where an item has got to.
///
/// **Terminal** is `approved`, `rejected` and `abandoned`. `returned` is *not* terminal:
/// the item is waiting on its originator to correct and resubmit it, and it still holds
/// the item's one live chain slot. Treating it as closed would let a module submit a
/// second instance for an item that is already mid-correction, which is the double-
/// approval the "one live chain per item" index exists to prevent.
enum ApprovalState {
  pending
  approved
  rejected
  returned
  abandoned

  @@schema("shared")
}

/// The three things a person at a level can do. `reject` stops the chain; `return`
/// sends it back to the originator, who may resubmit into a fresh round.
enum ApprovalDecisionAction {
  approve
  reject
  return

  @@schema("shared")
}

/// The ordered shape of authority for one kind of action, in one company.
///
/// Per company rather than global because the client runs two companies that may staff
/// the same chain shape differently — which is also why a level names a *slot* and not
/// a role (research.md §2).
model ApprovalChain {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The key a module passes to `submit()` to find its chain: `attendance_exception`,
  /// `payroll_run`. Free text rather than an enum because the set grows as modules
  /// migrate, and an enum would put a migration in the path of every migration.
  actionType String

  /// Whether the last level is the Super Admin gate regardless of its slot (FR-018).
  isFinalAuthorityRequired Boolean @default(false)

  /// Set false to stop accepting new items into this chain. Items already in flight
  /// continue under it — an in-flight item keeps the chain it entered, so a
  /// configuration change cannot retroactively invalidate approvals already given.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levels    ApprovalLevel[]
  instances ApprovalInstance[]

  /// One *active* chain per action type per company is a partial unique index
  /// (`WHERE "isActive"`), hand-authored in the migration — Prisma cannot express a
  /// predicate. This plain index is what the lookup in `submit()` actually rides on.
  @@index([companyId, actionType])
  @@schema("shared")
}

/// One step of a chain.
model ApprovalLevel {
  id String @id @default(cuid())

  chainId String
  chain   ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  /// Denormalised from the chain so this table carries the same
  /// `"companyId" = current_setting(...)` RLS policy as every other company-scoped
  /// table in the database. The alternative — a policy reaching through `chainId` with
  /// a subquery — would be the only policy of its shape in eleven schemas, and the one
  /// a future table would copy wrongly. Write-once, set in the same transaction as the
  /// chain it belongs to, and no code path moves a chain between companies.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// 1-based and contiguous. `ApprovalInstance.currentPosition` indexes into these.
  position Int

  /// The slot authorised to act — `first_approver`, `hr`, `final` — resolved to an
  /// actual role per company through `RoleSlotMapping`. A level that named a role
  /// would hardcode one org chart into the chain definition; a slot describes the
  /// *shape* of authority and lets settings supply the people (research.md §2).
  slotKey String

  /// This level is the Director gate.
  isFinalAuthority Boolean @default(false)

  /// Human label for the level, shown by the interface (FR-010). Null falls back to
  /// the canonical slot-key label in `approval-slots.ts`; the column exists so a
  /// company defining a slot outside that set still gets a legible label instead of a
  /// raw key.
  label String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `(chainId, slotKey)` is the first half of the unsatisfiable-chain guard
  /// (FR-021b): one slot may not appear twice in a chain. The second half — two
  /// *different* slots mapping to the same role — cannot be a constraint at all and is
  /// checked when the mapping is written (`ChainsService.putSlotMapping`).
  @@unique([chainId, position])
  @@unique([chainId, slotKey])
  @@index([companyId])
  @@schema("shared")
}

/// Binds a slot to one of a company's own roles. The table that lets two companies
/// staff the same chain shape differently.
/// Whether one action type needs the Director's final approval, per company
/// (016 FR-018a, FR-018b, FR-018c).
///
/// **Why this is a table and not configuration.** It used to be
/// `APPROVALS_DIRECTOR_FINAL_ACTIONS`, an environment variable read once at construction.
/// That satisfied "configurable without a code change" only in its weakest sense: it needed
/// a redeploy, it was global across both of the client's companies, and it was unauditable —
/// so FR-018b's requirement to record "the set before and after" had nowhere to live, and
/// FR-018c's requirement to report the set had nothing to report from.
///
/// The config list survives as the **seed** for a company's first rows and as the fallback
/// for an action type nobody has configured yet. Keeping it as the fallback matters: an
/// action type registered by a later feature must have a defined answer before anybody
/// configures it, and the safe answer is the one the client already accepted.
model DirectorFinalAction {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The chain action type, matching `ApprovalChain.actionType`. A free-text column rather
  /// than an enum for the same reason `slotKey` is: a feature that adds an action type must
  /// not need a migration of this table to describe it.
  actionType String

  isFinal Boolean

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([companyId, actionType])
  @@index([companyId])
  @@schema("shared")
}

/// A proposed change to the director-final set, awaiting the Director (016 FR-018b).
///
/// Exists for the same reason `hr.PendingAttendanceCorrection` does: `ApprovalInstance`
/// carries no payload by design, so a change's before and after have to live in a table the
/// owning module controls. Here the owning module is the spine itself, which is why this row
/// sits in `shared` beside it — the spine is allowed to know about its own settings.
///
/// `before` and `after` are maps of actionType to boolean. `before` is captured at submission
/// rather than derived at apply time: the point of recording it is what the set looked like
/// when somebody decided to change it, and re-deriving it later would show what it looked
/// like after whatever else happened in between.
model DirectorFinalChangeProposal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Not a relation: kept as a bare id so this row survives its instance being pruned, and
  /// so the proposal can be read without joining the spine's own tables.
  approvalInstanceId String @unique

  proposedBy String
  before     Json
  after      Json

  appliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, appliedAt])
  @@schema("shared")
}

model RoleSlotMapping {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  slotKey String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slotKey])
  @@index([companyId])
  @@schema("shared")
}

/// One item travelling one chain. The opaque reference to the governed item lives here.
model ApprovalInstance {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  chainId String
  chain   ApprovalChain @relation(fields: [chainId], references: [id])

  /// What kind of thing this is — `attendance_exception`, `payroll_run`.
  /// **Deliberately not a foreign key, and deliberately not an enum**: the spine must
  /// not know the set of things it governs (research.md §1).
  entityType String
  /// The item's id in its own module's schema. **No foreign key** — see the block
  /// comment above this model group. This is the single most important absence in the
  /// feature, and it is intentional.
  entityId   String

  /// Copied from the owning module at submit time, because the spine cannot read the
  /// item to build it. This is the practical cost of the opacity above, and it is paid
  /// here: a queue row has to say what it is about.
  subject String
  /// Where the interface should send a reviewer to see the item itself. Supplied by
  /// the owning module for the same reason.
  href    String?

  /// The permission a caller must hold to read this item's approval history (FR-009,
  /// US3 scenario 4).
  ///
  /// Also module-supplied, and for the third time the same reason: the spine cannot
  /// dereference `entityId`, so it cannot ask the owning module whether this caller may
  /// see the item. Storing the answer as data at submit time is the only way the spine
  /// can enforce a rule it has no way to compute — and it is a *declaration*, not a
  /// callback, so Principle I and research.md §1 both hold.
  ///
  /// Deliberately coarse. It is the permission that guards the module's own screen for
  /// this kind of item, so it cannot express "this site's exceptions only". What it does
  /// express is the rule the spec actually states, and it is strictly tighter than the
  /// alternative of letting every authenticated colleague read the reasons people gave
  /// for rejecting each other's work.
  viewPermission Permission

  /// Which level it awaits. Meaningless once `state` is terminal.
  currentPosition Int @default(1)

  state ApprovalState @default(pending)

  /// Who raised it. **Null for an item raised by the system** — the monthly payroll
  /// schedule has no person behind it, and this is a real foreign key, so attributing a
  /// scheduled run to a fabricated or arbitrary account would be a lie in the audit
  /// trail. Same reasoning as `AuditLogEntry.accountId`, which is nullable for the same
  /// class of event.
  originatorUserId String?
  originator       User?   @relation("ApprovalOriginator", fields: [originatorUserId], references: [id])

  /// Which round of the chain this is. Incremented when a returned item is
  /// resubmitted, and part of both decision uniques below — without it, resubmission
  /// would collide with the decisions of the round that was returned (FR-005, FR-020).
  round Int @default(1)

  /// Times this item has been returned and resubmitted (FR-020). Surfaced so a chain
  /// cannot be worn down by repetition without leaving a trace.
  returnCount Int @default(0)

  /// A one-off grant of authority at the CURRENT level to one named person (FR-019).
  ///
  /// Reassignment needs storage because authority in this model comes from holding a
  /// role, not from being assigned a task — so "reassign to another holder of the same
  /// level" would otherwise be a no-op, since every holder can already act. The case it
  /// actually exists for is the stall FR-021a creates: the sole holder of a level's role
  /// has already decided earlier in the chain, so *nobody* can act, and the item is
  /// stuck with no error anywhere.
  ///
  /// Cleared whenever the item advances, is returned or terminates — a grant is for one
  /// level, not for the rest of the chain. It does NOT bypass FR-021a: a delegate who has
  /// already decided this round is still refused, by the unique index on
  /// `ApprovalDecision`, so this cannot be used to launder a second decision.
  delegatedToUserId String?
  delegatedTo       User?   @relation("ApprovalDelegate", fields: [delegatedToUserId], references: [id])
  /// Why the grant was made. Required by the service — an unexplained reassignment of an
  /// approval is exactly the kind of act an audit trail exists to explain.
  delegationReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decisions ApprovalDecision[]

  /// "One live chain per item" is a partial unique index on `(entityType, entityId)`
  /// WHERE the state is non-terminal, hand-authored in the migration. It is what stops
  /// a double-submit creating two parallel approvals of the same thing, and it has to
  /// be partial so that a rejected item can be raised again later.
  ///
  /// This composite index serves the approval queue, which is the hottest read in the
  /// feature.
  @@index([companyId, state, currentPosition])
  @@index([entityType, entityId])
  @@schema("shared")
}

/// One recorded act by one person at one level. Immutable once written.
model ApprovalDecision {
  id String @id @default(cuid())

  approvalInstanceId String
  approvalInstance   ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)

  /// Denormalised from the instance so this table carries the same
  /// `"companyId" = current_setting(...)` RLS policy as every other company-scoped
  /// table in the database, instead of the one policy in the schema that needs a
  /// subquery to evaluate. Write-once and set inside the same transaction as the row
  /// it is copied from, so it cannot drift. (Same reasoning as
  /// `labour.GangMember.isActive`, denormalised so an index need not join.)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The round of the chain this decision belongs to, copied from the instance.
  round Int @default(1)

  /// The level decided at.
  position Int

  actorUserId String
  actor       User   @relation("ApprovalActor", fields: [actorUserId], references: [id])

  action ApprovalDecisionAction

  /// Required for `reject` and `return` (FR-006). Enforced at the service boundary,
  /// which returns `APPROVAL_REASON_REQUIRED` rather than letting a NOT NULL surface
  /// as a database error.
  reason String?

  decidedAt DateTime @default(now())

  /// The two constraints that make FR-021 and FR-021a true under a race rather than
  /// only under a single-threaded test.
  ///
  /// `(instance, round, actorUserId)` is FR-021a: one person, one decision per round,
  /// whatever roles they hold. Super Admin holds every permission, so this is the
  /// common case and not an edge case.
  ///
  /// `(instance, round, position)` is FR-021: two approvers at the same level cannot
  /// both record. Exactly one wins.
  ///
  /// Both are scoped by `round` because a returned item restarts from position 1 and
  /// the same people must decide again — the round is what makes "again" legitimate
  /// while keeping "twice" impossible.
  @@unique([approvalInstanceId, round, actorUserId])
  @@unique([approvalInstanceId, round, position])
  @@index([companyId])
  @@schema("shared")
}

// ============================================================================
// settings schema — feature 009's two reference-data masters.
//
// Items and their categories are `settings`-schema masters, not `inventory`-owned
// tables (research.md §1): they are company reference data of the same kind as
// vendor categories and document types, edited under the SETTINGS permission, and
// read by more than one module. `InventoryModule` reaches them through
// `ItemsService`/`ItemCategoriesService` rather than querying across the schema
// boundary, which is what Principle I actually forbids.
// ============================================================================

/// The eight units the master PRD names (FR-018). A closed enum rather than free
/// text because stock arithmetic sums quantities: "20 BAG" and "20 bags" have to be
/// the same thing or the balance is a fiction.
enum ItemUnit {
  BAG
  CUM
  KG
  NOS
  MT
  LTR
  RMT
  SQM

  @@schema("settings")
}

model ItemCategory {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Stored uppercase (FR-016's spec text) so "Cement" and "CEMENT" cannot coexist
  /// as two categories with the same meaning.
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

model Item {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Allocated from the company's ITEMS series: `{shortCode}-ITM-0001`.
  code String
  name String

  categoryId String
  category   ItemCategory @relation(fields: [categoryId], references: [id])

  unit ItemUnit

  /// The per-item stock floor (FR-017). Nullable because most items never need one,
  /// and a default of 0 would claim every item is exactly at its threshold. Compared
  /// against computed `inStock` at read time — `belowReorderLevel` is never stored
  /// (research.md §12).
  reorderLevel Decimal? @db.Decimal(18, 3)
  /// HS code for GST returns (FR-017). Free text: the schedule changes, and an enum
  /// would make every rate revision a migration.
  hsnCode      String?

  description String?

  /// Soft-retired rather than deleted once stock history exists, so a purchase from
  /// two years ago still resolves its item name.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, categoryId])
  @@schema("settings")
}

// ============================================================================
// inventory schema — feature 009 (stock, purchases, issues, transfers, payments,
// material indents).
//
// `companyId` is a plain column on every table here with no relation to
// `settings.Company`, and `itemId`/`siteId`/`vendorId` are plain columns too — the
// same rule `partners.Vendor` follows. Principle I routes every cross-module read
// through the owning module's exported service, and a declared relation is exactly
// what would make an accidental cross-schema join possible. RLS is what scopes
// these rows; the relations that do exist below are all within this schema.
// ============================================================================

/// Every movement that can change a balance, including the reversals soft-deletion
/// appends (FR-004). The ledger is append-only: a mistake is corrected by writing
/// its opposite, never by editing or removing the original.
enum StockLedgerType {
  purchase
  purchase_reversal
  issue
  issue_reversal
  transfer_in
  transfer_out
  transfer_in_reversal
  transfer_out_reversal

  @@schema("inventory")
}

enum PurchaseBillStatus {
  unpaid
  part_paid
  paid

  @@schema("inventory")
}

enum PaymentMode {
  upi
  bank_transfer
  cash
  cheque

  @@schema("inventory")
}

enum TransferStatus {
  pending
  in_transit
  received

  @@schema("inventory")
}

enum IndentStatus {
  draft
  submitted
  approved
  rejected
  partially_fulfilled
  fulfilled
  cancelled

  @@schema("inventory")
}

/// Running totals per item per site, updated inside the same transaction as the
/// ledger write (FR-002). The ledger is the record of truth; this is the O(1) read
/// of it, and `StockService.recomputeWAR()` can rebuild `avgRate` from the ledger
/// whenever a purchase is reversed.
model StockBalance {
  id String @id @default(cuid())

  companyId String
  itemId    String
  siteId    String

  received    Decimal @default(0) @db.Decimal(18, 3)
  issued      Decimal @default(0) @db.Decimal(18, 3)
  transferIn  Decimal @default(0) @db.Decimal(18, 3)
  transferOut Decimal @default(0) @db.Decimal(18, 3)

  /// Weighted average rate. Six decimal places rather than the two money elsewhere
  /// carries: this is a computed average, not a transacted amount, and rounding it
  /// to paise on every purchase would drift the stock valuation of a
  /// frequently-received item measurably over a year.
  avgRate Decimal @default(0) @db.Decimal(18, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `inStock` and `stockValue` are deliberately absent — both are derived on read
  /// (FR-014, research.md §11). A stored total is a second place for the truth to
  /// live, and the one that goes stale.
  @@unique([itemId, siteId])
  @@index([companyId])
  @@index([companyId, siteId])
  @@schema("inventory")
}

/// Append-only. No update or delete path exists in the service layer, and the
/// absence of an `updatedAt` here is deliberate — a row that can be amended is not
/// a ledger.
model StockLedgerEntry {
  id String @id @default(cuid())

  companyId String
  itemId    String
  siteId    String

  type     StockLedgerType
  quantity Decimal         @db.Decimal(18, 3)
  /// Populated for `purchase`/`purchase_reversal` only: an issue consumes at the
  /// running average, so recording a rate against it would invent a number.
  rate     Decimal?        @db.Decimal(18, 2)

  /// The Purchase, Issue or StockTransfer this entry came from. A plain column: the
  /// three possible parents make a Prisma relation impossible to declare, and the
  /// reversal pairs are found by this id.
  referenceId String
  date        DateTime @db.Date

  createdAt DateTime @default(now())

  @@index([companyId, itemId, siteId])
  @@index([referenceId])
  @@schema("inventory")
}

model Purchase {
  id String @id @default(cuid())

  companyId String
  siteId    String
  itemId    String
  vendorId  String

  date     DateTime @db.Date
  quantity Decimal  @db.Decimal(18, 3)
  rate     Decimal  @db.Decimal(18, 2)
  /// Stored rather than derived: `quantity × rate` rounded once at write time is
  /// what the vendor billed, and recomputing it on every read would let a rounding
  /// change silently restate historical spend.
  amount   Decimal  @db.Decimal(18, 2)

  /// Object-storage reference for the uploaded bill, same encrypted-reference
  /// pattern as `EmployeeDocument`/`ProjectDocument`.
  billFileRef String?
  remarks     String?

  /// The indent line this purchase fulfils, if it came from one (FR-023).
  indentLineId String?
  indentLine   MaterialIndentLine? @relation(fields: [indentLineId], references: [id])

  deleted   Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill PurchaseBill?
  grn  GoodsReceiptNote?

  @@index([companyId])
  @@index([companyId, siteId])
  @@index([companyId, vendorId])
  @@index([companyId, itemId, siteId])
  @@index([indentLineId])
  @@schema("inventory")
}

/// Auto-created 1:1 with every purchase (FR-020). Separate from `PurchaseBill`
/// because they answer different questions: a GRN records that material physically
/// arrived, a bill records that money is owed for it.
model GoodsReceiptNote {
  id String @id @default(cuid())

  companyId String

  purchaseId String   @unique
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  /// `{shortCode}-GRN-0001`, allocated from the purchase's own sequence at creation.
  grnNumber String
  siteId    String

  createdAt DateTime @default(now())

  @@unique([companyId, grnNumber])
  @@index([companyId])
  @@schema("inventory")
}

model PurchaseBill {
  id String @id @default(cuid())

  companyId String

  purchaseId String   @unique
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  vendorId String

  totalAmount   Decimal            @db.Decimal(18, 2)
  paidAmount    Decimal            @default(0) @db.Decimal(18, 2)
  /// Derived from the two amounts above and rewritten in the same transaction that
  /// moves `paidAmount` — stored so the FIFO query can filter on it without
  /// recomputing every bill's status to find the unpaid ones.
  paymentStatus PurchaseBillStatus @default(unpaid)

  /// The bill's own date drives FIFO order (FR-005), copied from the purchase so
  /// allocation never has to join back to it.
  billDate DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]

  @@index([companyId])
  @@index([companyId, vendorId, paymentStatus, billDate])
  @@schema("inventory")
}

model Issue {
  id String @id @default(cuid())

  companyId String
  siteId    String
  itemId    String

  date     DateTime @db.Date
  quantity Decimal  @db.Decimal(18, 3)
  issuedTo String

  /// What the material was consumed for (FR-019). Both optional: the link is
  /// recorded when the site's project has BOQ or activity data to point at, and
  /// requiring one would make material un-issuable at a project whose BOQ has not
  /// been loaded yet. Validated against `ProjectsService` when supplied.
  activityId String?
  boqItemId  String?

  remarks String?

  /// The indent line this issue fulfils, if it came from one (FR-023).
  indentLineId String?
  indentLine   MaterialIndentLine? @relation(fields: [indentLineId], references: [id])

  deleted   Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, siteId])
  @@index([companyId, itemId, siteId])
  @@index([indentLineId])
  @@schema("inventory")
}

model StockTransfer {
  id String @id @default(cuid())

  companyId  String
  fromSiteId String
  toSiteId   String
  itemId     String

  date     DateTime @db.Date
  quantity Decimal  @db.Decimal(18, 3)
  remarks  String?

  /// Physical-movement tracking only. Both balances move at creation regardless of
  /// this value: the material has left the source store the moment the transfer is
  /// recorded, and holding the decrement until "received" would let the same units
  /// be issued twice.
  status TransferStatus @default(pending)

  deleted   Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, fromSiteId])
  @@index([companyId, toSiteId])
  @@schema("inventory")
}

model Payment {
  id String @id @default(cuid())

  companyId String
  vendorId  String

  amount Decimal  @db.Decimal(18, 2)
  date   DateTime @db.Date

  paymentMode     PaymentMode
  referenceNumber String

  /// How much of `amount` reached bills. Stored because FIFO allocation writes it in
  /// the same transaction as the `PaymentAllocation` rows; `unallocatedBalance` is
  /// `amount − allocatedAmount`, derived on read.
  allocatedAmount Decimal @default(0) @db.Decimal(18, 2)

  /// The RTGS advice or transaction confirmation, through `StorageService` (017 US7,
  /// FR-020). Nullable because a payment is recorded when the money moves and the
  /// advice often arrives afterwards — refusing the payment until the proof exists
  /// would push people to record it somewhere else.
  ///
  /// `referenceNumber` above is a number somebody typed. This is the document behind
  /// it, which is the whole of what US7 closes.
  proofRef        String?
  proofUploadedAt DateTime?

  deleted   Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]

  @@index([companyId])
  @@index([companyId, vendorId])
  /// FR-021: which payments lack a proof, answered by an index rather than by reading
  /// every payment a company ever made.
  @@index([companyId, proofRef])
  @@schema("inventory")
}

/// Which bill received how much from which payment (FR-006). The join row is what
/// makes a payment reversible: deleting a payment walks these and gives each bill
/// its amount back.
model PaymentAllocation {
  id String @id @default(cuid())

  companyId String

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  billId String
  bill   PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  allocatedAmount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, billId])
  @@index([companyId])
  @@index([billId])
  @@schema("inventory")
}

/// A site's request for material (FR-021). Approving one records intent; it does
/// not touch any balance (FR-025) — issue-time validation stays the single point of
/// stock enforcement, which is what keeps this amendment unable to produce a
/// negative balance.
model MaterialIndent {
  id String @id @default(cuid())

  companyId String
  siteId    String
  /// Denormalised from the site so the indent list can filter by project without
  /// asking ProjectsService per row. Nullable: a site need not belong to a project.
  projectId String?

  /// `{shortCode}-IND-0001`.
  indentNumber String

  requiredByDate DateTime @db.Date
  justification  String

  status IndentStatus @default(submitted)

  requestedByUserId String
  approvedByUserId  String?
  approvedAt        DateTime?
  /// Set when an approver rejects or cancels; both require a reason (FR-026).
  decisionReason    String?

  deleted   Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines MaterialIndentLine[]

  @@unique([companyId, indentNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, siteId])
  @@schema("inventory")
}

model MaterialIndentLine {
  id String @id @default(cuid())

  companyId String

  indentId String
  indent   MaterialIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  itemId String

  /// All three quantities are kept, never collapsed (FR-022): the reduction an
  /// approver made is only auditable while the requested figure survives beside the
  /// approved one. Outstanding is `approved − fulfilled`, derived on read.
  requestedQuantity Decimal  @db.Decimal(18, 3)
  approvedQuantity  Decimal? @db.Decimal(18, 3)
  fulfilledQuantity Decimal  @default(0) @db.Decimal(18, 3)
  /// Why the approved quantity is below the requested one (FR-022).
  reductionReason   String?

  activityId String?
  boqItemId  String?

  /// Set by `mark-procurement-needed`: this line cannot be met from stock and needs
  /// buying (FR-027).
  procurementPending Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues    Issue[]
  purchases Purchase[]

  @@index([companyId])
  @@index([indentId])
  @@index([companyId, itemId])
  @@schema("inventory")
}

// ============================================================================
// Machinery masters — feature 006, `settings` schema (research.md §1, §10).
//
// These three are reference data of the same kind as vendor and item categories:
// per-company, edited under `SETTINGS`, and consumed by `plant` through
// `SettingsModule`'s exported services rather than a cross-schema join. Master PRD
// §7.8.5 lists them as a Settings subsection, which is what settled the placement.
// ============================================================================

/// What an equipment's meter counts. Declared once, in `settings`, and referenced by
/// `plant.Equipment` too — the alternative is two identically-named enums, which
/// Prisma forbids, or a free-text column, which would let a category and its own
/// machines disagree about what their readings mean.
enum MeterType {
  hours
  km

  @@schema("settings")
}

model EquipmentCategory {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Stored uppercase, like `ItemCategory.name`, so "Excavator" and "EXCAVATOR"
  /// cannot coexist as two categories meaning the same thing.
  name String

  meterType MeterType

  /// Expected consumption per meter unit (litres/hour or litres/km). Nullable
  /// because an electric or manual category has none, and 0 would read as a
  /// benchmark of zero rather than as its absence.
  fuelBenchmark                Decimal? @db.Decimal(18, 3)
  /// How far past the benchmark a fuel entry may sit before it is flagged (FR-004).
  /// Per category and stored, never the hardcoded `> 15` the original spec carried:
  /// a tower crane and a tipper do not deserve the same tolerance.
  fuelVarianceThresholdPercent Decimal  @default(15) @db.Decimal(6, 2)
  /// Denominator for utilisation % (FR-007). 176 = 22 working days × 8 hours.
  targetHoursPerMonth          Int      @default(176)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hireRates HireRate[]

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

model EquipmentDocType {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  /// How many days before expiry a document of this type starts flagging
  /// `expiryAlert` (FR-010). Per type and stored, never the hardcoded 30-day literal
  /// the original spec carried: an insurance policy and a pollution certificate are
  /// not renewed on the same notice.
  alertDays Int @default(30)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

/// An effective-dated hire rate per category (FR-014).
///
/// Non-overlapping by construction: creating a new open-ended rate closes the prior
/// current one's `effectiveTo` to the day before. That invariant is what lets a hire
/// bill raised last March still resolve last March's rate after this year's revision
/// lands (SC-006) — a single mutable "current rate" column could not.
model HireRate {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categoryId String
  category   EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  ratePerUnit Decimal @db.Decimal(18, 2)

  effectiveFrom DateTime  @db.Date
  /// Null means "current" — the open end of the history.
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, categoryId, effectiveFrom])
  @@schema("settings")
}

// ============================================================================
// plant schema — feature 006 (asset register, logbook, fuel, service schedules,
// maintenance jobs, hire bills, spare parts and service bills).
//
// `companyId` is a plain column with no relation to `settings.Company`, and
// `categoryId`, `docTypeId`, `vendorId`, `deployedSiteId`, `operatorId`, `projectId`
// and `linkedInventoryItemId` are plain columns too — the same rule `inventory` and
// `partners` follow. Principle I routes every cross-module read through the owning
// module's exported service, and a declared relation is exactly what would make an
// accidental cross-schema join possible. RLS is what scopes these rows; every
// relation below stays inside this schema.
// ============================================================================

enum EquipmentOwnership {
  owned
  hired

  @@schema("plant")
}

enum PowerSource {
  diesel
  petrol
  electric
  manual

  @@schema("plant")
}

/// `under_maintenance` is set and cleared only by the maintenance job lifecycle
/// (FR-002) — never accepted from a PATCH. `inactive` is the manual one:
/// decommissioning is a decision, not a consequence.
enum EquipmentStatus {
  active
  under_maintenance
  inactive

  @@schema("plant")
}

enum MaintenanceType {
  breakdown
  scheduled

  @@schema("plant")
}

enum MaintenanceStatus {
  open
  closed

  @@schema("plant")
}

enum HireBillStatus {
  pending_verification
  verified
  paid

  @@schema("plant")
}

/// A spare part movement is a receipt, a consumption, or the reversal of one
/// (FR-016). Like 009's stock ledger, corrections are written as opposites rather
/// than by editing history.
enum SparePartMovementType {
  receipt
  consumption
  reversal

  @@schema("plant")
}

enum ServiceBillStatus {
  pending_verification
  verified

  @@schema("plant")
}

enum ServiceBillPaymentStatus {
  unpaid
  partially_paid
  paid

  @@schema("plant")
}

model Equipment {
  id String @id @default(cuid())

  companyId String

  /// Allocated from the company's EQUIPMENT series (`{shortCode}-EQP-0001`) when the
  /// caller does not supply one — most machines already carry a plate or asset
  /// number the yard knows them by, and overwriting it would be unhelpful.
  code String
  name String

  /// → `settings.EquipmentCategory`. Resolved via `EquipmentCategoriesService`.
  categoryId String

  ownership EquipmentOwnership
  /// → `partners.Vendor`, for hired equipment. Resolved via `PartnersService`.
  vendorId  String?

  powerSource PowerSource

  purchaseDate     DateTime? @db.Date
  purchaseCost     Decimal?  @db.Decimal(18, 2)
  /// Straight-line, % per annum. Feeds the owned half of `getMachineryCostByProject`.
  depreciationRate Decimal?  @db.Decimal(6, 2)

  /// Mirrors the category's at creation time. Copied rather than joined because a
  /// category's meter type must not silently reinterpret readings already recorded
  /// against machines under it.
  meterType      MeterType
  currentReading Decimal   @default(0) @db.Decimal(18, 3)

  /// → `projects.Site`. Resolved via `SitesService`; this is what ties a machine to
  /// a project for the P&L.
  deployedSiteId String?

  status EquipmentStatus @default(active)

  /// Stored, recomputed on every logbook write for the current month (FR-007), so a
  /// register listing 500 machines does not run 500 aggregates.
  utilizationPercent Decimal @default(0) @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents        EquipmentDocument[]
  logbookEntries   LogbookEntry[]
  fuelEntries      FuelEntry[]
  serviceSchedules ServiceSchedule[]
  maintenanceJobs  MaintenanceJob[]
  hireBills        HireBill[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, categoryId])
  @@index([companyId, deployedSiteId])
  @@index([companyId, status])
  @@schema("plant")
}

model EquipmentDocument {
  id String @id @default(cuid())

  companyId String

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  /// → `settings.EquipmentDocType`, whose `alertDays` is the alert window.
  docTypeId String

  /// Object-storage key, never a public URL — resolved to a short-lived signed URL
  /// at read time, the same treatment contractor and employee documents get.
  fileRef  String
  fileName String?
  mimeType String?

  expiresAt DateTime? @db.Date

  uploadedByUserId String
  uploadedAt       DateTime @default(now())

  @@index([companyId])
  @@index([equipmentId])
  @@schema("plant")
}

model LogbookEntry {
  id String @id @default(cuid())

  companyId String

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  openingReading Decimal @db.Decimal(18, 3)
  closingReading Decimal @db.Decimal(18, 3)
  /// Stored: `closingReading − openingReading`. Zero is legitimate (a machine that
  /// stood idle all day still gets an entry).
  totalHours     Decimal @db.Decimal(18, 3)

  fuelConsumed Decimal? @db.Decimal(18, 3)

  /// → `hr.Employee`. Resolved via `EmployeesService`.
  operatorId String?
  /// → `projects.Project`. A machine can work a project that is not its deployed
  /// site's, so this is recorded per entry rather than inferred.
  projectId  String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([equipmentId, date])
  @@index([companyId, date])
  @@index([companyId, equipmentId, date])
  @@index([companyId, projectId])
  @@schema("plant")
}

model FuelEntry {
  id String @id @default(cuid())

  companyId String

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  quantity Decimal @db.Decimal(18, 3)
  rate     Decimal @db.Decimal(18, 2)
  amount   Decimal @db.Decimal(18, 2)

  /// → `partners.Vendor` (the filling station or diesel supplier).
  vendorId String?

  /// Computed against the category's threshold at save time and stored (research.md
  /// §3): a later edit to the category's benchmark must not retroactively rewrite
  /// what was flagged, or unflag, months of history.
  variancePercent Decimal? @db.Decimal(8, 2)
  varianceAlert   Boolean  @default(false)

  /// 020 FR-001: the review raised against this reading, once somebody raises one.
  varianceException FuelVarianceException?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, date])
  @@index([companyId, equipmentId, date])
  @@schema("plant")
}

/// What a reviewer decided about a machine that burned more fuel than its benchmark
/// (020 FR-001 to FR-009).
///
/// **Detection is untouched by this table** (FR-017). `Equipment.fuelBenchmark`,
/// `FuelEntry.variancePercent` and `FuelEntry.varianceAlert` keep computing exactly as they did;
/// what is added is the review that turns an alert nobody must act on into a decision with a name
/// against it. Raising an exception is deliberately *not* done inside the detector — coupling the
/// two would mean a change to either could silently alter the other.
model FuelVarianceException {
  id        String @id @default(cuid())
  companyId String

  fuelEntryId String    @unique
  fuelEntry   FuelEntry @relation(fields: [fuelEntryId], references: [id], onDelete: Cascade)

  status FuelExceptionStatus @default(open)

  /// Who bears the cost. **Nullable, and deliberately without a default** (plan D27): a default
  /// would decide, quietly and at scale, who pays for fuel nobody can account for. It is set only
  /// when somebody confirms the exception, and `neither` is an explicit choice rather than an
  /// absence.
  attribution FuelAttribution?

  /// Required when `attribution` is `operator` and the machine had more than one in the period
  /// (FR-009). **Never inferred from the logbook** — the requirement says named explicitly, and
  /// inferring is how the wrong person's wages get docked.
  operatorEmployeeId String?

  reviewedByUserId String?
  reviewedAt       DateTime?

  /// Why. Required to dismiss (FR-008): a dismissal nobody has to justify is how an exception
  /// register becomes a list everybody clears without reading.
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 020 Phase 6. Exclusive by construction — see `FuelAttribution`.
  hireBillDeduction HireBillDeduction?
  operatorRecovery  OperatorFuelRecovery?

  @@index([companyId, status])
  @@schema("plant")
}

/// Where a reviewed fuel exception stands (020 FR-002, FR-008).
enum FuelExceptionStatus {
  /// Raised from an alert, nobody has decided yet.
  open
  /// Somebody confirmed it, and `attribution` says who bears it.
  confirmed
  /// Somebody judged it not worth pursuing, with a reason.
  dismissed

  @@schema("plant")
}

/// Fuel burned beyond benchmark, recovered from the hirer's next bill (020 FR-003, FR-004).
///
/// `netPayable` on the bill is **recomputed** from gross, TDS and the sum of deductions rather than
/// decremented in place (plan D28). A vendor disputing a bill is owed the arithmetic, and a net
/// reduced by an `UPDATE` cannot produce it.
model HireBillDeduction {
  id        String @id @default(cuid())
  companyId String

  hireBillId String
  hireBill   HireBill @relation(fields: [hireBillId], references: [id], onDelete: Cascade)

  /// One exception cannot be recovered twice from a bill. Structural, not a convention.
  fuelVarianceExceptionId String                @unique
  fuelVarianceException   FuelVarianceException @relation(fields: [fuelVarianceExceptionId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(18, 2)

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, hireBillId])
  @@schema("plant")
}

/// Fuel burned beyond benchmark, recovered from the operator's salary (020 FR-005 to FR-007, FR-010).
///
/// **No path to a payroll line except through an approved item** (FR-006). The gate is the approval
/// spine, not a check inside the payroll service — the difference is whether a second caller can
/// bypass it.
///
/// Settles through `SalaryAdvance`'s recovery machinery, which already handles instalments and a
/// recovery exceeding the month's net. It is **not** an advance, and is named as a fuel recovery on
/// the payslip: this is a recovery for loss, not money lent (FR-007).
model OperatorFuelRecovery {
  id        String @id @default(cuid())
  companyId String

  fuelVarianceExceptionId String                @unique
  fuelVarianceException   FuelVarianceException @relation(fields: [fuelVarianceExceptionId], references: [id], onDelete: Cascade)

  /// → `hr.Employee`. Not a relation: `plant` does not reach into `hr`'s schema (Principle I).
  employeeId String

  amount Decimal @db.Decimal(18, 2)

  status OperatorRecoveryStatus @default(pending_approval)

  /// The approval spine's item. Null only before submission.
  approvalItemId String?

  /// How much of `amount` has actually been deducted so far (020 FR-007b).
  ///
  /// A recovery is **not** necessarily settled in one period. FR-007a caps a payslip's *total*
  /// deductions at half its wages, so a line already carrying an advance and a loan may have room for
  /// only part of this — and the remainder carries. This column is what makes a carried balance a
  /// fact rather than an inference: the balance is `amount − recoveredAmount`, and it is visible
  /// without reconstructing it from payroll history.
  recoveredAmount Decimal @default(0) @db.Decimal(18, 2)

  /// Set when the approved recovery reaches a payroll line, and what makes application idempotent:
  /// a second `approval.completed` for the same recovery finds this already set and does nothing.
  ///
  /// The **last** line it touched, where a carried recovery touches several. The audit trail of every
  /// instalment is the payroll lines themselves, each carrying its own `fuelRecoveryDeduction`.
  appliedPayrollLineItemId String?

  reversedAt       DateTime?
  reversedByUserId String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, employeeId])
  @@schema("plant")
}

/// Where an operator fuel recovery stands (020 FR-006, FR-010).
enum OperatorRecoveryStatus {
  /// Raised and travelling the chain. **Cannot reach a payroll line in this state.**
  pending_approval
  /// Approved, not yet applied to a payroll line.
  approved
  /// Applied as a named deduction on a payroll line.
  applied
  /// Refused by the chain. Never touches a payroll line.
  rejected
  /// Undone after application, with who and when recorded (FR-010).
  reversed

  @@schema("plant")
}

/// Who bears the cost of fuel burned beyond the benchmark (020 FR-002 to FR-005).
///
/// **Exclusive.** An exception attributed to the hirer has no operator recovery and vice versa —
/// double recovery for one loss is the failure this prevents, and the `@@unique` on each
/// consequence table is what makes that structural rather than a convention somebody remembers.
enum FuelAttribution {
  /// Deducted from the hire bill. Not offered for an owned machine — there is no hirer.
  hirer
  /// Recovered from the operator's salary, through the approval chain.
  operator
  /// Shared between the hirer and the operator (FR-002).
  ///
  /// **Added 2026-10-02.** Phase 5 implemented three of the four attributions FR-002 names and this
  /// was missed; it surfaced while writing the recovery, which is the first code that had to branch
  /// on all four. Shared means the loss is *divided*, never collected twice — so an exception
  /// attributed `both` still admits exactly one recovery, and whichever destination is raised first
  /// claims it. Splitting one loss across two destinations needs a share per destination, which
  /// FR-002 does not define and this does not invent.
  both
  /// Confirmed as real and pursued against nobody. A deliberate answer, which is why it is a
  /// value here rather than a null.
  neither

  @@schema("plant")
}

model ServiceSchedule {
  id String @id @default(cuid())

  companyId String

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  serviceType String

  intervalHours Decimal? @db.Decimal(18, 3)
  intervalKm    Decimal? @db.Decimal(18, 3)

  lastDoneReading Decimal @db.Decimal(18, 3)
  /// Stored: `lastDoneReading + interval`. `status` is *not* stored — it is derived
  /// on read from the equipment's current reading (FR-006, research.md §4), because
  /// storing it would mean touching every schedule on every logbook entry.
  nextDueReading  Decimal @db.Decimal(18, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenanceJobs MaintenanceJob[]

  @@index([companyId])
  @@index([companyId, equipmentId])
  @@schema("plant")
}

model MaintenanceJob {
  id String @id @default(cuid())

  companyId String

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  type        MaintenanceType
  description String

  openedAt DateTime  @default(now())
  closedAt DateTime?

  closingReading   Decimal? @db.Decimal(18, 3)
  partsDescription String?

  /// The workshop's own labour. Distinct from `partsCost`, which accrues from spare
  /// part consumption, and from service bills, which are a third party's invoice —
  /// FR-026 requires all three to be separable.
  labourCost Decimal? @db.Decimal(18, 2)
  /// Accrued by `SparePartMovement` consumptions and reversals (FR-018), never set
  /// by a client.
  partsCost  Decimal  @default(0) @db.Decimal(18, 2)
  totalCost  Decimal? @db.Decimal(18, 2)

  linkedServiceScheduleId String?
  linkedServiceSchedule   ServiceSchedule? @relation(fields: [linkedServiceScheduleId], references: [id])

  status MaintenanceStatus @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partMovements SparePartMovement[]
  serviceBills  ServiceBill[]

  @@index([companyId, status])
  @@index([companyId, equipmentId, status])
  @@schema("plant")
}

model HireBill {
  id String @id @default(cuid())

  companyId String

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  /// → `partners.Vendor`, the hire vendor. Required: a hire bill without an owner to
  /// pay is not a hire bill.
  vendorId String

  billedHours Decimal @db.Decimal(18, 3)
  /// Defaults from the effective `settings.HireRate` for the equipment's category on
  /// `billingPeriodFrom` (FR-014), overridable per bill.
  rate        Decimal @db.Decimal(18, 2)
  grossAmount Decimal @db.Decimal(18, 2)

  billingPeriodFrom DateTime @db.Date
  billingPeriodTo   DateTime @db.Date

  /// Snapshot taken at creation, not a live join (research.md §8): the bill must
  /// stay verifiable against what the logbook said when it was raised, even if a
  /// logbook entry is corrected afterwards.
  logbookHours Decimal @db.Decimal(18, 3)
  variance     Decimal @db.Decimal(18, 3)

  /// From `PartnersService.getVendorTds()` at creation. Never client-supplied
  /// (FR-005).
  tdsRate    Decimal? @db.Decimal(6, 2)
  tdsAmount  Decimal  @default(0) @db.Decimal(18, 2)
  netPayable Decimal  @db.Decimal(18, 2)

  status HireBillStatus @default(pending_verification)

  verifiedByUserId String?
  verifiedAt       DateTime?

  paymentDate      DateTime? @db.Date
  paymentReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 020 FR-003: fuel recovered from this bill.
  fuelDeductions HireBillDeduction[]

  @@index([companyId, status])
  @@index([companyId, equipmentId])
  @@index([companyId, vendorId])
  @@schema("plant")
}

/// A workshop-stocked replacement part (FR-015).
///
/// Deliberately not a `settings.Item` (009's material master): a spare part is
/// consumed against a *machine* and costed to that machine's maintenance history,
/// where an inventory item is consumed against a BOQ activity and costed to a
/// project. Different stock location, different costing dimension, different
/// consumer. `linkedInventoryItemId` declares the overlap where one physical thing
/// is registered in both, so FR-024's reconciliation can show the divergence rather
/// than the two silently double-counting.
model SparePart {
  id String @id @default(cuid())

  companyId String

  partNumber    String
  name          String
  /// Free text rather than 009's `ItemUnit` enum: workshop parts come in units that
  /// master does not carry (sets, pairs, metres of hose), and widening a settings
  /// enum for plant's benefit would couple the two masters.
  unitOfMeasure String

  reorderLevel Decimal? @db.Decimal(18, 3)

  /// `settings.EquipmentCategory` ids this part fits. Empty means "unrestricted" —
  /// consumption against any category is fine and unflagged. A populated list that
  /// excludes the machine's category flags but never blocks (FR-020).
  compatibleCategoryIds String[]

  /// → `settings.Item` (009). Declared, never joined: the two stocks stay
  /// independent by design (FR-024).
  linkedInventoryItemId String?

  /// Running balance, updated in-transaction on every movement (FR-016) rather than
  /// summed from history on read — the same trade 009 FR-002 makes.
  stockQuantity Decimal @default(0) @db.Decimal(18, 3)
  /// Weighted average, recomputed on every receipt by 009 FR-008's formula (FR-017).
  /// Six decimal places for the same reason `StockBalance.avgRate` has them: a rate
  /// rounded to paise drifts once it is multiplied back out by a quantity.
  avgRate       Decimal @default(0) @db.Decimal(18, 6)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements SparePartMovement[]

  @@unique([companyId, partNumber])
  @@index([companyId])
  @@schema("plant")
}

model SparePartMovement {
  id String @id @default(cuid())

  companyId String

  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)

  type SparePartMovementType

  quantity Decimal @db.Decimal(18, 3)
  /// The rate in force when the movement happened. Frozen (FR-017): a later receipt
  /// moves the part's weighted average, never what an earlier consumption cost.
  rate     Decimal @db.Decimal(18, 6)
  amount   Decimal @db.Decimal(18, 2)

  movementDate DateTime @db.Date

  /// Set on consumptions and their reversals; null on receipts.
  maintenanceJobId String?
  maintenanceJob   MaintenanceJob? @relation(fields: [maintenanceJobId], references: [id])

  /// Receipt provenance.
  vendorId      String?
  billReference String?

  /// True when the part's `compatibleCategoryIds` excluded the machine's category
  /// (FR-020) or when parts were consumed on hired equipment — recorded so the cost
  /// can be recovered from the hire vendor, never enforced.
  incompatiblePart Boolean @default(false)

  /// A reversal points at the consumption it undoes.
  reversalOfId String?            @unique
  reversalOf   SparePartMovement? @relation("MovementReversal", fields: [reversalOfId], references: [id])
  reversedBy   SparePartMovement? @relation("MovementReversal")
  /// Required on a reversal (FR-019).
  reason       String?

  createdByUserId String

  /// Soft-delete only (FR-027) — stock and cost history is never hard-deleted.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId, sparePartId])
  @@index([companyId, maintenanceJobId])
  @@schema("plant")
}

/// A third-party workshop's invoice for repairing owned equipment (FR-021, FR-022).
///
/// Distinct from `HireBill`, which is a rental charge for hired equipment. The two
/// are never the same document: one is what you pay to use a machine, the other is
/// what you pay to fix one you own.
model ServiceBill {
  id String @id @default(cuid())

  companyId String

  maintenanceJobId String
  maintenanceJob   MaintenanceJob @relation(fields: [maintenanceJobId], references: [id], onDelete: Cascade)

  /// → `partners.Vendor`, the workshop.
  vendorId String

  billNumber String
  billDate   DateTime @db.Date

  grossAmount Decimal @db.Decimal(18, 2)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)

  /// Computed server-side from gross, tax and percent (FR-021); never accepted from
  /// the client, the same rule `HireBill` follows.
  tdsPercent Decimal @default(0) @db.Decimal(6, 2)
  tdsAmount  Decimal @db.Decimal(18, 2)
  netPayable Decimal @db.Decimal(18, 2)

  status ServiceBillStatus @default(pending_verification)

  verifiedByUserId String?
  verifiedAt       DateTime?

  paymentStatus    ServiceBillPaymentStatus @default(unpaid)
  paidAmount       Decimal                  @default(0) @db.Decimal(18, 2)
  paidOn           DateTime?                @db.Date
  paymentReference String?

  /// Soft-delete only (FR-027).
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, vendorId, billNumber])
  @@index([companyId, maintenanceJobId])
  @@index([companyId, vendorId])
  @@index([companyId, paymentStatus])
  @@schema("plant")
}

// ============================================================================
// labour schema — feature 013 (Labour Management: per-project wage rates, workers
// and gangs, supervisor muster capture, muster approval, cash payment sheets with
// denomination breakup and disbursement, and labour advances).
//
// Supersedes feature 005's Daily Worker registry (US9, FR-023 to FR-028), which was
// never implemented — so there is no migration of existing rows, only fresh tables.
//
// Every cross-schema reference (projectId, siteId, contractorId, skillCategoryId,
// faceEnrolmentId, supervisorId, approver ids) is stored as a bare id with no Prisma
// relation, the same rule the projects and inventory schemas follow: Principle I
// routes every cross-module read through the owning module's exported service, and a
// declared relation is precisely what would make an accidental cross-schema join
// possible. Same-schema parent/child links (muster→lines, sheet→lines, gang→members)
// are real relations.
// ============================================================================

enum EngagementType {
  direct
  contractor

  @@schema("labour")
}

enum WorkerStatus {
  active
  inactive

  @@schema("labour")
}

enum MusterSource {
  mobile
  admin_entry

  @@schema("labour")
}

enum MusterStatus {
  draft
  submitted
  approved

  @@schema("labour")
}

enum AttendanceType {
  full_day
  half_day
  absent
  overtime_only

  @@schema("labour")
}

enum RateSource {
  override
  project_rate

  @@schema("labour")
}

enum PaymentSheetStatus {
  draft
  approved
  partially_disbursed
  closed

  @@schema("labour")
}

enum LabourPaymentMode {
  cash
  bank

  @@schema("labour")
}

enum PaymentSheetLineStatus {
  pending
  disbursed
  reversed

  @@schema("labour")
}

enum AdvanceStatus {
  pending
  approved
  disbursed
  closed

  @@schema("labour")
}

/// A per-project, per-skill-category daily wage rate with a non-overlapping
/// effective-dated history (013 FR-004 to FR-007) — the same pattern 006 FR-014 uses
/// for equipment hire rates. `effectiveTo` is null for the current rate and is
/// auto-closed to the day before a newer rate's `effectiveFrom` on append.
model WageRate {
  id        String @id @default(cuid())
  companyId String

  /// → projects, resolved via ProjectsService (FR-034).
  projectId       String
  /// → settings.SkillCategory.
  skillCategoryId String

  dailyRate     Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @db.Date
  /// Null = the current open-ended rate. Set to the day before a newer rate's
  /// `effectiveFrom` when one is appended.
  effectiveTo   DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId])
  @@index([companyId, projectId, skillCategoryId, effectiveFrom])
  @@schema("labour")
}

/// A labour worker — direct (company-engaged, paid from the cash sheet) or
/// contractor-engaged (paid through a contractor from 007's vault). Supersedes 005's
/// Daily Worker. PII (`aadhaarNumber`, `bankAccount`) is masked in list responses
/// (FR-009) and unique among active workers for Aadhaar (FR-010).
model LabourWorker {
  id        String @id @default(cuid())
  companyId String

  /// Auto-generated, unique per company (e.g. LAB-0001).
  labourCode String

  fullName    String
  phone       String
  gender      String
  dateOfBirth DateTime @db.Date

  aadhaarNumber String?
  bankAccount   String?

  /// → settings.SkillCategory.
  skillCategoryId String

  engagementType EngagementType
  /// Required when `engagementType` is contractor (FR-008); → partners vendor
  /// resolved via PartnersService (FR-034).
  contractorId   String?

  /// → projects.Site.
  siteId String

  /// Optional per-worker rate that takes precedence over the project rate (FR-006).
  rateOverride Decimal? @db.Decimal(12, 2)

  /// → feature 003's face enrolment, reused not reimplemented (FR-011).
  faceEnrolmentId String?

  status             WorkerStatus @default(active)
  lastWorkingDate    DateTime?    @db.Date
  deactivationReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  gangMemberships GangMember[]

  @@unique([companyId, labourCode])
  @@index([companyId])
  @@index([companyId, siteId])
  @@index([companyId, skillCategoryId])
  @@index([companyId, status])
  @@schema("labour")
}

/// A gang: a group of workers under a gang leader, selectable as a batch during
/// muster capture (FR-012).
model LabourGang {
  id        String @id @default(cuid())
  companyId String

  name               String
  gangLeaderWorkerId String
  siteId             String
  isActive           Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  members GangMember[]

  @@index([companyId])
  @@index([companyId, siteId])
  @@schema("labour")
}

/// Gang membership join. A worker belongs to at most one active gang at a time
/// (FR-012) — enforced by a partial unique index on `workerId` where `isActive`,
/// added in the migration (Prisma cannot express a partial unique index).
model GangMember {
  id        String @id @default(cuid())
  companyId String

  gangId String
  gang   LabourGang @relation(fields: [gangId], references: [id], onDelete: Cascade)

  workerId String
  worker   LabourWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  /// Denormalised from the gang so the partial unique index (single active
  /// membership) can be evaluated without a join.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([gangId, workerId])
  @@index([companyId])
  @@index([workerId])
  @@schema("labour")
}

/// A muster roll: one supervisor capture session for a site and date, validated
/// against the site geofence by a single GPS reading (FR-013, FR-016). Geofence and
/// low-accuracy violations are recorded and flagged, never rejected (FR-013).
model MusterRoll {
  id        String @id @default(cuid())
  companyId String

  siteId String
  /// Company-timezone calendar day (003 FR-018a basis, FR-021).
  date   DateTime @db.Date

  /// The account (supervisor) that opened the session.
  supervisorId String

  latitude       Decimal @db.Decimal(10, 7)
  longitude      Decimal @db.Decimal(10, 7)
  accuracyMetres Decimal @db.Decimal(8, 2)

  geofenceViolation       Boolean  @default(false)
  lowGpsAccuracy          Boolean  @default(false)
  distanceFromFenceMetres Decimal? @db.Decimal(10, 2)

  source MusterSource @default(mobile)

  /// Both retained for offline sync (FR-018); `capturedAt` is the client's,
  /// `receivedAt` the server's.
  capturedAt      DateTime
  receivedAt      DateTime @default(now())
  isOfflineSynced Boolean  @default(false)

  status       MusterStatus @default(draft)
  approvedBy   String?
  approvedAt   DateTime?
  returnReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  lines MusterLine[]

  @@index([companyId])
  @@index([companyId, siteId, date])
  @@index([companyId, status])
  @@schema("labour")
}

/// One worker's line on a muster roll: attendance type, optional overtime, the
/// captured photo (encrypted object storage — FR-015), and an advisory face-match
/// result (FR-014 — flagged, never blocking). `skillCategoryIdOnDay` snapshots the
/// worker's skill so a mid-period change still prices correctly.
model MusterLine {
  id        String @id @default(cuid())
  companyId String

  musterId String
  muster   MusterRoll @relation(fields: [musterId], references: [id], onDelete: Cascade)

  workerId String

  attendanceType AttendanceType
  overtimeHours  Decimal?       @db.Decimal(5, 2)

  /// Encrypted object-storage ref (FR-015). Nullable so a gang bulk-add can create a
  /// line before its photo is captured; submission requires every line to have one
  /// (FR-010).
  photoRef String?

  faceMatchScore Decimal? @db.Decimal(6, 4)
  faceMatchLow   Boolean  @default(false)

  /// Snapshot of the worker's skill category at capture time so a mid-period skill
  /// change prices historical days correctly.
  skillCategoryIdOnDay String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([musterId, workerId])
  @@index([companyId])
  @@index([workerId])
  @@schema("labour")
}

/// A cash payment sheet: one per project, per wage period, per engagement type
/// (FR-023, FR-026 to FR-028). Frozen on approval; direct sheets carry a jsonb
/// denomination breakup, contractor sheets do not.
model LabourPaymentSheet {
  id        String @id @default(cuid())
  companyId String

  projectId String

  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date

  engagementType EngagementType

  status PaymentSheetStatus @default(draft)

  grossTotal     Decimal @default(0) @db.Decimal(14, 2)
  deductionTotal Decimal @default(0) @db.Decimal(14, 2)
  netTotal       Decimal @default(0) @db.Decimal(14, 2)

  /// Minimal note-count breakup with per-worker residual (FR-027) — direct sheets
  /// only. Null for contractor sheets (FR-028).
  denominationBreakup Json?

  approvedBy   String?
  approvedAt   DateTime?
  reopenReason String?
  closedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  lines PaymentSheetLine[]

  @@index([companyId])
  @@index([companyId, projectId, engagementType])
  @@index([companyId, status])
  @@schema("labour")
}

/// One worker's aggregated line on a payment sheet, then the disbursement record
/// against it. `deductions` is a jsonb list (advance instalments, fines).
model PaymentSheetLine {
  id        String @id @default(cuid())
  companyId String

  sheetId String
  sheet   LabourPaymentSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  workerId String

  /// Full days = 1, half days = 0.5 (FR-022).
  daysWorked    Decimal @db.Decimal(6, 2)
  overtimeHours Decimal @default(0) @db.Decimal(6, 2)

  resolvedRate Decimal    @db.Decimal(12, 2)
  rateSource   RateSource

  grossWage  Decimal @db.Decimal(14, 2)
  /// Advance instalments and fines applied this period (jsonb list).
  deductions Json
  netPayable Decimal @db.Decimal(14, 2)

  paymentMode           LabourPaymentMode?
  paidOn                DateTime?          @db.Date
  paidAmount            Decimal?           @db.Decimal(14, 2)
  shortPaymentReason    String?
  /// Encrypted object-storage ref, required for a cash disbursement (FR-029).
  acknowledgementRef    String?
  /// Unpaid remainder (short payment) carried to the next period (FR-030).
  carriedForwardBalance Decimal            @default(0) @db.Decimal(14, 2)

  status PaymentSheetLineStatus @default(pending)

  reversalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([sheetId])
  @@index([workerId])
  @@schema("labour")
}

/// A labour advance against future wages, recovered in instalments through payment
/// sheets (FR-024, FR-025). `outstandingBalance` is reduced only on disbursement of
/// the recovering sheet line, never on sheet generation.
model LabourAdvance {
  id        String @id @default(cuid())
  companyId String

  workerId String

  amount Decimal @db.Decimal(14, 2)
  reason String

  recoveryInstalments Int
  /// `amount / recoveryInstalments`, rounded — the per-period deduction.
  instalmentAmount    Decimal  @db.Decimal(14, 2)
  /// The wage period (its `periodFrom` date) recovery starts from.
  recoveryStartPeriod DateTime @db.Date

  outstandingBalance Decimal @default(0) @db.Decimal(14, 2)

  /// Amount exceeds the configured multiple of the worker's daily rate (FR-024/US7);
  /// requires LABOUR_APPROVE to be approved.
  exceedsLimit Boolean @default(false)

  status      AdvanceStatus @default(pending)
  approvedBy  String?
  approvedAt  DateTime?
  disbursedOn DateTime?     @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId])
  @@index([companyId, workerId])
  @@index([companyId, status])
  @@schema("labour")
}

// ============================================================================
// PROJECT ASSETS (feature 012)
// ============================================================================
//
// The gap between 009 and 006: durable, individually-identified or bulk-tracked
// items that are *allocated and returned* rather than consumed (009) or run with a
// logbook and fuel book (006). Scaffolding, shuttering, power tools, formwork,
// safety gear, IT assets, site furniture.
//
// Three reference masters live in `settings` and eight operational tables in the new
// `assets` schema (spec FR-002) — the same split 006 and 009 use, for the same
// reason: a master is company configuration, and configuration belongs with the rest
// of it.

/// Whether a category's units are individually identified or fungible (spec
/// FR-004, clarification 2026-09-01).
///
/// This is the single most load-bearing piece of configuration in the module: it
/// decides whether an asset is one row with a serial number and a custodian, or a
/// quantity tracked per site. Immutable once assets exist under the category
/// (FR-003) because the two have structurally different allocation semantics and a
/// flip would reinterpret every existing row.
enum AssetTrackingMode {
  serialised
  bulk

  @@schema("settings")
}

/// The vocabulary a return, inspection, or transfer receipt grades an asset in.
///
/// A master rather than an enum because "Good / Fair / Poor / Damaged / Scrap" is
/// one company's ladder and not another's — and because `isDamaged` / `isScrap`
/// carry behaviour (FR-015), a company that wants a sixth rung must be able to say
/// where on the ladder it sits.
model ConditionGrade {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Stored uppercase, like every other master's name in this schema.
  name String

  /// Best-first ordering for dropdowns and for the transfer's condition-discrepancy
  /// comparison (FR/US5 scenario 5): a receipt graded at a higher sequence than its
  /// dispatch is a discrepancy.
  sequence Int

  /// A return or inspection at this grade sends the asset to `under_repair`
  /// (spec FR-015).
  isDamaged Boolean @default(false)
  /// ... and at this grade, to `scrapped`. Both false is the ordinary healthy grade.
  isScrap   Boolean @default(false)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

/// An asset category with its tracking mode, depreciation policy, and custody /
/// inspection rules (spec US1).
model AssetCategory {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  /// Immutable once any asset exists under this category (spec FR-003).
  trackingMode AssetTrackingMode

  /// Straight-line, % per annum. The default a new asset inherits; the asset keeps
  /// its own copy so a later policy change does not silently restate the book value
  /// of machines already on the register.
  depreciationRatePercent Decimal @default(0) @db.Decimal(6, 2)
  usefulLifeYears         Int     @default(5)

  /// Allocation of an asset in this category requires a custodian, and that
  /// custodian must be posted at the allocation's site (spec FR-010).
  custodyRequired Boolean @default(false)

  /// Assets in this category carry a `nextInspectionDue` (spec FR-017).
  inspectionRequired     Boolean @default(false)
  /// Required when `inspectionRequired` — enforced at the DTO and service layer,
  /// not by the database, because the pairing is a business rule and a CHECK
  /// constraint here would produce a 500 rather than the 400 US1 scenario 2 asks
  /// for.
  inspectionIntervalDays Int?

  /// Cumulative repair cost above this share of purchase cost flags the asset
  /// (US6 scenario 8). Per category, never a literal — Principle III.
  repairCostThresholdPercent Decimal @default(50) @db.Decimal(6, 2)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

/// A kind of asset document, with its own expiry-alert window (spec FR-025).
/// Per type and stored, for the reason `EquipmentDocType.alertDays` documents: an
/// insurance policy and a calibration certificate are not renewed on the same
/// notice.
model AssetDocType {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String

  alertDays Int @default(30)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

// ── assets schema ───────────────────────────────────────────────────────────

/// The asset lifecycle (spec FR-007). Every transition is checked against an
/// explicit machine in `asset-status.ts`; nothing writes this column directly.
///
/// `not_in_service` is the state of an asset registered ahead of its capitalisation
/// date — it exists on the register but is excluded from allocation and from
/// depreciation until that date arrives (spec Edge Cases).
enum AssetStatus {
  not_in_service
  idle
  allocated
  in_transit
  under_repair
  scrapped

  @@schema("assets")
}

enum AssetAllocationStatus {
  open
  closed

  @@schema("assets")
}

/// A transfer's own lifecycle, distinct from the asset's. `closed_with_shortage` is
/// a real terminal state rather than a flag on `closed`, because a transfer that
/// lost units in transit is not the same event as one that did not, and FR-014
/// forbids silently balancing the difference.
enum AssetTransferStatus {
  in_transit
  closed
  closed_with_shortage
  cancelled

  @@schema("assets")
}

enum AssetRequestStatus {
  pending
  approved
  rejected
  fulfilled
  /// Approved, but nothing idle of that category exists anywhere in the company —
  /// the store team picks it up through 009's purchase flow (spec FR-024).
  procurement_pending
  cancelled

  @@schema("assets")
}

enum AssetInspectionOutcome {
  pass
  repair_required
  condemn

  @@schema("assets")
}

enum AssetRepairStatus {
  open
  closed

  @@schema("assets")
}

/// A durable, returnable item on the register (spec US2).
///
/// One row is one physical unit for a `serialised` category, and one row is the
/// whole registered pool for a `bulk` category — with `AssetStock` holding where the
/// units of that pool actually are. That asymmetry is deliberate and is why
/// `trackingMode` is copied onto the asset: a reader must be able to tell which kind
/// of row they are holding without a join to `settings`.
model Asset {
  id String @id @default(cuid())

  companyId String

  /// Allocated from the company's ASSETS series (`{shortCode}-AST-0001`) — spec
  /// FR-006, the same allocator vendor, project, item and equipment codes use.
  assetCode String
  name      String

  /// → `settings.AssetCategory`. Bare id, resolved via `AssetCategoriesService`:
  /// Principle I forbids a relation across the schema boundary.
  categoryId   String
  /// Copied from the category at registration, for the reason
  /// `Equipment.meterType` documents — a category's mode must never silently
  /// reinterpret rows already registered under it, and FR-003 makes the copy
  /// permanently truthful by freezing the source.
  trackingMode AssetTrackingMode

  manufacturer String?
  modelNumber  String?
  /// Serialised only. Unique per company when present (spec FR-008); Postgres
  /// treats NULLs as distinct, so every bulk asset can leave it empty.
  serialNumber String?

  /// Bulk only: the total registered quantity, the sum of its `AssetStock` rows'
  /// on-hand + allocated + in-transit. Serialised assets carry 1 and reject any
  /// other value (spec FR-004).
  quantity      Decimal @default(1) @db.Decimal(18, 3)
  unitOfMeasure String?

  purchaseDate DateTime? @db.Date
  purchaseCost Decimal   @default(0) @db.Decimal(18, 2)

  /// Depreciation starts here, never before (spec FR-019). Must be ≥ `purchaseDate`.
  capitalisationDate      DateTime @db.Date
  /// Copied from the category so a later policy change does not restate the book
  /// value of assets already registered.
  depreciationRatePercent Decimal  @default(0) @db.Decimal(6, 2)
  usefulLifeYears         Int      @default(5)
  /// The floor book value never falls below (spec FR-019, SC-008).
  salvageValue            Decimal  @default(0) @db.Decimal(18, 2)

  /// → `partners.Vendor`, via `PartnersService`.
  vendorId   String?
  /// → `inventory.Purchase`, via `InventoryService`. Optional and inert until the
  /// asset was actually acquired through a recorded purchase (spec FR-038).
  purchaseId String?

  /// → `projects.Site`, via `SitesService`. Where the asset is right now — for a
  /// bulk asset this is its home site, and `AssetStock` is the truth about where the
  /// units are.
  currentSiteId           String
  /// → `hr.Employee`, via `EmployeesService`. Serialised, custody-required
  /// categories only (spec FR-010).
  currentCustodianId      String?
  /// → `settings.ConditionGrade`.
  currentConditionGradeId String?

  status AssetStatus @default(idle)

  /// Set on registration for inspection-required categories and advanced from each
  /// inspection *date*, not from the prior due date, so a late inspection does not
  /// compound the schedule (spec FR-017).
  nextInspectionDue DateTime? @db.Date

  /// Set when the asset is condemned (spec FR-018).
  disposalDate DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  /// Soft delete (spec FR-031): an asset's movement and custody history outlives the
  /// asset, so nothing here is ever hard-deleted.
  deletedAt DateTime?
  deletedBy String?

  stock       AssetStock[]
  allocations AssetAllocation[]
  transfers   AssetTransfer[]
  inspections AssetInspection[]
  repairs     AssetRepair[]
  documents   AssetDocument[]

  @@unique([companyId, assetCode])
  @@unique([companyId, serialNumber])
  @@index([companyId])
  @@index([companyId, categoryId])
  @@index([companyId, currentSiteId])
  @@index([companyId, status])
  @@index([companyId, currentCustodianId])
  @@index([companyId, nextInspectionDue])
  @@schema("assets")
}

/// Where a bulk asset's units are, as a per-site running balance (spec FR-005).
///
/// Maintained in-transaction on every allocation, return, transfer and adjustment
/// rather than derived from movement history on read — the same choice 009 FR-002
/// made for inventory stock, and for the same reason: the stock screen is the
/// module's most-read surface and re-aggregating a movement log on every load does
/// not hold up.
///
/// The three quantities are kept separate rather than netted because a user watching
/// a transfer needs to see the units leave one column and arrive in another; a single
/// "available" figure makes an in-flight transfer look like loss (spec FR-007).
model AssetStock {
  id String @id @default(cuid())

  companyId String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// → `projects.Site`.
  siteId String

  /// Physically here and free to allocate or dispatch.
  quantityOnHand    Decimal @default(0) @db.Decimal(18, 3)
  /// Physically here but committed to an open allocation.
  quantityAllocated Decimal @default(0) @db.Decimal(18, 3)
  /// Dispatched from here and not yet acknowledged at the destination (spec FR-012).
  quantityInTransit Decimal @default(0) @db.Decimal(18, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assetId, siteId])
  @@index([companyId])
  @@index([companyId, siteId])
  @@schema("assets")
}

/// An asset's posting to a project site for a period, with optional custody
/// (spec US3).
model AssetAllocation {
  id String @id @default(cuid())

  companyId String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// → `projects.Project` and `projects.Site`, via `ProjectsService` / `SitesService`.
  projectId String
  siteId    String

  /// → `hr.Employee`. Required when the category sets `custodyRequired`, and the
  /// employee must be posted at `siteId` (spec FR-010).
  custodianEmployeeId String?

  /// Bulk only: how many units this allocation holds. 1 for serialised.
  quantity Decimal @default(1) @db.Decimal(18, 3)

  allocatedFrom      DateTime  @db.Date
  /// What the `overdue_return` reminder family hangs off (spec FR-025).
  expectedReturnDate DateTime  @db.Date
  actualReturnDate   DateTime? @db.Date

  /// → `settings.ConditionGrade`. Its `isDamaged` / `isScrap` decide the status the
  /// asset returns to (spec FR-015).
  conditionOnReturnId String?
  remarks             String?

  status AssetAllocationStatus @default(open)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId])
  @@index([companyId, assetId])
  @@index([companyId, projectId])
  @@index([companyId, siteId])
  @@index([companyId, status])
  @@index([companyId, custodianEmployeeId])
  @@index([companyId, expectedReturnDate])
  @@schema("assets")
}

/// A two-step move between sites: dispatch, then acknowledged receipt, with the
/// asset belonging to neither site's available pool in between (spec FR-012).
model AssetTransfer {
  id String @id @default(cuid())

  companyId String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  fromSiteId String
  toSiteId   String

  quantity Decimal @default(1) @db.Decimal(18, 3)

  dispatchDate        DateTime @db.Date
  transportMode       String?
  vehicleNumber       String?
  /// → `settings.ConditionGrade` as dispatched, so the receipt has something to
  /// compare against.
  dispatchConditionId String?

  receivedDate         DateTime? @db.Date
  receivedQuantity     Decimal?  @db.Decimal(18, 3)
  conditionOnReceiptId String?
  /// Received in a worse grade than dispatched (US5 scenario 5). Audit-logged.
  conditionDiscrepancy Boolean   @default(false)
  /// Dispatched minus received, when a bulk transfer arrives short (spec FR-014).
  transitShortage      Decimal?  @db.Decimal(18, 3)

  status       AssetTransferStatus @default(in_transit)
  cancelReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId])
  @@index([companyId, assetId])
  @@index([companyId, status])
  @@index([companyId, toSiteId])
  @@index([companyId, dispatchDate])
  @@schema("assets")
}

/// A site's request for an asset, fulfilled by allocating one — never by buying one
/// (spec US4, FR-024).
model AssetRequest {
  id String @id @default(cuid())

  companyId String

  /// `{shortCode}-ARQ-0001`, from the ASSET_REQUEST series.
  requestNumber String

  /// → `settings.AssetCategory`. What kind of asset is wanted.
  categoryId String
  /// Optionally a specific one.
  assetId    String?

  quantity Decimal @default(1) @db.Decimal(18, 3)

  projectId String
  siteId    String

  requiredByDate DateTime @db.Date
  justification  String

  status AssetRequestStatus @default(pending)

  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  /// The allocation fulfilment created, in the same transaction (spec FR-023).
  fulfilledAllocationId String?
  fulfilledAt           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, requestNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, projectId])
  @@index([companyId, siteId])
  @@index([companyId, requiredByDate])
  @@schema("assets")
}

/// A dated condition assessment that drives the next due date and, on a bad outcome,
/// the asset's status (spec US6).
model AssetInspection {
  id String @id @default(cuid())

  companyId String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  inspectionDate   DateTime               @db.Date
  /// → `settings.ConditionGrade`.
  conditionGradeId String
  outcome          AssetInspectionOutcome
  remarks          String?

  /// The user who recorded it. Not an HR employee id: the register records who in
  /// the system asserted the condition, which is an accountability question about
  /// the account, not about a payroll record.
  inspectedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, assetId])
  @@index([companyId, inspectionDate])
  @@schema("assets")
}

/// A repair episode, with its cost and the downtime it caused (spec US6).
model AssetRepair {
  id String @id @default(cuid())

  companyId String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  repairDate  DateTime @db.Date
  description String
  cost        Decimal  @default(0) @db.Decimal(18, 2)

  /// → `partners.Vendor`. Kept even if the vendor is later deactivated — the repair
  /// happened, and reads resolve the name with an `inactive` marker (spec Edge Cases).
  vendorId String?

  expectedCompletionDate    DateTime? @db.Date
  actualCompletionDate      DateTime? @db.Date
  /// → `settings.ConditionGrade` on close.
  resultingConditionGradeId String?

  /// Computed on close: whole days between `repairDate` and completion. Stored so
  /// the asset's cumulative downtime is a sum rather than a per-row date subtraction
  /// on every read.
  downtimeDays Int?

  status AssetRepairStatus @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([companyId])
  @@index([companyId, assetId])
  @@index([companyId, status])
  @@schema("assets")
}

/// A document held against an asset, with the expiry that drives its reminder
/// (spec FR-025, FR-028).
model AssetDocument {
  id String @id @default(cuid())

  companyId String

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// → `settings.AssetDocType`, whose `alertDays` is this document's alert window.
  docTypeId String

  /// Object-storage key, never a public URL — resolved to a short-lived signed URL
  /// at read time, the same treatment equipment, contractor and employee documents
  /// get. Encrypted before it leaves the process (spec FR-028).
  fileRef  String
  fileName String?
  mimeType String?

  documentNumber String?
  issueDate      DateTime? @db.Date
  expiryDate     DateTime? @db.Date

  uploadedByUserId String
  uploadedAt       DateTime @default(now())

  @@index([companyId])
  @@index([assetId])
  @@index([companyId, expiryDate])
  @@schema("assets")
}

// ============================================================================
// recruitment schema — feature 011 (Recruitment & Onboarding: requisitions,
// candidates, interviews, offers, joining, onboarding, letters, resignations).
//
// The hiring funnel that terminates in the creation of the `hr.Employee` record
// feature 005 administers. Every cross-schema reference (departmentId,
// designationId, projectId, siteId, employeeId, interviewerEmployeeId, kitItemId,
// documentTypeId, templateId, linkedIssueId) is a bare id with no Prisma relation —
// Principle I routes every cross-module read through the owning module's service.
// Same-schema parent/child links are real relations.
// ============================================================================

enum RequisitionEmploymentType {
  permanent
  contract
  walk_in

  @@schema("recruitment")
}

enum RequisitionStatus {
  draft
  pending_approval
  open
  rejected
  closed

  @@schema("recruitment")
}

enum CandidateSource {
  referral
  agency
  walk_in
  portal
  internal

  @@schema("recruitment")
}

enum CandidateStage {
  applied
  shortlisted
  interviewing
  selected
  offer_issued
  offer_accepted
  joined
  rejected
  no_show

  @@schema("recruitment")
}

enum InterviewRoundType {
  telephonic
  technical
  hr
  managerial
  final

  @@schema("recruitment")
}

enum InterviewMode {
  in_person
  phone
  video

  @@schema("recruitment")
}

enum InterviewStatus {
  scheduled
  completed
  cancelled

  @@schema("recruitment")
}

enum InterviewOutcome {
  recommend
  hold
  reject

  @@schema("recruitment")
}

enum OfferStatus {
  draft
  issued
  accepted
  declined
  superseded

  @@schema("recruitment")
}

enum OnboardingItemType {
  document
  kit
  induction

  @@schema("recruitment")
}

enum OnboardingItemStatus {
  pending
  completed
  waived

  @@schema("recruitment")
}

enum ResignationReasonCategory {
  better_opportunity
  personal
  relocation
  health
  compensation
  work_environment
  other

  @@schema("recruitment")
}

enum ResignationStatus {
  submitted
  accepted
  withdrawn

  @@schema("recruitment")
}

/// A manpower requisition — the "Open Positions" record every candidate is scoped to
/// (011 US1). Auto-closes when `filledPositions == positionCount` (FR-014).
model Requisition {
  id        String @id @default(cuid())
  companyId String

  requisitionCode String

  departmentId  String
  designationId String

  positionCount   Int
  filledPositions Int @default(0)

  employmentType RequisitionEmploymentType

  projectId String?
  siteId    String?

  targetJoiningDate DateTime @db.Date
  budgetedCtcMin    Decimal  @db.Decimal(14, 2)
  budgetedCtcMax    Decimal  @db.Decimal(14, 2)
  justification     String

  status          RequisitionStatus @default(draft)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  candidates Candidate[]

  @@unique([companyId, requisitionCode])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@schema("recruitment")
}

/// A candidate against one requisition (011 US2). PII (`phone`, `email`,
/// `currentCtc`, `expectedCtc`) is masked in list responses (FR-006). Retained and
/// linked to the created `hr.Employee` via `employeeId` on joining (FR-013).
model Candidate {
  id        String @id @default(cuid())
  companyId String

  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  fullName             String
  phone                String
  email                String
  totalExperienceYears Decimal  @db.Decimal(4, 1)
  currentEmployer      String?
  currentCtc           Decimal? @db.Decimal(14, 2)
  expectedCtc          Decimal? @db.Decimal(14, 2)

  source               CandidateSource
  referredByEmployeeId String?
  resumeRef            String?

  stage               CandidateStage @default(applied)
  employeeId          String?
  previousCandidateId String?
  rejectionReason     String?
  noShowReason        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  stageHistory CandidateStageHistory[]
  interviews   Interview[]
  offers       Offer[]

  @@index([companyId])
  @@index([companyId, requisitionId])
  @@index([companyId, stage])
  @@schema("recruitment")
}

/// Immutable stage-transition log — the source of truth for time-to-hire (FR-005,
/// FR-028).
model CandidateStageHistory {
  id        String @id @default(cuid())
  companyId String

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  fromStage  CandidateStage?
  toStage    CandidateStage
  actorId    String?
  occurredAt DateTime        @default(now())
  remarks    String?

  @@index([companyId])
  @@index([candidateId])
  @@schema("recruitment")
}

/// One interview round for a candidate (011 US3). Round number is unique per
/// candidate; `rescheduleHistory` retains prior times as jsonb.
model Interview {
  id        String @id @default(cuid())
  companyId String

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  roundNumber Int
  roundType   InterviewRoundType
  scheduledAt DateTime
  mode        InterviewMode
  location    String?

  status            InterviewStatus @default(scheduled)
  rescheduleCount   Int             @default(0)
  rescheduleHistory Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  interviewers InterviewInterviewer[]
  feedback     InterviewFeedback[]

  @@unique([candidateId, roundNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@schema("recruitment")
}

/// Join table: which employees are assigned to an interview (gates who may submit
/// feedback — FR-009).
model InterviewInterviewer {
  id        String @id @default(cuid())
  companyId String

  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  employeeId String

  @@unique([interviewId, employeeId])
  @@index([companyId])
  @@schema("recruitment")
}

/// One interviewer's feedback on one interview (FR-009).
model InterviewFeedback {
  id        String @id @default(cuid())
  companyId String

  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  interviewerEmployeeId String
  outcome               InterviewOutcome
  score                 Int
  comments              String
  submittedAt           DateTime         @default(now())

  @@unique([interviewId, interviewerEmployeeId])
  @@index([companyId])
  @@schema("recruitment")
}

/// An offer to a selected candidate (011 US4). Immutable once `accepted` (FR-012);
/// at most one non-superseded offer per candidate. `salaryBreakup` is a jsonb list of
/// { name, monthlyAmount } that must reconcile to `offeredCtc / 12` (FR-010).
model Offer {
  id        String @id @default(cuid())
  companyId String

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  designationId String
  departmentId  String

  offeredCtc    Decimal @db.Decimal(14, 2)
  salaryBreakup Json

  proposedJoiningDate  DateTime  @db.Date
  confirmedJoiningDate DateTime? @db.Date
  probationMonths      Int
  noticePeriodDays     Int

  reportingManagerEmployeeId String

  outsideBudget Boolean     @default(false)
  status        OfferStatus @default(draft)
  letterId      String?

  acceptedOn    DateTime? @db.Date
  declineReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId])
  @@index([companyId, candidateId])
  @@schema("recruitment")
}

/// The onboarding checklist opened when a candidate joins (011 US6).
model OnboardingChecklist {
  id        String @id @default(cuid())
  companyId String

  employeeId  String
  candidateId String

  openedAt    DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OnboardingItem[]

  @@unique([companyId, employeeId])
  @@index([companyId])
  @@schema("recruitment")
}

/// One checklist item: a document to verify, a kit item to issue, or an induction
/// task (011 FR-015 to FR-019).
model OnboardingItem {
  id        String @id @default(cuid())
  companyId String

  checklistId String
  checklist   OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  itemType       OnboardingItemType
  documentTypeId String?
  kitItemId      String?
  label          String

  status        OnboardingItemStatus @default(pending)
  completedBy   String?
  completedAt   DateTime?
  waiverReason  String?
  linkedIssueId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([checklistId])
  @@schema("recruitment")
}

/// A generated, versioned, immutable letter (011 US7). Regeneration supersedes the
/// prior version; both remain downloadable.
/// A letter, composed and then issued (017 §2 — was `recruitment.GeneratedLetter`).
///
/// **Moved to `shared` and renamed.** A work order addressed to a vendor is not a
/// recruitment record, and leaving the table in `recruitment` would have forced the
/// recruitment module to learn about `partners`, `projects` and `inventory` — which
/// Principle I forbids outright. In `shared` it belongs to no business module and can
/// address anything.
model IssuedLetter {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  letterKindId String
  /// `Restrict`, so FR-022 ("refuse to delete a kind letters reference") is the
  /// database's job. The service check exists to produce a legible message, not to be
  /// the guarantee.
  letterKind   LetterKind @relation(fields: [letterKindId], references: [id], onDelete: Restrict)

  /// Recruitment's two addressing forms, untouched by the move.
  employeeId  String?
  candidateId String?

  /// The third form: an OPAQUE pair — `vendor`, `project`, `purchase`. This module
  /// never dereferences it. Resolving `subjectId` to a vendor name would be exactly the
  /// cross-schema read the move was made to avoid; the owning module resolves it.
  subjectType String?
  subjectId   String?

  templateId String

  /// Who signed, and **the graphic as applied** (research §5). Both, not just the id:
  /// FR-013 requires a previously issued letter to render as it was issued, and a
  /// signatory's graphic can be replaced. An implementation storing only `signatoryId`
  /// silently rewrites history the first time somebody uploads a new signature.
  signatoryId         String?
  signatory           Signatory? @relation(fields: [signatoryId], references: [id], onDelete: SetNull)
  appliedSignatureRef String?

  /// FR-017: the executed copy that comes back, and FR-018's issued-vs-executed
  /// distinction, which is rendered from whether this is null.
  countersignedRef String?
  countersignedAt  DateTime?

  /// Empty until the letter is issued — a composed letter awaiting approval has no
  /// rendered document yet, because rendering it would produce a file indistinguishable
  /// from the real one.
  renderedRef  String  @default("")
  version      Int     @default(1)
  isSuperseded Boolean @default(false)

  /// **NULL means composed but not yet issued.** A gated kind (FR-015a) must clear its
  /// 016 chain before it takes effect, and the chain needs something to be raised
  /// against — so the letter exists first and is issued second. The same null-as-not-yet
  /// idiom `countersignedAt` uses two fields up.
  issuedAt DateTime?
  issuedBy String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, letterKindId, employeeId])
  @@index([companyId, letterKindId, candidateId])
  /// FR-019: letters where the work is — listed by the opaque subject pair.
  @@index([companyId, subjectType, subjectId])
  @@schema("shared")
}

/// An employee's resignation record (011 US8) — the trigger 005's exit flow consumes.
model Resignation {
  id        String @id @default(cuid())
  companyId String

  employeeId String

  resignationDate  DateTime                  @db.Date
  reasonCategory   ResignationReasonCategory
  reasonDetail     String
  noticePeriodDays Int

  expectedLastWorkingDay DateTime  @db.Date
  agreedLastWorkingDay   DateTime? @db.Date
  noticeWaiverDays       Int?
  waiverReason           String?

  status         ResignationStatus @default(submitted)
  withdrawReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([companyId])
  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@schema("recruitment")
}
