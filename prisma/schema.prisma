/// Letter types feature 011 generates from per-company templates (011 FR-020).
/// A kind of letter (017 §1, FR-010, FR-011, FR-022).
///
/// Replaces `enum LetterType`, which had five values and needed a migration for each
/// new one — directly contradicting FR-011, "define a new letter kind without a code
/// change". A row is what makes both FR-011 and FR-022 (refuse deletion while letters
/// reference it) structural rather than conventional.
model LetterKind {
  id String @id @default(cuid())

  /// NULL = a kind this product ships for everyone; a value = one company defined it.
  /// The same nullable-tenant pattern as `ReminderRule`.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Stable identifier — `offer`, `letter_work_order`. What code and the 016 action
  /// types match on, and deliberately not editable: the label is what a human changes.
  ///
  /// The five keys migrated from `enum LetterType` are byte-identical to the old enum
  /// values, which is what let the backfill match them and what keeps Recruitment's
  /// behaviour unchanged.
  key   String
  label String

  /// FR-016: whether a signature is applied at issue.
  requiresSignature  Boolean @default(false)
  /// FR-015a: true for work order, LOI and purchase order — the three that commit money.
  requiresApproval   Boolean @default(false)
  /// The 016 action type to gate on. Must equal a constant exported from
  /// `src/approvals/default-chains.ts`; a unit test asserts that rather than trusting
  /// two files to stay in step.
  approvalActionType String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates LetterTemplate[]
  letters   IssuedLetter[]
  fields    LetterKindField[]

  /// Company-authored kinds are unique per company. Product-shipped ones (companyId
  /// NULL) need a SECOND, hand-authored partial unique index, because Postgres treats
  /// NULLs as distinct and this composite would happily admit two `(NULL, 'offer')`
  /// rows — see `LetterKind_shipped_key` in the migration.
  @@unique([companyId, key])
  @@index([companyId])
  @@schema("settings")
}

/// One field a letter kind's templates may reference (017 FR-011b, FR-011c) — `bugs.md` item 18.
///
/// **Keyed to the kind, not to the shipped `LetterType` enum**, and that coupling is exactly what
/// made item 18 half-work: FR-011 let an administrator define a letter kind, and `LETTER_TOKENS` was
/// keyed by the five shipped enum values, so a kind the client defined got an **empty** field list.
/// The template editor then refused every field it used. Both requirements were satisfied and
/// together they produced nothing usable.
///
/// `buildcore-web`'s FR-014 already required "define a new letter kind, **its variable fields** and
/// its fixed terms", so this table is the api catching up to a contract already written rather than
/// new scope invented on both sides.
model LetterKindField {
  id String @id @default(cuid())

  letterKindId String
  letterKind   LetterKind @relation(fields: [letterKindId], references: [id], onDelete: Cascade)

  /// The `{{token}}` name, without braces. What a template references.
  token String
  /// What the template editor calls it. "Offered CTC", not `offeredCtc`.
  label String

  /// **Where the value comes from** (FR-011c).
  ///
  /// A field that is only a label is a placeholder that renders blank — and a blank in a signed
  /// letter is indistinguishable from a deliberate omission, which is the failure this column exists
  /// to prevent. `manual` is the honest exception: some terms are typed at issue time and have no
  /// record behind them, and saying so is better than inventing a source.
  sourceType LetterFieldSource
  /// The path within the source record, dot-separated: `designation.name`, `basic`.
  ///
  /// Null only for `manual`, where there is no record to read. A `CHECK` in the migration enforces
  /// that pairing rather than leaving it to every writer to remember.
  sourcePath String?

  /// Whether issuing without a value for this field is refused.
  isRequired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One declaration per token per kind.
  @@unique([letterKindId, token])
  @@index([letterKindId])
  @@schema("settings")
}

enum LetterFieldSource {
  employee
  candidate
  project
  company
  /// Typed at issue time. No record behind it, and `sourcePath` must be null.
  manual

  @@schema("settings")
}

/// A named person whose signature is applied to letters (017 FR-016, research §5).
model Signatory {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  title String

  /// Storage key for the signature graphic, through the existing `StorageService`.
  signatureRef String

  /// Someone leaves; the letters they signed stay valid. Deactivating hides them from
  /// new issues without touching what was already issued.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  letters IssuedLetter[]

  @@index([companyId])
  @@schema("settings")
}

/// A kit item issued during onboarding (helmet, safety shoes, ID card, laptop) —
/// a `settings`-schema master owned and audited by feature 011 (011 FR-037). When
/// `linkedInventoryItemId` names an inventory item, issuing it records a real stock
/// issue; otherwise it is a non-stock issuance.
model KitItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name                  String
  linkedInventoryItemId String?
  defaultQuantity       Int     @default(1)
  issuedByDefault       Boolean @default(true)
  isRecoverableAtExit   Boolean @default(false)
  isActive              Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

/// A per-company letter template with `{{token}}` substitution (011 FR-020, FR-021).
/// At most one active template per (companyId, letterType) — enforced by a partial
/// unique index in the migration.
model LetterTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// 017 §1: was `letterType LetterType`. The enum is gone; a template now points at a
  /// `LetterKind` row, so a template can be written for a kind that did not exist when
  /// this code shipped.
  letterKindId String
  letterKind   LetterKind @relation(fields: [letterKindId], references: [id], onDelete: Restrict)

  name              String
  bodyTemplate      String
  letterheadAssetId String?
  isActive          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, letterKindId])
  @@schema("settings")
}

/// Per-company employee document types. The display flag
/// (MandatoryNumber/Mandatory/ExpiryNumber/Expiry/Number/Optional) is deliberately
/// NOT stored — it is a pure function of the three booleans below, computed on read
/// so it can never drift from them (research.md §7).
/// Which vocabulary a document kind belongs to (017 amendment, 2026-09-16).
///
/// `DocumentType` is one table serving two unrelated lists: the employee file (Aadhaar,
/// marksheets, PF forms) and the organisation's paperwork (GST certificate, labour
/// licence, work order). They were already mixed — every company's Employee Setup list
/// showed the statutory kinds too — and the screens owning each list are guarded by
/// different permissions, so the mixing is not merely untidy: it is a question about who
/// may add to whose list.
///
/// `company` covers project paperwork as well as the company's own. Both are the
/// organisation's papers rather than a person's, and a third value would split a
/// distinction no screen makes.
///
/// `both` is the default, and the honest answer for a kind that genuinely serves both —
/// Aadhaar and PAN are required of the company AND held on file for an employee. It is
/// also the only safe landing place for a kind this product did not define, because it
/// is the one value that cannot hide an existing row from a screen already showing it.
enum DocumentTypeScope {
  employee
  company
  both

  @@schema("settings")
}

model DocumentType {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code String
  name String

  /// Gates attendance marking for an employee missing this document (FR-021).
  isMandatory Boolean @default(false)
  hasExpiry   Boolean @default(false)
  needsNumber Boolean @default(false)

  /// Regulated personal data — Aadhaar today (017 FR-024). This flag is the *enforcement
  /// point*, not a label: the letter template resolver refuses a restricted type outright,
  /// so the rule holds for letter kinds nobody has defined yet, and superseded versions are
  /// purged on a bounded schedule rather than retained forever (017 FR-006a).
  isRestricted Boolean @default(false)

  /// Which list this kind belongs to. See `DocumentTypeScope`.
  scope DocumentTypeScope @default(both)

  sortOrder Int     @default(0)
  /// Inactive types are excluded from new-upload selection; historical employee
  /// records referencing them are unaffected (FR-019).
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyDocuments CompanyDocument[]

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("settings")
}

/// A company's own statutory papers — the certificates behind the registration numbers
/// already held on `Company` (017 US1, FR-001).
///
/// Deliberately the same shape as `EmployeeDocument`, `ProjectDocument`,
/// `ContractorDocument`, `EquipmentDocument` and `AssetDocument`. A sixth document model
/// that differed would be the one people got wrong.
model CompanyDocument {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// `settings.DocumentType.id`. A real relation here, unlike `EmployeeDocument`, because
  /// both models live in `settings` — no schema boundary is crossed.
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  /// Encrypted object-storage reference. Opaque: never a path a client supplies.
  fileRef String

  /// The uploader's own file name, and what their browser said the file was.
  ///
  /// Nullable because every row filed before 2026-10-04 predates these columns: both routes
  /// received a content type and discarded it, so the download served `application/octet-stream`
  /// under a name with no extension and a PDF opened as text. `describeStoredFile` sniffs the
  /// bytes when `mimeType` is null, which is why no backfill was attempted — the bytes are the
  /// only honest source, and they are already there.
  fileName       String?
  mimeType       String?
  /// The GSTIN/PAN/TAN itself, when the kind carries one (`DocumentType.needsNumber`).
  documentNumber String?
  /// Required when `DocumentType.hasExpiry` — enforced in the service (FR-004).
  expiresAt      DateTime? @db.Date

  /// Points back at the document this one replaced — the history chain FR-006 preserves.
  supersedesId String?          @unique
  supersedes   CompanyDocument? @relation("CompanyDocumentSupersession", fields: [supersedesId], references: [id])
  supersededBy CompanyDocument? @relation("CompanyDocumentSupersession")

  /// Whether this is the version that counts as present compliance today.
  ///
  /// A state column rather than an absence-of-pointer, and the reason is that only a
  /// state column can carry a database-level guarantee. "Current means nothing points at
  /// it" needs a NOT EXISTS, which no index can express; "current means this flag" is a
  /// partial unique index, which is exactly how 016 guaranteed one live approval per item.
  ///
  /// Maintained in the same transaction as the supersession it records, so it cannot drift
  /// from the chain — and the index below refuses two current rows even under a race that
  /// a service-level check would lose.
  isCurrent Boolean @default(true)

  uploadedByUserId String
  uploadedAt       DateTime @default(now())

  @@index([companyId])
  @@index([expiresAt])
  @@schema("settings")
}

/// Per-company shift definitions feeding the Employee form and overtime
/// calculation; deletion blocked while referenced by an Employee (FR-022).
model Shift {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  /// Wall-clock times of day, not instants — Postgres `time`, no date or zone
  /// component (data-model.md "Shift").
  inTime       DateTime @db.Time(0)
  outTime      DateTime @db.Time(0)
  /// Late-arrival tolerance, in minutes.
  graceMinutes Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@schema("settings")
}

/// One counter row per company, incremented via a single atomic
/// `UPDATE ... RETURNING` so concurrent employee creation can never produce a
/// duplicate or a gap (research.md §6, SC-007). Never read or written directly by
/// another module — only through `EmployeeCodeService.getNextEmployeeCode()`.
model EmployeeCodeSequence {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  lastNumber Int @default(0)

  @@schema("settings")
}

/// The master a reimbursement claim's category and receipt rule come from.
///
/// Lives in `settings` because it is per-company configuration, not employee data
/// (research.md §10). Feature 005 owns its admin CRUD; feature 003 only reads it,
/// through `ReimbursementCategoriesService`, to answer one question per claim: is a
/// receipt mandatory at this amount?
model ReimbursementCategory {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code String
  name String

  /// Claims strictly above this amount must carry a receipt (FR-030). Null means a
  /// receipt is never required for this category — distinct from `0`, which would
  /// require one on every claim.
  receiptRequiredAbove Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("settings")
}

/// One signed-in period on one device/client, as a chain of rotating refresh tokens
/// sharing a `familyId` — see data-model.md "Refresh Token".
/// A single-use, time-limited invite carrying the right to set an account's first
/// password. Only the SHA-256 hash of the token is stored, mirroring how
/// `RefreshToken` already handles its own opaque value (010 research.md §2) — so a
/// database dump alone can never be turned back into a working invite link.
model InviteToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hex of the raw token. The raw value exists only inside the email.
  tokenHash String @unique

  expiresAt  DateTime
  /// Set when the invite is redeemed, which is what makes it single-use.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  /// Resend inserts a new row rather than deleting the old one, so the invite
  /// history stays auditable (FR-014). "Usable" is therefore derived — unconsumed,
  /// unexpired, and the newest row for the user — rather than tracked in a boolean
  /// that would be a second source of truth for the same fact.
  @@index([userId, createdAt])
  @@schema("shared")
}

model RefreshToken {
  id        String  @id @default(cuid())
  /// HMAC-hashed opaque token value (SecurityConfig.refreshTokenHashSecret as pepper) —
  /// the raw value is never stored, mirroring password hashing practice.
  tokenHash String  @unique
  familyId  String
  accountId String
  account   User    @relation(fields: [accountId], references: [id])
  /// Copied from the owning account at issuance — every tenant-scoped table this
  /// feature relies on carries a company identifier (FR-020); null when the owning
  /// account has no home company.
  companyId String?

  /// Set true the moment this token is rotated (exchanged for a new one).
  used      Boolean   @default(false)
  /// When `used` was set — lets rotation tell a genuine replay apart from a benign
  /// concurrent-refresh race within a short grace window (research.md §2).
  usedAt    DateTime?
  /// Set on logout, reuse detection, account deactivation, or admin-reset-password.
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([familyId])
  @@index([accountId])
  @@schema("shared")
}

/// Immutable security-event record — write-only in this feature (spec.md 2026-08-26
/// clarification: reading/querying is a separate, later Activity Log feature).
model AuditLogEntry {
  id String @id @default(cuid())

  /// What the event was *about* — a login-lifecycle event (feature 001) or a
  /// settings entity that was changed (feature 002). Generalized from feature 001's
  /// flat `eventType` so every module shares one audit trail rather than growing a
  /// per-module enum (002 research.md §9).
  entityType AuditEntityType
  /// What happened to it — separated from `entityType` so `COMPANY`+`UPDATE` and
  /// `COMPANY`+`DELETE` don't need distinct enum values.
  action     AuditAction
  /// The Company/Role/Department/... row affected; null for login-related events,
  /// which key off `accountId`/`attemptedEmail` as before.
  entityId   String?
  /// Optional before/after snapshot for update actions.
  changes    Json?

  accountId      String?
  account        User?   @relation(fields: [accountId], references: [id])
  /// Populated only when accountId is null (an unregistered-identifier login_failure),
  /// so that failure is still traceable without inventing an account reference.
  attemptedEmail String?
  /// Copied from the account at event time; null for an unregistered-identifier
  /// failure and for any event with no company-scoped account.
  companyId      String?

  ipAddress String
  createdAt DateTime @default(now())

  @@index([accountId])
  @@schema("shared")
}

/// Feature 004 (US7): tracks one asynchronous report export. A small tracking table
/// in `shared` alongside `AuditLogEntry` — Dashboard aggregates other modules' data
/// and owns no business schema of its own (research.md §3). `companyId`-scoped and
/// RLS-protected (Principle IV).
model ExportJob {
  id String @id @default(cuid())

  /// One of the registered report-type ids.
  reportType String
  format     ExportFormat
  /// The filter / date-range params the export was requested with, replayed by the
  /// worker to re-run the same report.
  filters    Json

  status ExportJobStatus @default(pending)

  requestedByUserId String
  companyId         String

  /// Encrypted object-storage reference, set once `status = ready`.
  fileRef       String?
  /// Set once `status = failed`, so a poll reports the reason rather than silence.
  failureReason String?
  /// Set once the "Export Ready" notification has surfaced (research.md §6), so the
  /// notification provider announces each finished job exactly once.
  notifiedAt    DateTime?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([companyId, status])
  @@schema("shared")
}

enum ExportFormat {
  pdf
  excel

  @@schema("shared")
}

enum ExportJobStatus {
  pending
  processing
  ready
  failed

  @@schema("shared")
}

enum AuditEntityType {
  // Login-lifecycle values carried over from feature 001 (uppercased in the 002
  // generalization so both halves of the enum read consistently).
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  REFRESH_REUSE_DETECTED
  ADMIN_PASSWORD_RESET

  // Settings entities audited by feature 002 (FR-025).
  COMPANY
  ROLE
  DEPARTMENT
  DESIGNATION
  DOCUMENT_TYPE
  SHIFT
  /// Shared with 010-account-creation-backend so both features' writes to the same
  /// account surface under one type in the Activity Log (002 tasks T048).
  USER_ACCOUNT

  // My Workspace entities audited by feature 003 (FR-027). Biometric enrolment is
  // audited on *read* as well as write — Principle IV puts face data in the same
  // protection tier as Aadhaar/PAN, where every access is accountable.
  PUNCH
  LEAVE_APPLICATION
  FACE_ENROLMENT
  RE_ENROLMENT_REQUEST
  /// Shared with 005-hr-payroll-backend, which adds the approve/reject/pay layer
  /// over the same claims this feature's employees create (research.md §10).
  REIMBURSEMENT_CLAIM

  // Inventory entities audited by feature 009 (FR-010) and its indent amendment
  // (FR-030). Item and category sit here rather than under the Settings block above
  // because 009 is what creates and audits them, even though the tables are
  // `settings`-schema masters (research.md §1).
  ITEM_CATEGORY
  ITEM
  PURCHASE
  GOODS_RECEIPT_NOTE
  ISSUE
  STOCK_TRANSFER
  PAYMENT
  MATERIAL_INDENT

  // HR & Payroll entities audited by feature 005 (FR-030).
  EMPLOYEE
  EMPLOYEE_DOCUMENT
  EMPLOYEE_TRANSFER
  ATTENDANCE
  HOLIDAY
  PAYROLL_RUN
  LOAN
  EXIT_RECORD
  TAX_DECLARATION
  SALARY_ADVANCE

  // Partners entities audited by feature 007 (FR-013).
  VENDOR
  VENDOR_CATEGORY
  CONTRACTOR_PROFILE
  CONTRACTOR_DOCUMENT
  MONTHLY_COMPLIANCE
  BOCW_PAYMENT

  // Projects entities audited by feature 008 (contracts/projects-api.md "Audit
  // logging"). PROJECT covers create/edit and the lock/unlock transition — the
  // transition is an ordinary UPDATE whose before/after payload carries `isLocked`,
  // rather than a distinct action, so a reader sees who froze a project in the same
  // place they see who changed its contract value.
  PROJECT
  CLIENT
  SITE
  BOQ_GROUP
  BOQ_ITEM
  /// One tender import, as one act (008 FR-014, amended 2026-10-03).
  ///
  /// Separate from BOQ_GROUP and BOQ_ITEM on purpose: those describe rows, and an import that
  /// logged one entry per row would put 231 entries in the log and bury whatever came next. The
  /// entry carries the batch, the counts and whether the quoted percentage was set.
  BOQ_IMPORT
  DWR
  REVENUE
  RA_BILL
  WORK_ORDER
  PROJECT_BUDGET
  PROJECT_DOCUMENT

  /// Feature 004's reminders engine. Only the snooze is audited (FR-034): evaluation
  /// itself is a read, and emitting a notification is already recorded by the
  /// `ReminderNotification` ledger, which carries more than an audit row could.
  REMINDER

  // Labour entities audited by feature 013 (FR-039). Skill Category is a
  // `settings`-schema master but 013 is what creates and audits it, mirroring how
  // 009's ITEM/ITEM_CATEGORY sit outside the Settings block above.
  SKILL_CATEGORY
  WAGE_RATE
  LABOUR_WORKER
  LABOUR_GANG
  MUSTER_ROLL
  LABOUR_PAYMENT_SHEET
  LABOUR_ADVANCE

  // Plant & Machinery entities audited by feature 006 (FR-012) and its spare-parts
  // amendment (FR-028). The three masters sit here rather than under the Settings
  // block because 006 is what creates and audits them, even though the tables are
  // `settings`-schema masters — the same arrangement `ITEM_CATEGORY` has.
  EQUIPMENT
  EQUIPMENT_DOCUMENT
  LOGBOOK_ENTRY
  FUEL_ENTRY
  /// 020 FR-002: a reviewer's decision about a fuel variance. The entity is the decision,
  /// not the reading — the reading is evidence and is never altered by a review (FR-017).
  FUEL_VARIANCE_EXCEPTION
  SERVICE_SCHEDULE
  MAINTENANCE_JOB
  HIRE_BILL
  EQUIPMENT_CATEGORY
  EQUIPMENT_DOC_TYPE
  HIRE_RATE
  SPARE_PART
  SPARE_PART_MOVEMENT
  SERVICE_BILL

  // Recruitment & Onboarding entities audited by feature 011 (FR-032). LETTER
  // generation and candidate PII reads are audited on READ as well as write.
  REQUISITION
  CANDIDATE
  INTERVIEW
  OFFER
  ONBOARDING_ITEM
  LETTER
  RESIGNATION

  /// Feature 004 (US7): the one write path Dashboard owns — a report export's
  /// creation and completion (contracts/dashboard-api.md "Audit logging").
  REPORT_EXPORT

  // Project Assets entities audited by feature 012 (FR-034). The three masters sit
  // here rather than under the Settings block for the same reason 006's and 009's do
  // — 012 is what creates and audits them, even though the tables are
  // `settings`-schema masters. FR-034 names the six operational types; the three
  // master types are added beyond it because every other module audits its own
  // masters and omitting them would leave a category edit unaccountable.
  ASSET
  ASSET_ALLOCATION
  ASSET_TRANSFER
  ASSET_REQUEST
  ASSET_INSPECTION
  ASSET_REPAIR
  ASSET_CATEGORY
  ASSET_DOC_TYPE
  CONDITION_GRADE

  // Feature 016's approval spine (016 FR-002, FR-003, research.md §6).
  //
  // Note what is NOT here: the decisions themselves. `ApprovalDecision` is the spine's
  // own table because "who is this waiting on" is read on every render of an item, and
  // serving that by replaying an append-only forensic log would make the log
  // load-bearing on the hot path.
  //
  // These three are the off-path, security-adjacent records: a decision worth
  // cross-referencing from the activity log, every *refused* attempt (FR-003), and any
  // change to who is allowed to approve what.
  APPROVAL_DECISION
  APPROVAL_REFUSED
  APPROVAL_CHAIN_CONFIG

  @@schema("shared")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  /// Added by feature 003: Principle IV puts biometric data in the same protection
  /// tier as Aadhaar/PAN, where every *access* is accountable, not just every change
  /// (research.md §8). CREATE/UPDATE/DELETE cannot express "someone looked at this".
  READ

  // Login-lifecycle actions — the action *is* the event for these.
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  LOGOUT
  REFRESH_REUSE_DETECTED
  ADMIN_PASSWORD_RESET

  @@schema("shared")
}

// ============================================================================
// projects schema — feature 003 (My Workspace) adds only the slice of Site that
// attendance needs. A later Projects feature owns the rest of a site's data and is
// expected to extend this model rather than redefine it (research.md §1).
// ============================================================================

/// A construction site: the geofence centre a punch is validated against, plus the
/// non-working-day calendar that attendance-status computation reads.
///
/// Lives in `projects`, not `hr`, even though this feature is its only current
/// consumer — a site is a projects-module concept per the constitution's module
/// list, and putting it in `hr` would misplace a concept that already has a home
/// (research.md §1). `hr` reaches it only through `SitesService`.
model Site {
  id        String @id @default(cuid())
  /// RLS-protected. No Prisma relation to `settings.Company` on purpose: Principle I
  /// routes every cross-module read through the owning module's exported service, and
  /// declaring a relation here is what would make an accidental cross-schema join
  /// possible in the first place. Same rationale as `shared.User.companyId`.
  companyId String

  name String

  /// Geofence centre. Decimal, not Float — 7 decimal places is ~1 cm of latitude, and
  /// binary floating point would make a boundary punch's in/out verdict depend on
  /// representation error rather than on where the worker actually stood.
  latitude             Decimal @db.Decimal(10, 7)
  longitude            Decimal @db.Decimal(10, 7)
  geofenceRadiusMeters Int

  /// Day-of-week treated as Weekly Off, 0 = Sunday (research.md §6).
  weeklyOffDay Int

  /// ── Added by feature 008. Every column below is nullable or defaulted, so the
  /// migration is additive and the rows 003 already created stay valid. The four
  /// columns above are deliberately untouched: HR reads them through
  /// `SitesService.getGeofence()`/`.getWeeklyOffDay()` on every punch, and widening
  /// them to nullable would push a null check into that hot path for no gain.

  /// The project this site belongs to. Nullable because sites created by 003 predate
  /// the Project table entirely, and a site can legitimately outlive its project.
  /// `SetNull` rather than `Cascade`: deleting a project must not silently delete the
  /// attendance geofence its workers are still punching against.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Postal address, distinct from the geofence centre — the coordinates say where a
  /// punch counts, this says where to send a delivery.
  address String?

  status SiteStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([projectId])
  @@schema("projects")
}

// ============================================================================
// projects schema — feature 008 (Projects: portfolio, clients, sites, BOQ, DWR,
// revenue, P&L). Site above is 003's, extended in place rather than replaced.
//
// Cross-schema references (`projectManagerEmployeeId`, `supervisorEmployeeId`,
// `partnerId`, `approvedByUserId`) are stored as bare ids with no Prisma relation,
// the same rule `Site.companyId` follows: Principle I routes every cross-module read
// through the owning module's exported service, and a declared relation is precisely
// what would make an accidental cross-schema join possible.
// ============================================================================

enum SiteStatus {
  active
  inactive

  @@schema("projects")
}

enum ClientStatus {
  active
  inactive

  @@schema("projects")
}

enum ProjectStatus {
  planning
  ongoing
  on_hold
  completed

  @@schema("projects")
}

enum ProjectDivision {
  contract
  own

  @@schema("projects")
}

enum ProjectSiteType {
  site
  toll
  plant

  @@schema("projects")
}

enum DwrWeather {
  clear
  rainy
  overcast

  @@schema("projects")
}

enum DwrStatus {
  draft
  submitted
  approved

  @@schema("projects")
}

enum DwrPaymentMode {
  work_basis
  day_basis

  @@schema("projects")
}

enum RevenueStatus {
  received
  pending

  @@schema("projects")
}

enum RaBillStatus {
  draft
  submitted
  approved

  @@schema("projects")
}

enum WorkOrderStatus {
  draft
  active
  completed

  @@schema("projects")
}

enum ProjectBudgetCategory {
  labour
  materials
  machinery
  fuel
  subcontractors
  overheads

  @@schema("projects")
}

/// The party a project is executed for.
model Client {
  id        String @id @default(cuid())
  /// RLS-protected. Bare id, not a relation — see the note on `Site.companyId`.
  companyId String

  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  /// Unique per company *when present*. Enforced by a partial unique index rather
  /// than `@@unique`, which in Postgres treats every NULL as distinct and would
  /// therefore admit unlimited GSTIN-less clients — correct here, but only by
  /// accident. The partial index in the migration states the rule explicitly.
  gstin         String?
  /// The two the running-account bill's statutory header needs and this table did not carry
  /// (025 FR-039). Until they existed, every bill issued to a client reported `issuerPan` and
  /// `issuerState` as missing, and the intra/inter-state tax decision had no client state code to
  /// read — so it fell back to `Project.cgstApplicable` on every single bill rather than deriving
  /// the basis from the two parties' GSTINs the way 023 FR-015 describes.
  ///
  /// Both nullable: a client recorded before this existed is not wrong, and refusing to issue a
  /// bill for a missing PAN is worse than issuing one with a blank somebody fills in by hand —
  /// which is the rule the header has followed since 023 and this does not change.
  pan           String?
  /// Two-digit GST state code, as the GSTIN's own first two characters spell it (`08` is
  /// Rajasthan). Stored as text, never an integer: `08` is not 8.
  state         String?

  status ClientStatus @default(active)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@schema("projects")
}

/// A construction project: the root every BOQ item, work report, bill and cost row
/// in this schema ultimately hangs off.
model Project {
  id        String @id @default(cuid())
  companyId String

  /// Allocated from the company's PROJECTS series by `CodeSeriesService` when the
  /// caller omits it, so two concurrent creates can never collide.
  code String
  name String

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  location      String?
  /// Decimal, not Float: this is money, and it is the denominator of every margin
  /// percentage the P&L reports.
  contractValue Decimal @db.Decimal(18, 2)

  /// The **quoted percentage** above or below the BOQ's own total (018 FR-002a, added 2026-10-02).
  ///
  /// Read off `docs/BOQ_794578.xls`, which the client supplied and which is a government e-tender
  /// **"Percentage BoQ"**: the bidder does not quote per line. They quote one percentage against the
  /// schedule of rates, and the file's own footer shows it — `Total in Figures` 2,99,61,506.78
  /// becoming `Quoted Rate in Figures` 3,06,98,559.85 at `Excess (+) 0.0246`.
  ///
  /// **A bill priced from the line rate alone under-bills by exactly this percentage, on every line.**
  /// On that file that is ₹7.37 lakh on a ₹3 crore project — invisible per line and material in total,
  /// which is the worst shape a billing error can take. Stored on the project because it applies to
  /// the whole award, not per line.
  ///
  /// A fraction, not a percentage: `0.0246` is +2.46%, matching the file. Signed, because the same
  /// column carries a `Less (-)` quote. Default 0 means "at par", which is both the common case and
  /// the safe one — it prices from the schedule exactly.
  quotedPercentage Decimal @default(0) @db.Decimal(8, 6)

  startDate       DateTime
  expectedEndDate DateTime?

  status ProjectStatus @default(planning)

  /// `hr.Employee.id`, resolved through `EmployeesService` on the reads that need a
  /// name. Bare id — see the schema-level note above.
  projectManagerEmployeeId String?

  division       ProjectDivision @default(contract)
  departmentType String?
  projectType    String?
  siteType       ProjectSiteType @default(site)
  isHO           Boolean         @default(false)

  /// The freeze switch. Every write endpoint in this module passes through
  /// `ProjectLockGuard`, which refuses with 423 while this is true (research.md §6).
  isLocked Boolean @default(false)

  siteStartDate  DateTime?
  purchaseLimit  Decimal?  @db.Decimal(18, 2)
  orderNumber    String?
  cgstApplicable Boolean   @default(false)

  /// The **client contract's** retention term as a fraction — `0.050000` is 5% (023 FR-018).
  ///
  /// **Nullable with no default, deliberately.** Research §4 requires a missing rate to be a
  /// refusal rather than a default of zero: a silent zero produces a bill with no retention and a
  /// payable 5% too high, which is the error most likely to be paid before anybody notices. Null
  /// means nobody has recorded the term; `0` means the contract has none.
  ///
  /// **Why a project-level rate is right here when research §4 rejected project-level rates.** That
  /// objection was that two work orders on one project can carry different terms, so a rate on the
  /// project would quietly apply one contract's to another's bill. It does not reach the client
  /// direction: a project has exactly one client and one client agreement, so for that direction
  /// the project *is* the contract. A bill to a subcontractor still reads
  /// `WorkOrder.retentionPercent`, which is that subcontract's own term.
  clientRetentionFraction Decimal? @db.Decimal(8, 6)
  description             String?

  sites             Site[]
  boqTaskGroups     BOQTaskGroup[]
  dailyWorkReports  DailyWorkReport[]
  revenues          Revenue[]
  raBills           RABill[]
  clientBills       ClientBill[]
  workOrders        WorkOrder[]
  billPackages      BillPackage[]
  billPackageDebits BillPackageDebit[]
  budgets           ProjectBudget[]
  documents         ProjectDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([clientId])
  @@schema("projects")
}

/// A billable section of a project's Bill of Quantities.
model BOQTaskGroup {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  boqNo String
  name  String

  /// **Optional, and null means unplanned** (008 FR-037, amended 2026-10-03).
  ///
  /// A tender schedule of quantities carries no programme — the client's own e-tender sheet has
  /// quantity, unit and rate columns and no dates at all. Requiring these would mean inventing a
  /// programme at import time, and an invented finish date drives "Delayed" alerts that are fiction
  /// in the shape of fact. Planning is a separate act, performed later on the BOQ screen.
  startDate  DateTime?
  finishDate DateTime?
  scopeQty   Decimal   @db.Decimal(18, 3)
  isEstimate Boolean   @default(false)

  items BOQTaskItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@schema("projects")
}

/// One measurable line of work. `doneQty` is a running total that moves **only** when
/// a DWR is approved, never when it is submitted (research.md §13) — the two are
/// different claims, and counting a submission as progress is what makes a BOQ
/// disagree with the site.
model BOQTaskItem {
  id        String @id @default(cuid())
  companyId String

  groupId String
  group   BOQTaskGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  boqNo    String
  taskName String

  /// **The string the source carried, verbatim** (FR-041).
  ///
  /// Free text on purpose. The client's own file spells about 12 units 26 ways — `Cum`/`Cum.`,
  /// `Sqm`/`Sqm.`/`sqm`, `R Mtr.`/`R. Mtr.`/`R.Mtr.`/`R. mtr` — and a unit master would reject the
  /// file outright. Matching happens on a normalised form (`unit-normalise.ts`); what is stored is
  /// what they typed, because discarding it would make a later disagreement unarguable.
  unit     String
  scopeQty Decimal @db.Decimal(18, 3)

  /// **Optional, and null means unplanned** (FR-037, amended 2026-10-03). See `BOQTaskGroup`.
  ///
  /// `getAlerts` reports an unplanned line as **unplanned** — its own group, never folded into
  /// on-time or delayed (FR-048). Membership is decided by `finishDate` alone, so a line with some
  /// of these set still has exactly one home.
  startDate  DateTime?
  finishDate DateTime?
  /// Planned working days, used to derive the per-day target. Null where unplanned.
  duration   Int?
  /// An **override** for the rate needed to finish, not the source of it (FR-047). Where null, the
  /// needed rate is `pendingQty ÷ remaining days to finishDate`; the old definition measured
  /// against this column directly and would read every imported line as not-at-risk.
  perDayQty  Decimal?  @db.Decimal(18, 3)
  doneQty    Decimal   @default(0) @db.Decimal(18, 3)
  isEstimate Boolean   @default(false)

  /// The line's rate, which FR-002 prices a bill from (018 research §1) — `bugs.md` item 11.
  ///
  /// **Default 0, and that is not laziness.** The table is populated, so a required column cannot be
  /// added to it — and of the two ways to be wrong, a zero rate is *visibly* wrong on a bill while a
  /// guessed one is invisibly wrong. Billing refuses a line whose rate is still 0 with
  /// `BOQ_RATE_MISSING` rather than billing it at nothing.
  rate Decimal @default(0) @db.Decimal(18, 2)

  /// Whether this line is a variation rather than original scope (FR-015a).
  ///
  /// Carried on the line rather than inferred from a date, because a variation agreed in week two and
  /// a scope item added by a late correction look identical by timestamp and are different facts to
  /// a client.
  isVariation  Boolean @default(false)
  /// The variation order this line came in under, where there is one.
  variationRef String?

  dwrTasks        DWRTask[]
  clientBillLines ClientBillLine[]
  awardLines      WorkOrderBOQItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([groupId])
  @@schema("projects")
}

/// A day's site record. `draft → submitted → approved`; only the last transition
/// moves BOQ progress.
model DailyWorkReport {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workDate  DateTime
  dprNumber String

  /// `hr.Employee.id`. Bare id — see the schema-level note above.
  supervisorEmployeeId String?

  weather DwrWeather @default(clear)
  status  DwrStatus  @default(draft)

  workerCount    Int     @default(0)
  machineryCount Int     @default(0)
  /// Supervisor's own 0–100 assessment, distinct from the quantity-derived progress
  /// the BOQ computes — the two are reported separately rather than reconciled.
  progress       Int     @default(0)
  location       String?
  description    String?

  contractFor    String  @default("self")
  contractNumber String?
  rfiNo          String?
  layer          String?

  /// Who created the draft and who put it forward. `shared.User.id`, bare ids.
  ///
  /// **`submittedByUserId` is what makes 022 FR-012a enforceable at all.** Approval is a direct
  /// transition rather than a routed chain action (decision D2), and the control that replaces the
  /// chain is that the approver is not the person who submitted it — a site engineer may not
  /// certify their own claim. Without this column that rule has nothing to compare against: the
  /// audit log holds the act, but enforcing a refusal by querying an audit trail makes the trail
  /// load-bearing for correctness rather than for accountability, and a gap in it would silently
  /// become a permission.
  ///
  /// Submission rather than creation is the act that matters: a clerk may type a report up for a
  /// supervisor, and it is the person who put it forward as true who must not also certify it.
  createdByUserId   String?
  submittedByUserId String?
  submittedAt       DateTime?

  /// `shared.User.id`. Bare id — see the schema-level note above.
  approvedByUserId String?
  approvedAt       DateTime?

  /// Object-storage references, as 008 created them.
  ///
  /// **Superseded by `attachments` in 022 and kept only because dropping a column is not something
  /// an additive migration does.** A bare array of references cannot hold the name a file was
  /// uploaded under or the type it is, which 022 FR-009 requires — a download that arrives as a
  /// bare UUID with no extension is a defect this repository fixed once already, in 017, and the
  /// fix was columns for the name and the type. Empty in every row, and nothing reads it.
  fileRefs String[]

  attachments DWRAttachment[]

  /// The **latest** reversal of an approval (022 FR-019, FR-022).
  ///
  /// A report in `draft` carrying `reversedAt` was approved and taken back, which is a different
  /// thing from one never approved — and 022 FR-019 needs the two distinguishable. `approvedAt`
  /// and `approvedByUserId` are deliberately **not** cleared when this is set: the approval
  /// happened, and erasing it would leave a reversal reason referring to an approval nobody can
  /// see.
  ///
  /// Only the latest reversal lives here; the full sequence is in the audit log, which is the
  /// system of record for who did what. The count is kept rather than left to be reconstructed by
  /// counting audit entries, for the reason `RABill.revisionCount` gives: "this has been round
  /// three times" is what a reader wants, and having to count by hand is how a reader stops asking.
  reversedAt       DateTime?
  reversedByUserId String?
  /// Required by the service rather than by the column: a reversal moves a quantity a bill may
  /// already depend on.
  reversalReason   String?
  reversalCount    Int       @default(0)

  tasks DWRTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, dprNumber])
  @@index([companyId])
  @@index([projectId, workDate])
  @@schema("projects")
}

/// One measurement line within a work report.
///
/// Carries **one of two quantities**, decided by `paymentMode`: `actualQty` for work measured by
/// the six factors, computed server-side so the arithmetic cannot differ between clients, or
/// `servedQty` for a line paid by presence. Exactly one is non-null, enforced by the
/// `DWRTask_quantity_matches_basis` constraint (022 FR-030a).
model DWRTask {
  id String @id @default(cuid())

  dwrId String
  dwr   DailyWorkReport @relation(fields: [dwrId], references: [id], onDelete: Cascade)

  /// Nullable: a task can be freeform work that no BOQ line covers.
  boqItemId String?
  boqItem   BOQTaskItem? @relation(fields: [boqItemId], references: [id])

  layer        String?
  chainageFrom Decimal? @db.Decimal(18, 3)
  chainageTo   Decimal? @db.Decimal(18, 3)
  roadSide     String?

  paymentMode DwrPaymentMode @default(work_basis)

  /// The six measurement factors. All default to 1 so an unused dimension is
  /// multiplicatively neutral rather than zeroing the result.
  nos1    Decimal @default(1) @db.Decimal(18, 3)
  nos2    Decimal @default(1) @db.Decimal(18, 3)
  length  Decimal @default(1) @db.Decimal(18, 3)
  breadth Decimal @default(1) @db.Decimal(18, 3)
  depth   Decimal @default(1) @db.Decimal(18, 3)
  density Decimal @default(1) @db.Decimal(18, 3)

  /// nos1 × nos2 × length × breadth × depth × density, computed by the server.
  ///
  /// **Nullable since 022 (T002), and the nullability carries meaning.** This is the quantity of a
  /// *measured* line, and a presence-paid line has none — absence says "not measured", while 0
  /// says "measured as nothing". The client's real measurement sheets contain both, side by side,
  /// and collapsing them would lose the distinction every performance deduction is argued from.
  /// Non-null exactly when `paymentMode = work_basis`, enforced by
  /// `DWRTask_quantity_matches_basis` rather than by a service (022 FR-030a).
  ///
  /// Safe to loosen without a backfill: the table held 0 rows on 2026-10-04, because nothing could
  /// write one until 022 built the module 008 specified and left unimplemented.
  actualQty Decimal? @db.Decimal(18, 3)

  /// The day served on a presence-paid line: 1 for a full day, less for a part day (022 FR-030).
  ///
  /// **Why this is its own column and not `actualQty`.** Eleven of the seventeen line types in the
  /// client's real tender are paid for presence rather than measurement — an ambulance or a
  /// patrolling vehicle on a monthly rate, forty security guards a day — and the quantity claimed
  /// for a month is a fraction of it. The six factors above cannot express that: they all default
  /// to 1, so their product is 1, which *looks* exactly like one day served while being only an
  /// artefact of the defaults. A figure that is right by coincidence passes every test written the
  /// obvious way and turns wrong the moment somebody sets a factor.
  ///
  /// So the quantity in force is a stated property of the line (`paymentMode`) rather than an
  /// inference about which fields happen to be filled, and `dwr-quantity.ts` never reads the
  /// factors for a presence line at all (022 FR-030b, FR-030d).
  ///
  /// Non-null exactly when `paymentMode = day_basis`.
  servedQty Decimal? @db.Decimal(18, 3)

  /// `plant.Equipment.id`. Bare id — see the schema-level note above.
  ///
  /// The key the equipment's own logbook entry for the work date is read by (022 FR-032).
  /// `plant.LogbookEntry` already holds the opening and closing readings, the run and the day's
  /// remarks, unique per machine per date — which is precisely the odometer register printed
  /// beneath each of the client's measurement sheets. It is read across the module boundary through
  /// `ProjectSourcesRegistry` and **never copied here**: a second system of record for an odometer
  /// disagrees with the first the moment one is corrected.
  equipmentId String?

  /// Flagged, not refused: the site did the work, and a BOQ line that turns out to
  /// have been under-scoped is a commercial question, not a data-entry error.
  exceedsScope Boolean @default(false)

  engineerName String?
  remark       String?
  layerNo      String?
  section      String?

  @@index([dwrId])
  @@index([boqItemId])
  @@schema("projects")
}

/// One file attached to a day's work report (022 FR-009).
///
/// **A table rather than another string in `DailyWorkReport.fileRefs`.** An attachment is three
/// facts, not one: where the bytes are, what the file was called, and what type it is. 017 fixed
/// exactly this defect for project and company documents — files downloading as a bare UUID with
/// no extension, which a browser then refused to open — and the fix was to store the name and the
/// type rather than to sniff them back later. Repeating the array here would repeat the defect.
///
/// `uploadedByUserId` and `uploadedAt` are here because a photograph of a day's work is evidence,
/// and evidence whose provenance is unrecorded is weaker than evidence that has none.
model DWRAttachment {
  id        String @id @default(cuid())
  companyId String

  dwrId String
  dwr   DailyWorkReport @relation(fields: [dwrId], references: [id], onDelete: Cascade)

  /// Opaque `StorageService` reference. Never a URL or a path — see `StorageService.put`.
  fileRef   String
  /// As the uploader's own filesystem spelled it, so the download arrives named.
  fileName  String
  /// Detected from the bytes by `detectContentType`, not taken from the client's claim.
  mimeType  String
  sizeBytes Int

  /// `shared.User.id`. Bare id — see the schema-level note above.
  uploadedByUserId String?
  uploadedAt       DateTime @default(now())

  @@index([companyId])
  @@index([dwrId])
  @@schema("projects")
}

/// Money received or expected against a project, outside the RA bill process.
model Revenue {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal       @db.Decimal(18, 2)
  date        DateTime
  status      RevenueStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@schema("projects")
}

/// A running account bill. `draft → submitted → approved`, with `submitted → draft`
/// via reject; approved bills are immutable (research.md §7).
model RABill {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  billNumber  String
  description String?
  amount      Decimal      @db.Decimal(18, 2)
  billingDate DateTime
  status      RaBillStatus @default(draft)

  submittedAt      DateTime?
  /// `shared.User.id`. Bare id — see the schema-level note above.
  approvedByUserId String?
  approvedAt       DateTime?
  rejectionRemark  String?

  /// How many times this bill's quantities were revised **after** it was certified (018 FR-009).
  ///
  /// Kept as a count rather than left to be reconstructed from the audit trail: "this bill has been
  /// round three times" is what a reader wants, and counting approval instances by hand to find out
  /// is how a reader stops asking.
  revisionCount       Int       @default(0)
  /// FR-016 for the edit, which nothing recorded before Phase 4.
  lastRevisedAt       DateTime?
  lastRevisedByUserId String?

  /// The work order this bill measures against. Nullable for bills raised before 018 — their `amount`
  /// is the only figure they ever had, and inventing an award to attach them to would be a fiction.
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  /// **Gross, the three deductions, and net — each visible in its own right** (FR-008).
  ///
  /// Not one net figure. A subcontractor disputing a payment asks which deduction accounts for the
  /// difference, and a single `netPayable` cannot answer. Equally important for the P&L: retention is
  /// the company's money withheld and an advance recovery is money already paid, so **neither is a
  /// project cost** — a summary that treated net as spend would understate the project.
  grossAmount     Decimal @default(0) @db.Decimal(18, 2)
  retentionAmount Decimal @default(0) @db.Decimal(18, 2)
  advanceRecovery Decimal @default(0) @db.Decimal(18, 2)
  otherDeductions Decimal @default(0) @db.Decimal(18, 2)
  netPayable      Decimal @default(0) @db.Decimal(18, 2)

  lines   RABillLine[]
  /// The 023 package, where this bill has been made into one. A relation field, not a column.
  package BillPackage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Added by 027. A bill number was free text with nothing enforcing it, so two bills on one
  /// project could carry the same number — and two paths mint them: the RA bill sheet, where a
  /// person typed one, and 023's package path, which writes `RA-nn` into this column. `ClientBill`
  /// has carried the equivalent constraint since 018; this side simply never got it.
  @@unique([projectId, billNumber])
  @@index([companyId])
  @@index([projectId])
  @@index([workOrderId])
  @@schema("projects")
}

/// Work subcontracted on a project.
model WorkOrder {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The work order's own number — `PRPL-WO-0001` (027).
  ///
  /// **Nullable, and that is a migration artefact rather than a design choice.** The table is
  /// populated, so a required unique column cannot simply be added to it; the rows that predate
  /// this carry none and read by their detail as they always did. Every work order raised from
  /// here on is numbered, and the service allocates it the way every other series in this product
  /// is allocated.
  ///
  /// Unique per company, not globally: two companies number their own work orders independently,
  /// exactly as they do projects and vendors.
  code String?

  /// `partners.Vendor.id`, read through `PartnersService`. Bare id — see the
  /// schema-level note above.
  ///
  /// Nullable because it always has been and the existing rows carry nothing. 027 added the picker
  /// that sets it: the column shipped with 018 and **no screen ever wrote to it**, so every work
  /// order in the product was anonymous — the award, the bills and the retention all belonged to
  /// nobody in particular.
  partnerId String?

  workDetail   String
  terms        String?
  requirements String?
  hireContract String?

  labourAmount   Decimal @default(0) @db.Decimal(18, 2)
  materialAmount Decimal @default(0) @db.Decimal(18, 2)

  status WorkOrderStatus @default(draft)

  /// Retention withheld per RA bill, as a fraction. FR-008's first deduction.
  retentionPercent Decimal @default(0) @db.Decimal(8, 6)

  awardLines        WorkOrderBOQItem[]
  raBills           RABill[]
  retentionReleases RetentionRelease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([projectId])
  @@schema("projects")
}

/// A bill raised **to the client**, measured against the project's BOQ (018 US1) — `bugs.md` item 11.
///
/// ## Why its lines exist at all
///
/// `RABill` already held a single `amount`. Note 12's complaint is precisely that: a bill that is one
/// figure cannot be reconciled against a BOQ, so nobody could say what had been billed of which item,
/// and "support reconciliation against BOQ work order amounts and quantities" was unanswerable.
///
/// ## Cumulative quantity is never stored here
///
/// How much of a BOQ line has been billed to date is an **aggregate over the lines** (research §3).
/// A stored counter is a second copy of a derivable fact, and the two disagree the first time a bill
/// is deleted, corrected, or raised concurrently — at which point the over-scope check is wrong in
/// whichever direction nobody notices.
model ClientBill {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  billNumber  String
  description String?
  billingDate DateTime @db.Date

  /// The **quoted percentage frozen at composition**, alongside each line's frozen rate.
  ///
  /// The project's own percentage can be corrected; a submitted bill must keep the one it was priced
  /// at, for the same reason its lines keep theirs. A bill whose total moved after it went to the
  /// client is a bill nobody can reconcile against the payment that came back.
  quotedPercentage Decimal @default(0) @db.Decimal(8, 6)

  /// Gross of the lines, after the quoted percentage. Stored because a submitted bill is a document.
  grossAmount     Decimal @default(0) @db.Decimal(18, 2)
  /// Retention withheld by the client. **Not a project cost** — it is the client's money held back.
  retentionAmount Decimal @default(0) @db.Decimal(18, 2)
  /// Gross less retention and any other deduction. What the client is asked to pay.
  netAmount       Decimal @default(0) @db.Decimal(18, 2)

  /// What the client **certified**, which can be less than what was billed (FR-005).
  ///
  /// Null until certification. Kept **alongside** the billed figures and never instead of them: the
  /// variance between the two is the thing a project manager chases, and overwriting the billed
  /// amount with the certified one erases the fact that there was a shortfall.
  certifiedAmount Decimal?  @db.Decimal(18, 2)
  certifiedAt     DateTime?

  status ClientBillStatus @default(draft)

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines   ClientBillLine[]
  /// The 023 package, where this bill has been made into one. A relation field, not a column.
  package BillPackage?

  @@unique([projectId, billNumber])
  @@index([companyId])
  @@index([projectId, status])
  @@schema("projects")
}

enum ClientBillStatus {
  draft
  submitted
  certified

  @@schema("projects")
}

/// One BOQ line as billed on one client bill.
model ClientBillLine {
  id        String @id @default(cuid())
  companyId String

  clientBillId String
  clientBill   ClientBill @relation(fields: [clientBillId], references: [id], onDelete: Cascade)

  /// The BOQ line this measures. A bare id: `BOQTaskItem` is in this schema, but the relation is kept
  /// so a deleted BOQ line cannot orphan a billed figure.
  boqTaskItemId String
  boqTaskItem   BOQTaskItem @relation(fields: [boqTaskItemId], references: [id], onDelete: Restrict)

  /// Quantity billed **on this bill**. Cumulative is an aggregate — see `ClientBill`.
  quantity Decimal @db.Decimal(18, 3)

  /// **The BOQ rate frozen onto the line at composition** (FR-002).
  ///
  /// This is the assertion the whole feature turns on: revise the BOQ rate afterwards and a submitted
  /// bill does not move. A bill is a document that was sent; a rate table is a current opinion, and
  /// reading the second to render the first makes every historical bill a lie that changes shape.
  rate Decimal @db.Decimal(18, 2)

  /// `quantity × rate × (1 + quotedPercentage)`. Stored for the same reason the rate is frozen.
  amount Decimal @db.Decimal(18, 2)

  /// Whether this line takes the BOQ item past its scope quantity (FR-003).
  ///
  /// **A flag, not a refusal, at composition.** Over-measurement happens on real sites and is often
  /// correct; refusing it at entry means the measurement never gets recorded anywhere. The refusal is
  /// at *submit*, and only without a reason.
  exceedsScope    Boolean @default(false)
  /// Why the over-measurement is justified. Required to submit a bill carrying one.
  overScopeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The 023 claim recording how this line's quantity was chosen. A relation field, not a column.
  packageClaim BillPackageLineClaim?

  @@unique([clientBillId, boqTaskItemId])
  @@index([companyId])
  @@index([boqTaskItemId])
  @@schema("projects")
}

// ---------------------------------------------------------------------------------------------
// Feature 023 — the running-account bill package.
//
// A running-account bill is not an invoice with lines on it. It is a **package**: a check list, an
// abstract, a priced schedule, a measurement sheet for every item, and a debit-note register. The
// four tables below hold **only what `ClientBill` and `RABill` lack** — research §3. Their
// `grossAmount`, `retentionAmount` and `netAmount` stay the only home for those three figures,
// because a second copy of a figure is a copy that disagrees after the first correction, which this
// repository has now refused three times (018 research §3, 022 research §6, 022 FR-039b).
//
// **Why there are two bill tables and one package table**, rather than one bill table with a
// direction flag: the two directions measure **different schedules**. A bill to the client measures
// the project's own `BOQTaskItem` lines at the client's rate; a bill to a subcontractor measures
// that subcontractor's `WorkOrderBOQItem` award lines at the awarded rate. Those are different
// numbers for the same work — revenue and cost — and the margin between them is what 018's P&L
// exists to show. But the ~30 columns the *package* adds are identical for both, so they live once.
// ---------------------------------------------------------------------------------------------

/// One bill made into a package, for one period, in one direction (023 FR-001).
model BillPackage {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  direction BillDirection

  /// Exactly one of these two is set, matching `direction`, enforced by
  /// `BillPackage_one_bill_matching_direction` in the migration (data-model.md).
  ///
  /// Prisma's schema language cannot express a constraint spanning two nullable references, so the
  /// `CHECK` is appended to the generated migration — plan.md's tracked deviation. A package
  /// attached to both bills, or to neither, would produce a document whose figures belong to one
  /// bill and whose lines belong to another, and the thing it protects is a money document.
  clientBillId String?     @unique
  clientBill   ClientBill? @relation(fields: [clientBillId], references: [id], onDelete: Cascade)
  raBillId     String?     @unique
  raBill       RABill?     @relation(fields: [raBillId], references: [id], onDelete: Cascade)

  /// **Both inclusive** (FR-001). The client's cycle runs the 21st to the 20th, so a period is two
  /// stored dates and not a month anybody can derive from one.
  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date

  /// **Which counterparty this bill is to**: the project's client for `to_client`, the work order
  /// for `to_subcontractor`.
  ///
  /// Denormalised onto the package rather than reached through the bill, for two reasons that are
  /// the same reason. FR-002's overlap check is "the same schedule to the same counterparty" — one
  /// project is billed to its client and to several subcontractors over the same month,
  /// legitimately — and the running number is per counterparty too: the client's own package is
  /// "RA-12" for *that* subcontractor. Keyed on the project and direction alone, two
  /// subcontractors on one project would share one series, so A's bills would be RA-01 and RA-03
  /// while B's were RA-02 and RA-04, and neither party's file would make sense.
  counterpartyKey String

  /// The package's running number — the "12" of "RA-12". Per project, per direction, per
  /// counterparty.
  sequenceNo Int

  // --- Frozen rates (FR-019, FR-023, research §4) -------------------------------------------
  //
  // Each is recorded **per bill** rather than read at render time. 5 % retention is a contract term
  // and 2 % tax deducted and 9 % tax are statutes, and all three change — so a bill issued in March
  // must still recompute identically in September, which is only true if the rate travels with it.

  retentionFraction Decimal @db.Decimal(8, 6)
  cgstFraction      Decimal @db.Decimal(8, 6)
  sgstFraction      Decimal @db.Decimal(8, 6)
  igstFraction      Decimal @db.Decimal(8, 6)
  tdsFraction       Decimal @db.Decimal(8, 6)

  /// Which tax applies, **and how that was decided** (FR-016, FR-016a, research §5).
  ///
  /// The source is stored because a client record carries no `state` today, so for a bill issued to
  /// a client the fallback to the project's flag is the likely path rather than the exceptional one.
  /// A fallback recorded and shown to nobody is a tax decision nobody made.
  taxBasis       BillTaxBasis
  taxBasisSource BillTaxBasisSource

  // --- This period's figures (FR-013, FR-017) -----------------------------------------------
  //
  // Every named recovery and deduction is its own column, reported in its own right whether or not
  // it carries an amount. Not one `otherDeductions` bucket: a subcontractor disputing a payment asks
  // which deduction accounts for the difference, and a bucket cannot answer.

  workDone        Decimal @default(0) @db.Decimal(18, 2)
  releaseWithheld Decimal @default(0) @db.Decimal(18, 2)
  cgstAmount      Decimal @default(0) @db.Decimal(18, 2)
  sgstAmount      Decimal @default(0) @db.Decimal(18, 2)
  igstAmount      Decimal @default(0) @db.Decimal(18, 2)

  recoveryDiesel    Decimal @default(0) @db.Decimal(18, 2)
  debitAgainstCivil Decimal @default(0) @db.Decimal(18, 2)
  otherRecoveries   Decimal @default(0) @db.Decimal(18, 2)
  mechanicalDebit   Decimal @default(0) @db.Decimal(18, 2)

  mobilizationAdvance Decimal @default(0) @db.Decimal(18, 2)
  retentionAmount     Decimal @default(0) @db.Decimal(18, 2)
  performanceSecurity Decimal @default(0) @db.Decimal(18, 2)
  theftWithheld       Decimal @default(0) @db.Decimal(18, 2)

  tdsAmount Decimal @default(0) @db.Decimal(18, 2)
  /// Work total less recoveries, less deductions, less tax deducted. **May be negative** (FR-022):
  /// a bill whose debits exceed its work is a real outcome the client's own format expresses.
  payable   Decimal @default(0) @db.Decimal(18, 2)

  /// What each one-time recovery **totals** (FR-020).
  ///
  /// Added after `checklists/silent-failure.md` CHK021 found FR-020 satisfiable by doing nothing:
  /// without a recorded total, a deduction that is fully recovered and one somebody entered as zero
  /// this month are the same row. Recovered-to-date is the `…UptoDate` cumulative below, so the
  /// target was the only missing half. Nullable because a contract may carry neither.
  mobilizationAdvanceTotal Decimal? @db.Decimal(18, 2)
  performanceSecurityTotal Decimal? @db.Decimal(18, 2)

  // --- Frozen cumulative position (FR-014a, decision D1) -------------------------------------
  //
  // Stored at issue, so every bill is reproducible from itself for ever and the package always
  // agrees with the signed copy the client holds. The next bill reads these.
  //
  // **The up-to-previous column is not here, and is not derived from this row either** (FR-013a).
  // It is the *previous* bill's `…UptoDate`, read across the chain. Deriving it as this bill's
  // up-to-date less its own amount is numerically equal only while the chain is unbroken — and it
  // makes FR-035's footer identity a rearrangement of its own definition, true for any values
  // whatever. The identity has to be able to fail or it is not worth asserting.

  workDoneUptoDate            Decimal @default(0) @db.Decimal(18, 2)
  releaseWithheldUptoDate     Decimal @default(0) @db.Decimal(18, 2)
  cgstAmountUptoDate          Decimal @default(0) @db.Decimal(18, 2)
  sgstAmountUptoDate          Decimal @default(0) @db.Decimal(18, 2)
  igstAmountUptoDate          Decimal @default(0) @db.Decimal(18, 2)
  recoveryDieselUptoDate      Decimal @default(0) @db.Decimal(18, 2)
  debitAgainstCivilUptoDate   Decimal @default(0) @db.Decimal(18, 2)
  otherRecoveriesUptoDate     Decimal @default(0) @db.Decimal(18, 2)
  mechanicalDebitUptoDate     Decimal @default(0) @db.Decimal(18, 2)
  mobilizationAdvanceUptoDate Decimal @default(0) @db.Decimal(18, 2)
  retentionAmountUptoDate     Decimal @default(0) @db.Decimal(18, 2)
  performanceSecurityUptoDate Decimal @default(0) @db.Decimal(18, 2)
  theftWithheldUptoDate       Decimal @default(0) @db.Decimal(18, 2)
  tdsAmountUptoDate           Decimal @default(0) @db.Decimal(18, 2)
  payableUptoDate             Decimal @default(0) @db.Decimal(18, 2)

  // --- Frozen statutory header (FR-026, FR-028) ----------------------------------------------
  //
  // Copied from `settings.Company`, `partners.Vendor` or `projects.Client` **at issue** and never
  // re-read. That is what makes "a bill produced twice is identical" true rather than hoped for: a
  // renderer reading the party records live would produce a different document after an address
  // change, and the one in the client's file would stop matching.

  issuerName          String?
  issuerGstin         String?
  issuerPan           String?
  issuerState         String?
  issuerAddress       String?
  receiverName        String?
  receiverGstin       String?
  receiverPan         String?
  receiverState       String?
  receiverAddress     String?
  receiverCode        String?
  natureOfWork        String?
  location            String?
  /// References the counterparty's own systems assign, recorded rather than generated.
  externalWorkOrderNo String?
  externalBillNo      String?

  /// What could not be filled (FR-027, FR-027a). **Reported, never a refusal** — a bill that cannot
  /// be produced because a permanent account number is unrecorded is worse than one produced with a
  /// gap somebody fills by hand.
  missingHeaderFields String[]

  /// `draft` → `issued` → `certified`, and `draft` → `abandoned`.
  ///
  /// **`abandoned` exists because a package in any status occupies its period** (FR-002a, FR-002b).
  /// Without it a mistakenly-opened draft holds that period for ever and the only remedy is deleting
  /// the row that records the period was billed — which FR-044a forbids for an issued bill and this
  /// status makes unnecessary for a draft.
  status BillPackageStatus @default(draft)

  issuedAt       DateTime?
  /// `shared.User.id`. Bare id — see the schema-level note.
  issuedByUserId String?

  /// FR-046, following `RABill.revisionCount`'s precedent: a count rather than something to be
  /// reconstructed from the audit trail.
  revisionCount       Int       @default(0)
  lastRevisedAt       DateTime?
  lastRevisedByUserId String?
  lastRevisionReason  String?

  claims           BillPackageLineClaim[]
  checkListAnswers BillPackageCheckListAnswer[]
  recoveredDebits  BillPackageDebit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// So "RA-12" means one thing — to one counterparty.
  @@unique([projectId, direction, counterpartyKey, sequenceNo])
  @@index([companyId])
  /// FR-002's overlap check, which is per schedule and per counterparty rather than per project.
  @@index([projectId, direction, counterpartyKey, periodFrom, periodTo])
  @@schema("projects")
}

enum BillDirection {
  to_client
  to_subcontractor

  @@schema("projects")
}

enum BillTaxBasis {
  intra_state
  inter_state

  @@schema("projects")
}

enum BillTaxBasisSource {
  derived_from_gstin
  from_project_flag

  @@schema("projects")
}

enum BillPackageStatus {
  draft
  issued
  certified
  abandoned

  @@schema("projects")
}

/// How one line's claimed quantity came to be chosen (023 FR-005, research §2).
///
/// A separate table rather than four columns on each of the two line tables: the proposal, reason,
/// variance and over-claim flag are identical for both directions, and a bill composed without a
/// package — which 018's service can still do — has no proposal to record, so the columns would be
/// permanently null on half the rows that could exist.
model BillPackageLineClaim {
  id        String @id @default(cuid())
  companyId String

  packageId String
  package   BillPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  /// Exactly one of these two, matching the package's direction.
  clientBillLineId String?         @unique
  clientBillLine   ClientBillLine? @relation(fields: [clientBillLineId], references: [id], onDelete: Cascade)
  raBillLineId     String?         @unique
  raBillLine       RABillLine?     @relation(fields: [raBillLineId], references: [id], onDelete: Cascade)

  /// What feature 022's approved measurement proposed, **as at composition**. A point-in-time fact.
  ///
  /// **Null means there was no measurement to read** (FR-003a), which is not what zero says. Zero
  /// says the measurement was read and was nothing. The two diverge on the subcontractor direction:
  /// a bill there measures award lines, `WorkOrderBOQItem.boqTaskItemId` is nullable by design
  /// because a subcontract may itemise work differently, and measurement is attributed to BOQ lines
  /// — so an unmapped award line has no source at all. Proposing zero for it would say "no work was
  /// done this month" for every unmapped line of every bill, on the direction billed monthly.
  proposedQty    Decimal?            @db.Decimal(18, 3)
  proposalSource ClaimProposalSource

  claimedQty Decimal @db.Decimal(18, 3)

  /// `claimedQty − proposedQty`. **Stored, not derived**, and null exactly when `proposedQty` is.
  ///
  /// Stored because the proposed figure can move afterwards — which is the case FR-014b exists for —
  /// so a recomputed variance would answer a different question than the engineer was looking at.
  /// Null rather than zero against a null proposal: there is no variance from a figure that was
  /// never proposed, and zero would say the claim matched a proposal it did not have.
  varianceQty Decimal? @db.Decimal(18, 3)

  /// Required when the variance is non-zero (FR-004, FR-006), and **cleared** when a later edit
  /// returns the claim to its proposal (FR-004a) — a reason beside a zero variance argues on the
  /// measurement sheet for a deduction the bill does not make.
  reason String?

  /// Set when `claimedQty > proposedQty` (FR-006, decision D2).
  ///
  /// A claim against `no_measurement_source` is **not** an over-claim: nothing was exceeded, and
  /// counting it would turn FR-006a's count into a count of unmapped award lines — which is the
  /// mitigation D2 depends on, so it has to count the thing it claims to.
  overClaimed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  /// So FR-006a's count is a query rather than a scan.
  @@index([packageId, overClaimed])
  @@schema("projects")
}

enum ClaimProposalSource {
  approved_measurement
  no_measurement_source

  @@schema("projects")
}

/// The debit-note register (023 FR-036 to FR-040a).
///
/// Recorded once against a project and recovered on **one** bill. The register spans bills rather
/// than belonging to one, because the running total is the point of it.
model BillPackageDebit {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// "Debit against the ATMS Equipment Missing at site" (FR-040). Grouped rather than listed flat,
  /// because the heading is how the register is read.
  groupHeading String?
  description  String
  /// "KM.226 LHS".
  location     String?

  /// Present where the debit has them; the real register uses different ones per line.
  nos      Decimal? @db.Decimal(18, 3)
  length   Decimal? @db.Decimal(18, 3)
  width    Decimal? @db.Decimal(18, 3)
  quantity Decimal? @db.Decimal(18, 3)
  unit     String?

  rate          Decimal @db.Decimal(18, 2)
  amount        Decimal @db.Decimal(18, 2)
  /// **Carried rather than computed**: the real register shows both, and the tax on a debit is not
  /// always the bill's own rate.
  amountWithTax Decimal @db.Decimal(18, 2)

  /// Null until applied. A debit moves from null to a value **once** (FR-037), enforced by a
  /// conditional update whose row count the service checks — the shape 022 used for its status
  /// transitions. The rule has to hold where concurrent writers meet it (FR-037a) and not only in a
  /// service that reads before it writes, because a debit recovered twice is money taken twice.
  recoveredOnPackageId String?
  recoveredOnPackage   BillPackage? @relation(fields: [recoveredOnPackageId], references: [id], onDelete: SetNull)

  /// `shared.User.id`. Bare id — see the schema-level note.
  recordedByUserId String?
  /// Also what makes an **issued** bill's register the register *as at issue* (FR-039a):
  /// `recordedAt <= BillPackage.issuedAt`. Without that, FR-039's running total and FR-028's frozen
  /// workbook contradict each other and a debit recorded between two productions of a signed bill
  /// changes it.
  recordedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, projectId])
  @@index([recoveredOnPackageId])
  @@schema("projects")
}

/// One of the six fixed check-list questions, answered for one package (023 FR-041 to FR-043a).
///
/// The **questions themselves are a constant in code**, not rows: the client reads them by position
/// and their wording is part of the format rather than this system's data.
model BillPackageCheckListAnswer {
  id        String @id @default(cuid())
  companyId String

  packageId String
  package   BillPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  /// One of six fixed keys, from `check-list.ts`.
  questionKey String

  /// **Nullable** — an unanswered question is distinguishable from one answered `no` (FR-042),
  /// which a boolean could not express. It never refuses an issue (FR-043); the gaps are reported.
  answer CheckListAnswer?

  /// `shared.User.id`. Bare id — see the schema-level note.
  answeredByUserId String?
  answeredAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([packageId, questionKey])
  @@index([companyId])
  @@schema("projects")
}

enum CheckListAnswer {
  yes
  no
  not_required

  @@schema("projects")
}

/// A line of the **award** to a subcontractor — their rate, not the client's (018 US2).
///
/// Separate from `BOQTaskItem` because the two are different numbers for the same work: the client's
/// BOQ rate is revenue and the subcontractor's awarded rate is cost, and the margin between them is
/// the thing item 11's P&L exists to show. Holding one column and calling it "the rate" would make
/// that margin unrepresentable.
/// Retention paid back to a subcontractor (018 FR-016a, Phase 7).
///
/// **An explicit act, never a schedule.** Confirmed by the client on 2026-10-03, who were offered
/// two automatic schedules — half at practical completion and half after defects, and a fixed
/// number of days — and chose the manual release. The reasoning holds beyond their answer: terms
/// vary by contract, and a schedule guessed wrong does not fail loudly. It quietly withholds money
/// that was due or releases money that was not, and nobody notices until the subcontractor does.
///
/// Append-only, like every other ledger in this product. A release is money leaving, and correcting
/// one by editing the row would leave no trace that it had been for a different amount yesterday.
model RetentionRelease {
  id        String @id @default(cuid())
  companyId String

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  /// Always positive. The service refuses a release exceeding what is still held, so the balance
  /// can never be driven negative by a release — only by a bill being deleted beneath it, which
  /// `onDelete: Restrict` on the bill lines already prevents.
  amount Decimal @db.Decimal(18, 2)

  /// The day the money went back, which is not necessarily the day somebody recorded it.
  releasedOn DateTime @db.Date

  /// Why now. Required by the service rather than by the column: an optional reason on a path that
  /// moves money is an empty field, and "which milestone was this against" is the first question
  /// anybody asks six months later.
  reason String?

  releasedByUserId String?

  createdAt DateTime @default(now())

  @@index([companyId, workOrderId])
  @@schema("projects")
}

model WorkOrderBOQItem {
  id        String @id @default(cuid())
  companyId String

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  /// The client-side BOQ line this work corresponds to, where it corresponds to one. Nullable: a
  /// subcontract can cover work the client's BOQ itemises differently, and forcing a match would make
  /// somebody invent one.
  boqTaskItemId String?
  boqTaskItem   BOQTaskItem? @relation(fields: [boqTaskItemId], references: [id], onDelete: SetNull)

  description String
  unit        String
  /// Awarded quantity. What `remaining` on a measured bill is counted down from.
  awardedQty  Decimal @db.Decimal(18, 3)
  /// The subcontractor's rate.
  rate        Decimal @db.Decimal(18, 2)

  billLines RABillLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([workOrderId])
  @@schema("projects")
}

/// One awarded line as measured on one RA bill (FR-007).
model RABillLine {
  id        String @id @default(cuid())
  companyId String

  raBillId String
  raBill   RABill @relation(fields: [raBillId], references: [id], onDelete: Cascade)

  workOrderBoqItemId String
  workOrderBoqItem   WorkOrderBOQItem @relation(fields: [workOrderBoqItemId], references: [id], onDelete: Restrict)

  /// Measured **this period**. To-date and remaining are aggregates over these rows, for the reason
  /// `ClientBill` gives: a stored counter is a second copy that disagrees after the first correction.
  quantity Decimal @db.Decimal(18, 3)
  /// The awarded rate, frozen onto the line. Same reasoning as `ClientBillLine.rate`.
  rate     Decimal @db.Decimal(18, 2)
  amount   Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The 023 claim recording how this line's quantity was chosen. A relation field, not a column.
  packageClaim BillPackageLineClaim?

  @@unique([raBillId, workOrderBoqItemId])
  @@index([companyId])
  @@index([workOrderBoqItemId])
  @@schema("projects")
}

/// Budgeted spend per cost category, one row per category per project. Compared
/// against actuals sourced live from the owning modules — never stored here.
model ProjectBudget {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category ProjectBudgetCategory
  amount   Decimal               @db.Decimal(18, 2)

  updatedAt DateTime @updatedAt

  @@unique([projectId, category])
  @@index([companyId])
  @@schema("projects")
}

/// A file attached to a project, stored as an object-storage reference rather than
/// bytes — same pattern as `hr.EmployeeDocument`.
/// A document uploaded **before** the project it belongs to exists (017 FR-009b, plan D10).
///
/// **This table is the cost of the word "cannot".** FR-009 says a project is not created while a
/// mandatory kind has no document attached — so the documents have to exist before the project
/// does, and there is nowhere to hang them. A row here is a file in escrow: uploaded, attributed,
/// and waiting for the creation that will either consume it or leave it to be swept.
///
/// `uploadedBy` is an **authorisation input**, not attribution (FR-009c, plan D10a). Project
/// creation refuses a staged id whose `uploadedBy` is not the calling user, and refuses it with the
/// same error code as a nonexistent id — so the refusal cannot be used to discover that another
/// user's staged document exists. A column read for access control needs more care than one read
/// for display, which is why this is said here rather than left to the service.
///
/// Rows are swept with their blobs after the staging window (FR-009d). A file uploaded for a
/// project nobody went on to create must not sit in storage indefinitely.
model StagedProjectDocument {
  id        String @id @default(cuid())
  companyId String

  /// Null for a supplementary document — the same meaning it has on `ProjectDocument`.
  documentTypeId String?

  /// The kind's label as the uploader saw it, kept so a refusal can name the kind even if the
  /// type is renamed or removed between staging and creation.
  documentType String

  fileRef  String
  filePath String?

  /// Carried through to the `ProjectDocument` the creation promotes this into, so a document
  /// staged before its project existed is not the one that downloads without a name.
  fileName String?
  mimeType String?

  /// Who staged it. Checked on use, not merely recorded — see the note above.
  uploadedBy String

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@schema("projects")
}

model ProjectDocument {
  id        String @id @default(cuid())
  companyId String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  documentType String

  /// `settings.DocumentType.id` as a BARE STRING, for the same reason
  /// `ProjectDocumentRequirement.documentTypeId` is one — see the note there.
  ///
  /// Added by 017. `documentType` above is free text with no defined vocabulary, so it
  /// cannot answer "does this project hold its work order?": two people typing "Work
  /// Order" and "work order" would be filing against different kinds and readiness would
  /// quietly disagree with itself. This column is the key readiness matches on; the free
  /// text stays as the label 008 intended it to be.
  ///
  /// Nullable because acceptance scenario 5 requires it: a document that answers no
  /// required kind is accepted and filed as supplementary, and null is what
  /// "supplementary" means here rather than a second flag saying the same thing.
  documentTypeId String?

  fileRef  String
  filePath String?
  remark   String?

  /// The uploader's own file name, and what their browser said the file was.
  ///
  /// Nullable because every row filed before 2026-10-04 predates these columns: both routes
  /// received a content type and discarded it, so the download served `application/octet-stream`
  /// under a name with no extension and a PDF opened as text. `describeStoredFile` sniffs the
  /// bytes when `mimeType` is null, which is why no backfill was attempted — the bytes are the
  /// only honest source, and they are already there.
  fileName String?
  mimeType String?

  /// `shared.User.id`. Bare id — see the schema-level note above.
  uploadedByUserId String
  uploadedAt       DateTime @default(now())

  @@index([companyId])
  @@index([projectId])
  /// Readiness asks "which of these kinds does each of these projects hold?" — this is
  /// the index that question is answered by (FR-008).
  @@index([companyId, projectId, documentTypeId])
  @@schema("projects")
}

/// Which document kinds a project must hold before it counts as fully papered
/// (017 US2, FR-007). Configuration, not documents: the documents themselves are
/// `ProjectDocument` rows.
model ProjectDocumentRequirement {
  id        String @id @default(cuid())
  companyId String

  /// `settings.DocumentType.id` as a BARE STRING, deliberately not a foreign key.
  ///
  /// A declared FK across schemas would be permitted, but resolving it to a *name* for
  /// display is a cross-schema read and Principle I forbids that outright. The projects
  /// module receives type names from the settings module through an exported service
  /// method and joins them in memory. Written down because the missing relation looks
  /// like an oversight and is not.
  documentTypeId String

  /// Whether a project **cannot be created** without a document of this kind (017 FR-007b,
  /// FR-009).
  ///
  /// **Reversed on 2026-09-16.** This comment used to read "FR-009 lets a project exist before its
  /// papers are complete; readiness is reported, never enforced at creation" — which the client's
  /// bug review item 3 made false. A mandatory kind now refuses the creation, naming every missing
  /// kind, and creating nothing.
  ///
  /// An **advisory** kind (false) is reported outstanding and blocks nothing. The two are counted
  /// separately in `ProjectDocumentReadiness` rather than together, so a reader can tell "we cannot
  /// start this project" from "we are still chasing paperwork".
  ///
  /// A kind cannot be marked mandatory while the company has no document type for it (FR-007d):
  /// that would refuse every creation with no way to comply.
  isMandatory Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, documentTypeId])
  @@index([companyId])
  @@schema("projects")
}

// ============================================================================
// hr schema — feature 003 (My Workspace)
// ============================================================================

/// The minimal Employee record this feature needs: the bridge from a logged-in
/// account to the site, shift, and attendance data that hang off it. A future HR &
/// Payroll admin feature extends this (department, designation, joining date)
/// rather than redefining it (research.md §9).
model Employee {
  id String @id @default(cuid())

  /// The account this employee record belongs to (`shared.User.id`). Unique: an
  /// account maps to exactly one employee record, which is what lets every `/my/*`
  /// endpoint resolve the caller's own employee from their token alone and never
  /// accept an employeeId parameter (FR-028).
  userId    String @unique
  /// RLS-protected. Bare id, not a relation — see the note on `Site.companyId`.
  companyId String
  /// `projects.Site.id`; read through `SitesService`.
  siteId    String
  /// `settings.Shift.id`; the shift duration OT is computed against, read through
  /// `SettingsModule`'s exported service (research.md §9).
  shiftId   String

  /// Allocated by `settings`' employee-code sequence (feature 002).
  employeeCode String

  // ── Identity (005 US1) ────────────────────────────────────────────────────
  firstName     String?
  lastName      String?
  title         String?
  dob           DateTime?      @db.Date
  gender        Gender?
  maritalStatus MaritalStatus?
  photoRef      String?

  // ── Employment ────────────────────────────────────────────────────────────
  /// `settings.Department.id` / `settings.Designation.id` — bare ids, resolved via
  /// SettingsService. No cross-schema Prisma relation (Constitution Principle I).
  departmentId          String?
  designationId         String?
  employmentType        EmploymentType?  @default(full_time)
  dateOfJoining         DateTime?        @db.Date
  probationEndDate      DateTime?        @db.Date
  confirmationDate      DateTime?        @db.Date
  reportingToEmployeeId String?
  musterCategory        String?
  hoursPerDay           Decimal?         @db.Decimal(4, 2)
  dailyRate             Decimal?         @db.Decimal(12, 2)
  payMode               String?
  calculationMode       CalculationMode? @default(monthly)
  workmanId             String?
  isActive              Boolean          @default(true)

  // ── Statutory ─────────────────────────────────────────────────────────────
  pfApplicable     Boolean @default(false)
  pfUpperLimit     Boolean @default(false)
  esicApplicable   Boolean @default(false)
  esicUpperLimit   Boolean @default(false)
  uan              String?
  pfNumber         String?
  esicNumber       String?
  /// Regulated PII (Constitution Principle IV). Stored encrypted at rest, masked to
  /// last 4 by PiiMaskingInterceptor, unmasked only via the audited reveal-pii path.
  aadhaarEncrypted String?
  panEncrypted     String?

  // ── Pay & Bank ────────────────────────────────────────────────────────────
  basic                      Decimal? @db.Decimal(12, 2)
  hra                        Decimal? @db.Decimal(12, 2)
  conveyanceAllowance        Decimal? @db.Decimal(12, 2)
  siteAllowance              Decimal? @db.Decimal(12, 2)
  specialAllowance           Decimal? @db.Decimal(12, 2)
  paymentMode                String?
  bankName                   String?
  bankBranch                 String?
  /// Regulated PII — see aadhaarEncrypted.
  bankAccountNumberEncrypted String?
  ifscCode                   String?

  /// The name the **bank** holds against this account (021 FR-008e, task T100).
  ///
  /// Separate from the employee's own name, and that separation is the point rather than an
  /// oversight. In `docs/RING ROAD JULY SALARY.xls` the beneficiary names are misspelled against any
  /// HR record — "Arivnd", "Rosan" — because they are what the beneficiary's own bank has on file.
  /// A transfer is matched on the account number, but a name that disagrees with the bank's is what
  /// gets a payment returned, and the first anybody knows is on payment day.
  ///
  /// Nullable, and the bank export **refuses** a row where it is unset rather than falling back to
  /// the employee's name. A silent fallback is worse than a refusal: the refusal happens while
  /// somebody can still fix it.
  bankAccountHolderName String?

  // ── Contact ───────────────────────────────────────────────────────────────
  mobile                   String?
  alternateMobile          String?
  email                    String?
  presentAddress           String?
  presentCity              String?
  presentState             String?
  presentPinCode           String?
  permanentAddress         String?
  permanentCity            String?
  permanentState           String?
  permanentPinCode         String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  // ── Letters ───────────────────────────────────────────────────────────────
  offerLetterIssued           Boolean   @default(false)
  offerLetterIssuedDate       DateTime? @db.Date
  appointmentLetterIssued     Boolean   @default(false)
  appointmentLetterIssuedDate DateTime? @db.Date
  ndaSigned                   Boolean   @default(false)
  ndaSignedDate               DateTime? @db.Date

  // ── Onboarding checklist ──────────────────────────────────────────────────
  idCardIssued             Boolean @default(false)
  uniformProvided          Boolean @default(false)
  safetyInductionCompleted Boolean @default(false)
  toolsIssued              Boolean @default(false)
  bankVerificationDone     Boolean @default(false)
  biometricEnrolled        Boolean @default(false)
  siteAccessGranted        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faceEnrolment                FaceEnrolment?
  reEnrolmentRequests          ReEnrolmentRequest[]
  punchRecords                 PunchRecord[]
  leaveBalances                LeaveBalance[]
  leaveApplications            LeaveApplication[]
  reimbursementClaims          ReimbursementClaim[]
  salarySlips                  SalarySlip[]
  documents                    EmployeeDocument[]
  transfers                    EmployeeTransfer[]
  attendanceModifications      AttendanceModification[]
  pendingAttendanceCorrections PendingAttendanceCorrection[]
  exitRecords                  ExitRecord[]
  payrollLineItems             PayrollLineItem[]
  loans                        Loan[]
  taxDeclarations              TaxDeclaration[]
  salaryAdvances               SalaryAdvance[]

  /// 020 FR-013c: punches refused for this employee.
  punchRefusals PunchRefusal[]

  /// 020 FR-011: which location this employee's punches validate against, and its history.
  locationAssignments EmployeeLocationAssignment[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([siteId])
  @@schema("hr")
}

/// Exactly one row per employee. A completed re-enrolment replaces `descriptor`,
/// `photoRefs`, and `enrolledAt` in place — "previous template securely deleted"
/// (FR-016) means the prior values are overwritten, never retained as history.
model FaceEnrolment {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// The derived 128-float face descriptor, encrypted at rest — never the raw
  /// photos, which is the whole point of storing a descriptor (research.md §2):
  /// a punch compares one vector instead of re-running inference against every
  /// enrolled image. Null while `status` is `not_enrolled`.
  descriptor Bytes?
  /// Encrypted object-storage references to the 3–5 captured photos. The blobs
  /// themselves live in `StorageService`, not here — only large binaries leave
  /// Postgres (constitution v1.4.0).
  photoRefs  String[]

  consentMethod         ConsentMethod?
  consentAcknowledgedAt DateTime?
  enrolledAt            DateTime?

  status FaceEnrolmentStatus @default(not_enrolled)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("hr")
}

enum FaceEnrolmentStatus {
  not_enrolled
  enrolled
  re_enrolment_requested

  @@schema("hr")
}

enum ConsentMethod {
  signed_paper
  digital
  verbal

  @@schema("hr")
}

/// An employee's request to re-capture their face template (e.g. after an injury or
/// a persistent match failure), and the admin decision on it. Approval opens a
/// time-boxed unlock that a single fresh capture consumes (FR-013–FR-016).
model ReEnrolmentRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reason String
  status ReEnrolmentRequestStatus @default(pending)

  /// Mandatory when `status` is `rejected` — enforced at the DTO/service layer,
  /// since a conditional NOT NULL is not expressible in the schema.
  adminRemarks String?

  decidedByUserId String?
  decidedAt       DateTime?

  /// Set on approval, `reEnrolment.unlockDurationDays` out (FR-015).
  unlockExpiresAt  DateTime?
  /// Set when the fresh capture completes, so one approval cannot be reused (FR-016).
  unlockConsumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@schema("hr")
}

enum ReEnrolmentRequestStatus {
  pending
  approved
  rejected
  completed
  expired

  @@schema("hr")
}

/// One punch event. Recorded whether or not verification succeeded: a failed face
/// match or an out-of-geofence position becomes an exception for an admin to
/// resolve, never a rejected request (FR-007) — a worker who is physically present
/// must not be silently absent from payroll because of a bad camera angle.
model PunchRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type PunchType

  /// The official punch time, declared by the client so an offline-queued punch
  /// records when the worker actually punched rather than when connectivity
  /// returned (research.md §4).
  capturedAt    DateTime
  /// Server receipt time. Both are retained because FR-012 requires offline syncs
  /// to stay visible in audit rather than being flattened into one timestamp.
  receivedAt    DateTime @default(now())
  /// Derived: `capturedAt` trails `receivedAt` by more than the configured clock-skew
  /// tolerance. The tolerance is what stops ordinary clock drift from labelling every
  /// normal punch an offline sync.
  isOfflineSync Boolean  @default(false)

  /// Encrypted object-storage reference to the captured selfie.
  /// Null only for `admin_correction` rows, which have no capture. A CHECK
  /// constraint keeps this mandatory for employee-sourced punches.
  photoRef String?

  faceMatchResult   FaceMatchResult?
  /// The measured descriptor distance behind `faceMatchResult`. Kept so an admin
  /// resolving an exception can see how near the miss was, and so the configured
  /// threshold can be retuned against real data instead of guesswork.
  faceMatchDistance Decimal?         @db.Decimal(6, 4)

  latitude               Decimal?        @db.Decimal(10, 7)
  longitude              Decimal?        @db.Decimal(10, 7)
  geofenceResult         GeofenceResult?
  /// Measured metres from the site centre, retained for the same reason as
  /// `faceMatchDistance`.
  geofenceDistanceMeters Decimal?        @db.Decimal(10, 2)

  /// On a punch-in, the id of the punch-out that closed it; null while the punch-in
  /// is still open. This is what makes "at most one open punch-in per employee"
  /// (FR-008) enforceable as a partial unique index in the database, instead of
  /// resting solely on an application-level check that two concurrent requests can
  /// both pass. Always null on a punch-out record.
  /// The calendar day this punch counts for, in the configured timezone (FR-018a).
  ///
  /// Stamped at insert rather than derived on read: `AT TIME ZONE` with a named zone
  /// is STABLE, not IMMUTABLE, so Postgres will not build a unique index over the
  /// expression — and FR-008c needs exactly that index. The cost is that changing
  /// APP_TIMEZONE later does not reclassify punches already recorded, which for
  /// payroll data is the safer direction.
  punchDate DateTime @db.Date

  /// Who wrote this punch. The FR-008c uniqueness constraint binds only `employee`
  /// rows, so feature 005's future corrections are not forbidden by the schema, and
  /// rows predating FR-008 (`legacy`) keep their multiple pairs per day.
  source PunchSource @default(employee)

  closedByPunchId String? @unique

  /// Null unless either result above is `exception`; then `pending` until an admin
  /// acts (FR-011a).
  exceptionResolution ExceptionResolution?
  resolvedByUserId    String?
  resolvedAt          DateTime?

  // ── Admin edit surface (005 US3, research.md §7) ──────────────────────────
  /// Set when an admin created or corrected this record through the HR admin
  /// Mark/Edit action rather than the employee's own punch flow. Every such edit
  /// also writes an append-only AttendanceModification row carrying before/after.
  adminEdited    Boolean                   @default(false)
  editedByUserId String?
  editedAt       DateTime?
  /// Forces the derived day status instead of letting statusForDay() compute it —
  /// used when an admin marks a day present/absent against what the punches imply.
  statusOverride AttendanceStatusOverride?
  remarks        String?

  createdAt DateTime @default(now())

  /// Serves both the open-punch-in lookup on the write path and the month-range
  /// history query on the read path.
  @@index([employeeId, capturedAt])
  @@index([employeeId, punchDate])
  @@index([exceptionResolution])
  @@schema("hr")
}

enum PunchType {
  in
  out

  @@schema("hr")
}

enum PunchSource {
  /// Self-service, made through `/my/punch`. The only kind FR-008 constrains.
  employee
  /// Reserved for feature 005's administrative fix-ups.
  admin_correction
  /// Recorded before FR-008 existed, when a day could hold several pairs.
  legacy

  @@schema("hr")
}

enum FaceMatchResult {
  matched
  exception

  @@schema("hr")
}

enum GeofenceResult {
  in_range
  exception

  @@schema("hr")
}

/// Mirrors the `AttendanceStatus` union in
/// src/hr/punch/attendance-history.service.ts. Kept in sync by hand — the union is
/// the source of truth for computation, this enum only stores an admin's override.
enum AttendanceStatusOverride {
  present
  absent
  on_leave
  weekly_off
  holiday

  @@schema("hr")
}

enum ExceptionResolution {
  pending
  confirmed
  rejected

  @@schema("hr")
}

/// Per-employee, per-financial-year leave entitlement. `balance` is deliberately not
/// a column: storing `opening + accrued - used` alongside its own inputs is a second
/// source of truth that drifts the first time one of them is written without the
/// other (data-model.md "Leave Balance").
model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType     LeaveTypeCode
  /// Indian financial year, e.g. "2026-27".
  financialYear String

  opening Decimal @default(0) @db.Decimal(6, 2)
  accrued Decimal @default(0) @db.Decimal(6, 2)
  used    Decimal @default(0) @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveType, financialYear])
  @@schema("hr")
}

model LeaveApplication {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveTypeCode
  fromDate  DateTime      @db.Date
  toDate    DateTime      @db.Date
  /// Computed server-side at submission, excluding weekly offs and site holidays
  /// (FR-019) — never taken from the client, which would let a caller understate
  /// the cost of their own leave.
  dayCount  Decimal       @db.Decimal(5, 2)

  reason String
  status LeaveApplicationStatus @default(pending)

  /// Mandatory when `status` is `rejected` (FR-022a); enforced at the service layer.
  adminRemarks    String?
  decidedByUserId String?
  decidedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([employeeId, fromDate, toDate])
  @@schema("hr")
}

enum LeaveTypeCode {
  earned
  casual
  sick
  /// Leave without pay — the one type not checked against a balance (FR-020).
  lwp

  @@schema("hr")
}

enum LeaveApplicationStatus {
  pending
  approved
  rejected
  cancelled

  @@schema("hr")
}

/// An employee-originated expense claim (US8).
///
/// In `hr`, not `payroll`, because the claim exists as the employee's own record
/// long before payroll has any interest in it — the same shape Leave already has
/// (research.md §10). Feature 005 adds the admin review layer over this same table;
/// it does not get a second one. This feature writes only `draft` → `submitted` →
/// `withdrawn`; the approval and payment fields below are read-only here.
model ReimbursementClaim {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Denormalized from the owning Employee so the claim can be RLS-filtered by a
  /// plain equality. Unlike the attendance tables, a claim is a financial document
  /// that must stay with the company it was incurred against even if the employee
  /// later moves — so the copy here is the intended record, not a cache of
  /// Employee's value.
  companyId String

  /// FK to `settings.ReimbursementCategory` by value only. No Prisma relation:
  /// Principle I routes the read through `ReimbursementCategoriesService`, and a
  /// declared relation is exactly the cross-schema join that would bypass it.
  categoryId String

  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @db.Date
  description String

  /// Encrypted object-storage reference to the receipt image. Mandatory above the
  /// category's configured threshold (FR-030).
  receiptRef String?

  status           ReimbursementClaimStatus  @default(submitted)
  /// Written by feature 005 once a claim is approved and paid; never by this one.
  paymentMode      ReimbursementPaymentMode?
  paymentReference String?

  /// Feature 005's decision fields. Present here because the table is shared, and
  /// splitting them into a second table would make "one claim, one status" untrue.
  decidedByUserId String?
  decidedAt       DateTime?
  adminRemarks    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([companyId, status])
  @@schema("hr")
}

