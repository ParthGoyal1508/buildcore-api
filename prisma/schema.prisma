datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["shared", "settings", "hr", "projects", "payroll", "partners", "inventory", "plant", "labour", "assets", "recruitment"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

// `shared` is the cross-module schema for concerns that don't belong to any single
// named business module (hr, payroll, projects, plant, inventory, partners, settings)
// — see the constitution's schema-per-module principle and specs/001-user-login-backend/
// research.md §10. Account/session/audit data lives here.
//
// `settings` normally belongs to 002-settings-backend, which hasn't been built yet.
// Role/Permission/UserRole are pulled forward into this feature (2026-08-28 design
// decision, prompted by a direct question about why Super Admin was schema-special-
// cased instead of being an ordinary, dynamically-editable role) because login/access
// control cannot work without a real permission model — 002 owns *managing* roles
// (CRUD, the other eight default roles from the PRD) but does not own the schema
// itself once this feature exists first.

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email       String  @unique
  /// Auto-generated from the email local-part at invite time (010 data-model.md),
  /// not supplied by the admin. Nullable because a `pending` row is created before
  /// anything has been generated for it, and because rows predating feature 010
  /// were never guaranteed one by any code path other than the seed.
  username    String? @unique
  /// Null until the invitee sets it (010). Every row created before feature 010
  /// already has one, so relaxing this is additive rather than a change to
  /// existing data.
  password    String?
  /// Shown in the account list when no `hr.Employee` is linked — a Super Admin or a
  /// vendor-facing login has no HR record to take a name from. Required by
  /// `UsersService.create()` in exactly that case, enforced at the service layer
  /// since a conditional NOT NULL is not expressible here (010 data-model.md).
  displayName String?
  firstname   String?
  lastname    String?

  /// A user can hold more than one role at once (2026-08-28 clarification) — their
  /// effective permissions are the union across every assigned role's permissions.
  userRoles UserRole[]

  /// The account's home company. Still present even for a user who also holds a
  /// role with CROSS_COMPANY_ACCESS (research.md §5 update) — cross-company access
  /// is now a permission, not a null-companyId special case, so a "super admin"
  /// account can still meaningfully belong to one home company.
  companyId String?

  /// Set on every successful authentication (001 FR-017); read by 002's Users list
  /// (FR-013) via the exported UsersService, never by a direct cross-schema query.
  lastLoginAt DateTime?

  status              UserStatus       @default(active)
  mustChangePassword  Boolean          @default(false)
  /// How this account's first password came to exist (010 FR-017a-i).
  ///
  /// `mustChangePassword` alone cannot carry this: the forced-change refusal applies
  /// to `admin_direct` accounts only, so the same flag means *enforced* on one
  /// account and *advisory* on an admin-reset one, and nothing else separates them.
  /// Only an explicit `admin_direct` is ever refused — an absent or unrecognised
  /// value must not lock a real user out over missing metadata.
  credentialOrigin    CredentialOrigin @default(invite)
  /// Resets to 0 on next successful login (FR-013).
  consecutiveFailures Int              @default(0)
  /// Set when consecutiveFailures reaches the configured threshold (FR-012).
  lockedUntil         DateTime?

  refreshTokens   RefreshToken[]
  inviteTokens    InviteToken[]
  auditLogEntries AuditLogEntry[]

  // Feature 016's approval spine. Two relations to the same table because the person
  // who raised an item and the people who decide on it are different roles in the
  // story — and FR-021a means they must be different people.
  approvalsRaised    ApprovalInstance[] @relation("ApprovalOriginator")
  approvalsDelegated ApprovalInstance[] @relation("ApprovalDelegate")
  approvalDecisions  ApprovalDecision[] @relation("ApprovalActor")

  @@schema("shared")
}

enum CredentialOrigin {
  /// Chosen by the account holder, via an invite token. The default, and what every
  /// account created before feature 010's 2026-09-01 amendment is.
  invite
  /// Set by an admin at creation time (FR-015). The only origin the forced-change
  /// refusal applies to.
  admin_direct
  /// Set by an admin resetting an existing account's password. Deliberately left
  /// unenforced for now (FR-017a-ii).
  admin_reset

  @@schema("shared")
}

enum UserStatus {
  /// Invited but not yet activated: the row exists so the account can be listed,
  /// audited and re-invited, but it has no password and cannot authenticate until
  /// the invitee consumes their token (010 research.md §3).
  pending
  active
  deactivated

  @@schema("shared")
}

/// A named, editable set of permissions (`settings` schema — see header comment on
/// why this feature creates it ahead of 002). Seeded here with only the one
/// permanent, protected role this feature itself depends on (Super Admin); the
/// other eight default roles from the PRD are 002-settings-backend's own seeding
/// work, once it exists.
///
/// Deliberately NOT row-level-secured: role *definitions* are global reference data
/// shared across every company (one system-wide "Super Admin" role, not one per
/// company), so Principle IV's per-tenant isolation requirement doesn't apply here
/// — every authenticated user can read what a role grants. UserRole (who
/// actually *holds* a role) is the tenant-scoped side, and is RLS-protected.
model Role {
  id   String @id @default(cuid())
  name String @unique

  /// **Retiring.** Replaced by `rolePermissions` below, which adds the read/write level
  /// the client's Note 22 needs (019 FR-001). Still the source of truth until 019 Phase 2
  /// switches the guard over; kept through that cutover on purpose, so a rollback of
  /// Phase 2 is a code revert with no data loss. A later migration drops it once a release
  /// has proved the new path.
  ///
  /// Do not write to it and do not read it in new code. `scripts/access-matrix.ts` reads
  /// both shapes and is what proves the two agree (FR-006, SC-002).
  permissions Permission[]

  /// One row per area and level (019 FR-001, FR-002). See `RolePermission`.
  rolePermissions RolePermission[]
  /// True only for the seeded Super Admin role — blocks rename/permission-change/
  /// delete (002-settings-backend FR-008; enforced there once it owns role editing —
  /// this feature only ever reads roles, it doesn't expose role management).
  isProtected     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  userRoles UserRole[]

  /// Feature 016: the chain slots this role fills. A role cannot be deleted out from
  /// under a chain without taking its mappings with it — which is the right outcome,
  /// since the alternative is a level that resolves to nothing.
  roleSlotMappings RoleSlotMapping[]

  @@schema("settings")
}

/// One grant: a role may do `level` to `permission` (019 FR-001, FR-002).
///
/// Replaces `Role.permissions`, the scalar list, which could not carry a level. The
/// alternative was doubling the `Permission` enum into `*_READ`/`*_WRITE` pairs — rejected
/// because 34 values become 68, every one of the 116 `@RequirePermissions(...)`
/// declarations would have to name which it meant, and a role's grants would stop being
/// queryable by area.
///
/// **No `companyId`, and no RLS — deliberately.** `Role` itself carries neither: migration
/// `20260828170000_role_permission_model` records the reasoning, that who *holds* a role is
/// tenant data (hence `UserRole` is RLS'd) while the role's own definition is not. A child
/// of a global table cannot be tenant-scoped, and a policy here that looked like one would
/// be worse than none — it would read as isolation to the next person while enforcing
/// nothing.
/// A refused request, recorded (019 FR-003).
///
/// `heldLevel` is the column that earns this table. A refusal with `heldLevel = read` against
/// a required `write` is an **interface** that offered a control it should have hidden —
/// FR-004's failure mode, and a bug report. A refusal with `heldLevel = null` is somebody
/// reaching for a module they hold nothing in, which is a security signal. Without this column
/// the two are the same row, and the only thing anybody could do with the log is count it.
/// Which company a user is currently working in (019 FR-008 to FR-013).
///
/// **Stored server-side, not carried in the token.** FR-011 requires the selection to survive
/// a browser restart, and access tokens here are short-lived — a JWT claim would not survive
/// one. A cookie would make the selection a client assertion about authorisation scope, which
/// is the one thing it must never be.
///
/// `userId` is the primary key, so two selections for one user are **unrepresentable** rather
/// than merely prevented.
///
/// The selection is not authorisation. It is validated against the user's accessible companies
/// on every read, not only on write: the spec's own edge case is cross-company access being
/// revoked while the other company is selected, and a stored selection trusted at read time is
/// how that becomes a cross-tenant read.
model UserCompanySelection {
  userId String @id

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@schema("settings")
}

model PermissionRefusal {
  id        String @id @default(cuid())
  companyId String

  userId String
  method String

  /// The route **template**, never the resolved URL. A resolved URL carries record ids, and a
  /// security log quietly accumulating them becomes a store of personal data nobody
  /// classified as one.
  path String

  requiredPermission Permission
  requiredLevel      AccessLevel

  /// The level actually held for that area. **Null means the area was not held at all** —
  /// which is a different event from holding it at the wrong level.
  heldLevel AccessLevel?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, userId])
  @@schema("settings")
}

model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// The area. The existing 34-value enum, unchanged — areas are already granular enough
  /// for the client's Note 22, since `LOGBOOK` and `FUEL` are already distinct from
  /// `MACHINERY` (019 research §2).
  permission Permission
  level      AccessLevel

  createdAt DateTime @default(now())
  createdBy String?

  /// A grant is present or absent, never duplicated.
  @@unique([roleId, permission, level])
  @@index([roleId])
  @@schema("settings")
}

/// Join table — a user can hold multiple roles, a role can be held by multiple users.
/// Unlike Role itself (global reference data, not tenant-scoped — see Role's own
/// comment), *who has which role* is tenant data: carries companyId, denormalized
/// from the user at assignment time, so it follows the same RLS pattern as every
/// other tenant-scoped table this feature relies on (FR-020).
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  companyId String?
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@schema("settings")
}

/// How much of an area a grant confers (019 FR-001).
///
/// Two values, deliberately. A third (`approve`) was considered and rejected: this system
/// already expresses approval as separate `Permission` values — `INVENTORY_APPROVE`,
/// `LABOUR_APPROVE`, `RECRUITMENT_APPROVE`, `ASSETS_APPROVE` — and a level duplicating
/// them would give two ways to say one thing with nothing stating which wins.
enum AccessLevel {
  read
  write

  @@schema("settings")
}

enum Permission {
  DASHBOARD
  EMPLOYEES
  ATTENDANCE
  PROJECTS
  DWR
  PROJECT_FINANCIALS
  MACHINERY
  INVENTORY
  PARTNERS
  REPORTS
  PAYROLL
  CHALLANS
  LOANS
  LOGBOOK
  FUEL
  DAILY_WORKER_REGISTRY
  MY_WORKSPACE
  SETTINGS
  USER_MANAGEMENT
  COMPANY_SETTINGS
  DATA_EXPORT
  DATA_DELETE
  /// New, added by this feature (not in 002-settings-backend's original list): the
  /// capability that lets a role's holder see/act across every company rather than
  /// just their own — replaces the old hardcoded "role === SUPER_ADMIN" schema
  /// exception (research.md §5 update, FR-020a).
  CROSS_COMPANY_ACCESS

  /// Added by 009 (FR-029). Approving a material indent — and reducing a line's
  /// quantity while approving it — is a spending decision, so it is separable from
  /// the `INVENTORY` value every other indent endpoint reuses. Deliberately the
  /// only value this feature adds.
  INVENTORY_APPROVE

  /// Added by 013 (FR-038). Approving a muster roll, freezing/reopening a payment
  /// sheet, reversing a disbursement, and approving an above-limit labour advance
  /// are all money-adjacent decisions, so they are separable from the
  /// `DAILY_WORKER_REGISTRY` value every other labour endpoint reuses. Deliberately
  /// the only value this feature adds — it reuses the existing
  /// `DAILY_WORKER_REGISTRY` and `REPORTS` values verbatim.
  LABOUR_APPROVE

  /// Added by 006. Maintenance jobs, service schedules, spare parts and service
  /// bills. `MACHINERY`, `LOGBOOK` and `FUEL` already existed — 002 reserved them by
  /// name for exactly this module — so only the two below are genuinely new
  /// (006 FR-011, research.md §7).
  MAINTENANCE
  /// Hire bill verification and payment. Separate from `MAINTENANCE` because
  /// approving a rental invoice is an accounts decision, not a workshop one.
  HIRE_BILLS

  /// Added by 011. Access to the recruitment funnel (requisitions, candidates,
  /// interviews, offers, joining, onboarding, letters, resignations). Reuses the
  /// existing `EMPLOYEES` and `REPORTS` values elsewhere.
  RECRUITMENT
  /// Added by 011. Approving a requisition, issuing an offer above its budgeted
  /// maximum, waiving an onboarding item, and accepting a resignation are the
  /// separable approval decisions in the funnel. Deliberately the only approval
  /// value this feature adds.
  RECRUITMENT_APPROVE

  /// Added by 012 (FR-033). Registering, allocating, transferring, inspecting and
  /// requesting project assets. `INVENTORY` is deliberately not reused: a storekeeper
  /// who issues cement is not thereby accountable for who is holding the total
  /// station, and the two registers answer to different people.
  ASSETS
  /// Approving asset requests, condemning an asset, cancelling a transfer and
  /// changing an asset's category. Separate from `ASSETS` for the reason every
  /// `_APPROVE` value in this enum is separate: authorising is not doing.
  ASSETS_APPROVE

  /// Added by 019 Phase 7 (FR-017a, FR-017b). The right to *record* a payment in cash,
  /// and to see a cash denomination breakup. Deliberately not a reuse of
  /// `COMPANY_SETTINGS`: who may change the hiding setting and who may take cash are
  /// different questions about different people, and FR-012 already owns the first.
  ///
  /// Granted to every role that could already record a cash payment, in the migration
  /// that adds it — preserving today's behaviour is the requirement, not a convenience.
  /// A permission that defaulted to nobody would stop every site cashier the moment it
  /// deployed, which is the exact failure the two-control design existed to avoid.
  CASH_ENTRY

  @@schema("settings")
}

/// The tenant root — not itself `companyId`-scoped, so deliberately NOT RLS-filtered
/// (a company has no companyId; it *is* the company). Access is gated by the
/// COMPANY_SETTINGS permission instead (research.md §8, FR-001).
model Company {
  id String @id @default(cuid())

  name      String
  /// Unique across all companies, case-insensitively — normalized to trimmed
  /// uppercase on write, with a `lower()` functional unique index as the
  /// database-level backstop (FR-004). Drives employee code generation.
  shortCode String  @unique
  logoUrl   String?

  status CompanyStatus @default(active)

  // Statutory registration identifiers. GSTIN/PAN are format-validated at the DTO
  // boundary (research.md §10) because downstream Challan generation depends on
  // them being well-formed.
  gstin String?
  pan   String?
  cin   String?
  tan   String?

  address String?
  city    String?
  state   String?
  pinCode String?

  pfEstablishmentCode      String?
  esicCode                 String?
  professionalTaxRegNumber String?
  bocwRegNumber            String?

  /// Fixed at `monthly` per the PRD; modeled as an enum of one for forward
  /// compatibility rather than a bare constant.
  payCycle       PayCycle @default(monthly)
  /// Day-of-month after which attendance edits lock for payroll processing.
  payrollLockDay Int

  // Seeded from SettingsConfig at creation time, per-company editable thereafter
  // (FR-002, research.md §11). Decimal, not Float — these are money-adjacent
  // statutory percentages where binary rounding drift is unacceptable.
  pfEmployerRate   Decimal @db.Decimal(5, 2)
  esicEmployerRate Decimal @db.Decimal(5, 2)
  gratuityRate     Decimal @db.Decimal(5, 2)
  bonusRate        Decimal @db.Decimal(5, 2)

  /// Overtime pay multiplier applied to the derived hourly rate when computing OT
  /// wages (FR-014a). Company-configurable rather than a hardcoded 2× literal —
  /// Constitution Principle III. Read by the payroll engine via SettingsService.
  otMultiplier Decimal @default(2.00) @db.Decimal(5, 2)

  /// BOCW cess levied on a project's contract value, as a fraction (0.01 = 1%).
  /// Statutory and revisable, so it is company configuration rather than a literal
  /// in the cess calculation — Constitution Principle III. Read by 007's BOCWService
  /// via `SettingsService.getBocwCessRate()`. Four decimal places because the rate is
  /// a fraction, not a percentage: 1% is 0.0100 and a future 1.25% is 0.0125.
  bocwCessRate Decimal @default(0.0100) @db.Decimal(6, 4)

  /// The indirect-tax and withholding rates a running-account bill is computed at (023 FR-015,
  /// FR-019, FR-023), as fractions — `0.090000` is 9%.
  ///
  /// Here rather than in the billing module for the reason `bocwCessRate` is here: a statutory
  /// percentage is exactly the value Principle III keeps out of the calculation that uses it, and
  /// `settings.Company` is where this repository already keeps them. Read through
  /// `CompaniesService.getBillingTaxRates` — Principle I forbids `projects` reading this table
  /// directly.
  ///
  /// **Six decimal places, matching `BillPackage`'s frozen columns.** A freeze that narrowed the
  /// precision would be a silent change to the rate it claims to have recorded.
  ///
  /// The defaults state today's statute, and carry the same trade `bocwCessRate` accepted: a
  /// company that never reviews them keeps billing at these. What makes that survivable here is
  /// that every bill **records the rate it was computed at** (023 FR-019), so a rate change is
  /// visible as a difference between two bills rather than as a silent re-derivation of both.
  cgstFraction Decimal @default(0.090000) @db.Decimal(8, 6)
  sgstFraction Decimal @default(0.090000) @db.Decimal(8, 6)
  igstFraction Decimal @default(0.180000) @db.Decimal(8, 6)
  /// Income tax deducted at source on a works contract.
  tdsFraction  Decimal @default(0.020000) @db.Decimal(8, 6)

  /// The labour wage cycle a payment sheet's period defaults to (013 FR-041) —
  /// independent of the monthly salary `payCycle` above, because daily-wage labour
  /// is settled weekly, fortnightly, or monthly on its own cadence. Weekly by
  /// default. Company-configurable rather than a literal — Constitution Principle III.
  labourWageCycle LabourWageCycle @default(weekly)

  /// The company's own account the payroll transfer is debited from (021 FR-008a).
  ///
  /// A **string**, not a number, and the sample file is the argument: every value in the
  /// `Debit Account No.` column of `docs/RING ROAD JULY SALARY.xls` is `09310400000819` — an account
  /// number whose leading zero is part of it. Stored as text here so it cannot be lost before the
  /// export even looks at it.
  ///
  /// Nullable, and the export refuses rather than guesses. Not PII in the sense the employee's
  /// account is: this is the company's own account, named on every cheque it writes.
  payrollDebitAccountNumber String?

  /// Currency note denominations used to compute a cash payment sheet's breakup
  /// (013 FR-027), descending. Company-configurable because the notes in circulation
  /// change by legislation (the ₹2000 note's withdrawal being the recent example),
  /// so this is not a literal inside the denomination service — Principle III.
  labourCashDenominations Int[] @default([500, 200, 100, 50, 20, 10, 5, 1])

  /// The worst GPS accuracy a punch may report and still be located, in metres
  /// (020 FR-012b).
  ///
  /// The client asked for this in those words — "configurable from the settings by super admin" —
  /// and an environment variable does not satisfy it: it needs a redeploy and it is the same for
  /// both companies.
  ///
  /// **Nullable rather than defaulted in the database.** Null means "this company has not decided",
  /// which is a different fact from "this company chose 50" — and only the first should follow a
  /// change to the product default. A column defaulted to 50 makes every company look as though it
  /// had made a decision nobody made.
  ///
  /// Deliberately **not** feature 013's `WORKSPACE_LABOUR_GPS_ACCURACY_MAX_METRES`: same units,
  /// different surface, different tolerance. Merging them means tuning one to fix the other.
  punchAccuracyMaxMetres Int?

  /// Whether a punch that fails location or face validation is **refused** rather than recorded as
  /// an exception for an admin (020 FR-013).
  ///
  /// **Default false, and that is the point.** The client accepted the hard block's cost without
  /// knowing how often it would fire, and `PunchRefusal` is accumulating that figure right now while
  /// punches are still being accepted. Shipping the inversion switched on would spend the only
  /// moment at which their decision is cheap to reverse — so the code ships and the behaviour does
  /// not, and the answer they give becomes a settings change rather than a release.
  ///
  /// It also keeps the decision cheap in **both** directions afterwards. One company can be switched
  /// on, watched for a fortnight against its own refusal log, and switched off again without a
  /// deploy.
  ///
  /// What a flag cannot do is make the branch safe by never running. A dormant path is untested in
  /// production until the day somebody turns it on, which is why every test of the refusal path runs
  /// with enforcement forced on rather than inheriting this default — see `punch.service.spec.ts`.
  /// The flag decides whose punches are refused, never whether the code is exercised.
  punchBlockEnforced Boolean @default(false)

  /// The ceiling on **total** deductions from one payslip, as a percentage of its gross wages
  /// (020 FR-007a).
  ///
  /// The client's answer of 2026-10-02: half that month's wages, shared with every other deduction
  /// rather than being the fuel recovery's own allowance. Stored per company and not a literal,
  /// because it is a statutory figure and statutory figures are revised — Principle III.
  ///
  /// **Capped at 50 by a check constraint, not merely defaulted to it.** A configuration mistake here
  /// does not produce a slightly wrong payslip, it produces an unlawful one, and a bound the database
  /// enforces cannot be raised by a careless settings edit. Lowering it is allowed: a company may be
  /// stricter than the Act, never laxer.
  deductionCeilingPercent Int @default(50)

  /// Hides cash amounts and cash transactions across the application (019 FR-014).
  ///
  /// A **display** control, never a data operation — FR-017 is explicit that nothing is
  /// deleted or altered while it is on. Default false: a display control that arrived
  /// switched on would hide figures nobody asked to hide.
  ///
  /// Note that `labourCashDenominations` above is deliberately NOT hidden by this. It
  /// looks like cash and is not — it is configuration, and hiding it would break the
  /// payment-sheet builder while concealing nothing anybody wanted concealed.
  hideCashTransactions Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments     Department[]
  designations    Designation[]
  documentTypes   DocumentType[]
  shifts          Shift[]
  employeeCodeSeq EmployeeCodeSequence?
  skillCategories SkillCategory[]
  kitItems        KitItem[]
  letterTemplates LetterTemplate[]

  reimbursementCategories ReimbursementCategory[]
  vendorCategories        VendorCategory[]
  codeSequences           CodeSequence[]

  // Feature 004's reminders engine. Company-scoped so a deleted company takes its
  // reminder state with it rather than leaving orphan rows the engine would keep
  // evaluating.
  itemCategories ItemCategory[]
  items          Item[]

  equipmentCategories EquipmentCategory[]
  equipmentDocTypes   EquipmentDocType[]
  hireRates           HireRate[]

  reminderRuleOverrides ReminderRule[]
  reminderSnoozes       ReminderSnooze[]
  reminderNotifications ReminderNotification[]

  assetCategories AssetCategory[]
  assetDocTypes   AssetDocType[]
  conditionGrades ConditionGrade[]

  // Feature 016's approval spine. Chains and slot mappings are per company because the
  // client runs two companies that may staff the same chain shape differently.
  approvalChains    ApprovalChain[]
  approvalLevels    ApprovalLevel[]
  roleSlotMappings  RoleSlotMapping[]
  approvalInstances ApprovalInstance[]
  approvalDecisions ApprovalDecision[]
  /// 017 US1 — the certificates behind this company's registration numbers.
  companyDocuments  CompanyDocument[]

  // 017 letters (T026, T052).
  letterKinds   LetterKind[]
  signatories   Signatory[]
  issuedLetters IssuedLetter[]

  /// 016 FR-018a: which action types this company requires the Director to approve.
  directorFinalActions DirectorFinalAction[]

  /// 016 FR-018b: proposed changes to this company's director-final set.
  directorFinalChangeProposals DirectorFinalChangeProposal[]

  /// 019 FR-008: users currently working in this company.
  userCompanySelections UserCompanySelection[]

  @@schema("settings")
}

enum CompanyStatus {
  active
  inactive

  @@schema("settings")
}

enum PayCycle {
  monthly

  @@schema("settings")
}

/// The cadence a labour payment sheet's wage period defaults to (013 FR-041).
/// Distinct from `PayCycle` (which is the monthly salary run): daily-wage labour is
/// settled on its own, usually shorter, cycle.
enum LabourWageCycle {
  weekly
  fortnightly
  monthly

  @@schema("settings")
}

enum TaxRegime {
  old
  new

  @@schema("settings")
}

/// One band of an income-tax slab set (005 amendment US14, FR-050).
///
/// Company-scoped rather than global: a slab set is a statutory fact, but which
/// financial years a company has configured is not, and a multi-company install
/// should not have one company's incomplete configuration break another's payroll.
model TaxSlab {
  id        String @id @default(cuid())
  companyId String

  /// e.g. "2026-27".
  financialYear String
  regime        TaxRegime

  /// Inclusive lower bound of the band.
  lowerBound  Decimal  @db.Decimal(14, 2)
  /// Exclusive upper bound; null marks the final open-ended band.
  upperBound  Decimal? @db.Decimal(14, 2)
  ratePercent Decimal  @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, financialYear, regime, lowerBound])
  @@index([companyId, financialYear, regime])
  @@schema("settings")
}

