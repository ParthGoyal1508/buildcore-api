/// Append-only audit of every manual attendance edit (FR-010). Never updated.
/// A manual attendance correction that has been submitted and not yet applied
/// (016 FR-012, plan D15).
///
/// **Why this table exists at all.** The correction enters the approval chain, so its
/// intended values have to survive between submission and the chain completing — and the
/// spine cannot hold them. `ApprovalInstance` carries no payload by design: it stores an
/// opaque `(entityType, entityId)` pair and never dereferences it, which is what lets the
/// spine know nothing about the modules it serves (016 research §1). So the payload lives
/// here, in `hr`, owned by the module that understands it, and the spine's `entityId`
/// points at a row in this table.
///
/// Neither the plan nor the task list named this table; it was found during
/// implementation on 2026-09-30, because "submit to ApprovalsService and return the
/// pending instance" has nowhere to keep the correction otherwise.
///
/// Rows are **not** the audit trail. `AttendanceModification` is, and it is written only
/// when a correction is applied (FR-012b, plan D15) — a rejected correction modified
/// nothing, and logging it as a modification would make the log disagree with the
/// attendance. A rejected correction stays visible as an approval instance, which is
/// where it belongs.
/// Why a punch was, or would have been, refused (020 FR-013c).
enum PunchRefusalReason {
  /// Located, and outside the assigned fence.
  outside_geofence
  /// The GPS fix was worse than the company's threshold, so the punch could not be located at all
  /// — a different fact from being located somewhere wrong, and the reason the two are separate
  /// values rather than one.
  unlocatable
  /// The photo did not match the enrolled face closely enough.
  face_mismatch
  /// No face was detectable in the photo.
  no_face_detected

  @@schema("hr")
}

/// A punch that was refused, or in Phase 2 would have been (020 FR-013c).
///
/// **Deliberately no photo column** (plan D20, research §4). A face-mismatch refusal means the
/// system could not establish whose face it is — retaining an unattributed biometric against a named
/// employee is worse than the exception record it replaces, and the photo would be evidence of
/// nothing except that somebody stood in front of a camera. `faceMatchDistance` is kept, because a
/// number is not a biometric.
///
/// This table is how a refused punch stays visible to somebody. Under FR-013a the day reads as no
/// punch at all — which is the point — so without this the refusal would leave no trace anywhere and
/// a worker wrongly refused would have nothing to appeal to.
model PunchRefusal {
  id        String @id @default(cuid())
  companyId String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type PunchType

  reason PunchRefusalReason

  /// Where they were, and how far from the fence. Evidence, so it is the **real** distance rather
  /// than one adjusted by the accuracy allowance.
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  distanceMeters Decimal? @db.Decimal(12, 2)
  accuracyMeters Int?

  /// The face-match distance, when a comparison happened at all. A number, not a biometric.
  faceMatchDistance Decimal? @db.Decimal(6, 4)

  /// When the punch was taken, and when it reached the server — a refused offline punch may arrive
  /// long after the moment it describes.
  capturedAt DateTime
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, employeeId, capturedAt])
  @@schema("hr")
}

/// Which location an employee's punches validate against, and the history of that decision
/// (020 FR-011, FR-014, FR-016).
///
/// **Layered over the site fence, never replacing it.** An employee with no row here is validated
/// against their site's geofence exactly as before — which is every employee on the day this ships,
/// so introducing the table refuses nobody. That fallback is FR-016 and is the whole reason this can
/// be deployed without a backfill.
///
/// **Append-only.** `assign()` writes a new row and never updates a prior one, so a transfer six
/// months ago is still explicable: the row that was in force then is still there, with who decided it
/// and when it took effect.
model EmployeeLocationAssignment {
  id        String @id @default(cuid())
  companyId String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// The site whose fence applies. Null **only** when `isMobile` — see the check constraint.
  siteId String?

  /// FR-014's exemption, and it lives here rather than on `Employee` on purpose: exempting somebody
  /// from location validation is a dated, attributable act, not a property of the person. On
  /// `Employee` it would be a boolean somebody flipped with no record of when or why.
  ///
  /// **Location only.** A mobile employee is refused for a face mismatch exactly as anyone else is —
  /// mobility says where a person legitimately works, and the face check says who is holding the
  /// phone (Clarifications, 2026-09-16).
  isMobile Boolean @default(false)

  /// Resolution keys on this, and on the punch's **day** rather than the request time, so an
  /// offline-queued punch validates against the assignment in force when it was taken.
  effectiveFrom DateTime @db.Date

  /// FR-011's author. A `User` id — the person who decided, not the employee.
  assignedByUserId String

  /// Why, where stated. A mobile exemption without one is unreviewable.
  reason String?

  createdAt DateTime @default(now())

  /// The resolution query's access path, and the only way this table is read on the punch path.
  @@index([employeeId, effectiveFrom])
  @@schema("hr")
}

model PendingAttendanceCorrection {
  id        String @id @default(cuid())
  companyId String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  /// The `MarkAttendanceDto` as submitted — times, status override, remarks. Stored whole
  /// rather than as columns: this is a payload in transit, and mirroring the DTO's fields
  /// here would mean a schema change every time the DTO grew a field.
  payload Json

  /// Who submitted it. Becomes `AttendanceModification.actorUserId` on apply, so the
  /// employee sees the person who asked for the change and not the person who approved it.
  submittedByUserId String

  /// The spine instance governing it. Not a relation: `ApprovalInstance` is in `shared`
  /// and this table is in `hr`, and a foreign key across that boundary is the coupling
  /// Principle I forbids.
  approvalInstanceId String @unique

  appliedAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId, employeeId, date])
  @@schema("hr")
}

/// A waived exit-clearance obligation (021 FR-014b, FR-016, plan D14).
///
/// **The only thing this feature stores.** The clearance itself is *derived* — open asset
/// allocations, unreturned recoverable kit, outstanding advances, open reimbursements, the
/// account's state — read fresh every time it is asked for.
///
/// A stored checklist would be a second copy of custody, stale the moment an asset came back
/// through the asset register. FR-014c requires a return there to satisfy the item here without
/// a second action, and deriving is what makes "returned in the asset module" and "satisfied
/// here" the same fact rather than two facts somebody has to keep in step. FR-014e's "recompute
/// at read time" is therefore not an extra requirement — it is what deriving means.
///
/// A waiver does **not** mark the underlying obligation discharged (FR-014c). It records that
/// the company stopped chasing it, with a name against the decision.
model ExitClearanceWaiver {
  id        String @id @default(cuid())
  companyId String

  exitRecordId String
  exitRecord   ExitRecord @relation(fields: [exitRecordId], references: [id], onDelete: Cascade)

  /// Which kind of obligation — asset custody, recoverable kit, an advance, a reimbursement.
  itemKind String

  /// The obligation's own id in its owning module, so a waiver points at exactly one thing.
  itemRef String

  /// Required, and length-validated in the DTO. A mandatory field satisfied by a space is not a
  /// reason, and this one writes off company money.
  reason String

  waivedByUserId String
  waivedAt       DateTime @default(now())

  /// Who countersigned the waiver (021 FR-016, Phase 8 — added 2026-10-02).
  ///
  /// **Separate from `waivedByUserId`, and the distinction is the point.** The client's answer was
  /// "HR, with a Director countersign": `waivedByUserId` is who *proposed* the write-off, this is
  /// who *agreed* to it. Collapsing the two would lose the fact the answer exists to create —
  /// "HR waived this" and "HR asked and the Director agreed" are different statements about who
  /// is answerable for the money.
  ///
  /// Nullable only for rows written before this phase, which were applied on HR's authority alone.
  /// A waiver created from here always has one.
  approvedByUserId String?
  approvedAt       DateTime?

  @@unique([exitRecordId, itemKind, itemRef])
  @@index([companyId])
  @@schema("hr")
}

/// A waiver somebody has **proposed** but nobody has countersigned yet (021 FR-016, Phase 8).
///
/// A table of its own rather than a status column on `ExitClearanceWaiver`, because the existence
/// of a waiver row is what unblocks a final settlement. A pending proposal living in that table
/// would be one forgotten `where` clause away from clearing an obligation nobody approved — and
/// the forgotten clause would be in a query that still returned sensible-looking data, so nothing
/// would look wrong until a settlement went out.
///
/// The approval spine stores only `(entityType, entityId)` and never dereferences it, so this row's
/// id is what the pending item points at. The reason and the proposer live here and move to the
/// waiver on approval.
model ExitClearanceWaiverProposal {
  id        String @id @default(cuid())
  companyId String

  exitRecordId String
  exitRecord   ExitRecord @relation(fields: [exitRecordId], references: [id], onDelete: Cascade)

  itemKind String
  itemRef  String

  /// Required, for the same reason the waiver's is: this writes off company money.
  reason String

  proposedByUserId String
  proposedAt       DateTime @default(now())

  /// `pending`, `approved` or `rejected`. A string rather than an enum: the spine owns the
  /// lifecycle and this only records where it ended, so a new enum value would be a second place
  /// to keep the same list correct.
  status String @default("pending")

  /// One live proposal per obligation. A second proposal for the same item while one is pending
  /// would put two pending items in the Director's queue for one decision; the service refuses it
  /// and this index is what makes the refusal true rather than likely.
  @@unique([exitRecordId, itemKind, itemRef, status])
  @@index([companyId])
  @@index([status])
  @@schema("hr")
}

model AttendanceModification {
  id         String @id @default(cuid())
  employeeId String

  date        DateTime @db.Date
  actorUserId String
  before      Json
  after       Json
  reason      String?
  createdAt   DateTime @default(now())

  /// **The one honest caveat on FR-012b's "immutable and not deletable"** (016 T081).
  ///
  /// `onDelete: Cascade` means hard-deleting an employee deletes their modification
  /// history with them, which sits awkwardly beside a requirement calling the log
  /// append-only. It is left as a cascade deliberately: breaking it would strand rows
  /// against an employee who no longer exists, which is worse than losing them with her.
  /// Soft-delete is this product's norm and no live path hard-deletes an employee, so
  /// nothing reaches this today — but "append-only" should not be read as "survives
  /// everything", and this is where that is written down.
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@schema("hr")
}

enum ExitReason {
  resignation
  termination
  contract_end

