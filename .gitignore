# Local object-storage blobs written by the dev StorageService adapter (feature 003).
/var/storage

# Generated by the @nestjs/swagger plugin on every build/watch cycle (see nest-cli.json).
# Tracking it meant `nest start --watch` rewrote it continuously and blocked every
# `git pull` with a phantom local change. It is build output — regenerate, don't commit.
src/metadata.ts
