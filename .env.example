# POSTGRES
POSTGRES_USER=prisma
POSTGRES_PASSWORD=topsecret
POSTGRES_DB=buildcore

# Nest run locally
DB_HOST=localhost
# Nest run in docker, change host to database container name
# DB_HOST=postgres
DB_PORT=5432
DB_SCHEMA=public

# Prisma database connection — for hosted Postgres (Neon/Supabase), use the
# provider's pooled connection string here instead (see docs/HLD.md §5.2)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?schema=${DB_SCHEMA}&sslmode=prefer

# Nest
PORT=3000

# CORS_ORIGINS: comma-separated allowed origins for prod (e.g. the deployed
# frontend's URL). Unset locally → allow all origins. Cookies (the refresh
# token) require credentials:true on the server side regardless, already
# wired in src/main.ts — this only controls which origins are allowed at all.
# CORS_ORIGINS=https://app.example.com

# Refresh-cookie SameSite. Defaults to 'none' whenever CORS_ORIGINS is set (a
# split-origin deployment, where 'strict' means the browser never sends the
# cookie at all and refresh/logout break silently) and 'strict' otherwise, so
# local dev keeps the stronger setting. Only override to force a specific value.
# REFRESH_COOKIE_SAMESITE=none

# Security — generate real random values before deploying anywhere
JWT_ACCESS_SECRET=changeme-access-secret
# Used as an HMAC pepper for hashing refresh tokens at rest (they're opaque,
# DB-persisted values, not JWTs) — not a JWT signing secret despite the name.
JWT_REFRESH_SECRET=changeme-refresh-secret

# Lockout (5 attempts / 15 min), refresh-token lifetimes (30d remember-me /
# 1d default), and throttling (10 req / 60s on /auth/*) are currently fixed
# defaults in src/common/configs/config.ts rather than env-driven — flagged
# here so they're easy to find if they need to become configurable later.

# API docs (Swagger at /api). Defaults to ON everywhere except NODE_ENV=production,
# where the generated document would otherwise publish a complete, always-current map
# of every route — including the /workspace-admin/* endpoints that resolve attendance
# exceptions and decide leave. Set to true to re-enable it on a staging deployment.
# SWAGGER_ENABLED=false

# Maximum accepted request body. Enrolment posts 3-5 base64 photos in one JSON body,
# which Express's 100 KB default rejects outright with 413.
# MAX_REQUEST_BODY_SIZE=10mb

# --- Settings module: statutory/payroll defaults (feature 002) ---
# Applied to a company at creation time only; every rate stays per-company
# editable afterwards (FR-002). Env-overridable so a legislated rate change
# doesn't require a code release. Unset = the statutory defaults shown here.
SETTINGS_DEFAULT_PF_EMPLOYER_RATE=12
SETTINGS_DEFAULT_ESIC_EMPLOYER_RATE=3.25
SETTINGS_DEFAULT_GRATUITY_RATE=4.81
SETTINGS_DEFAULT_BONUS_RATE=8.33
# Day-of-month after which attendance edits lock for payroll processing.
SETTINGS_DEFAULT_PAYROLL_LOCK_DAY=7

# --- Database role (row-level security) ---
# The runtime DATABASE_URL MUST point at a NOSUPERUSER, NOBYPASSRLS Postgres role.
# Superusers and BYPASSRLS roles ignore row-level security policies entirely, which
# silently disables this app's multi-tenant isolation — no error is raised. Run
# migrations as the owning/admin role instead; only the app runtime uses this one.
# Verify with:
#   SELECT rolsuper, rolbypassrls FROM pg_roles WHERE rolname = current_user;
# Both must be false. See DEPLOYMENT.md §2a for the role/grant setup.
# Local development role created for this purpose:
#   DATABASE_URL=postgresql://buildcore_app:buildcore_app_dev@localhost:5432/buildcore?schema=public&sslmode=prefer

# --- My Workspace module: biometrics, punch, storage (feature 003) ---
# Face-match strictness: max Euclidean distance between two 128-float descriptors
# for a punch to count as the same person. Lower is stricter; 0.6 is face-api's
# documented default. Tune in the field rather than in code — harsh outdoor site
# lighting can require loosening this, and a too-strict value means a worker
# who physically cannot punch in.
WORKSPACE_FACE_MATCH_DISTANCE_THRESHOLD=0.6
WORKSPACE_MIN_ENROLMENT_PHOTOS=3
WORKSPACE_MAX_ENROLMENT_PHOTOS=5
# How stale an offline-queued punch's client-declared capturedAt may be (FR-012),
# and the clock drift below which a punch is NOT labelled an offline sync.
WORKSPACE_MAX_OFFLINE_AGE_HOURS=72
WORKSPACE_CLOCK_SKEW_TOLERANCE_MINUTES=5
# Approved re-enrolment unlock window, in days (FR-015).
WORKSPACE_REENROLMENT_UNLOCK_DAYS=7
# Punch photos are exception-review evidence, not a permanent record — purged this
# many days after capture. Kept short deliberately: at ~30 KB a photo and two
# punches per employee per day, this is the number that bounds storage cost.
WORKSPACE_PUNCH_PHOTO_RETENTION_DAYS=15
# Re-encode parameters applied before any photo is stored (also strips EXIF, which
# carries phone-embedded GPS we must not persist outside the audited columns).
WORKSPACE_ENROLMENT_PHOTO_MAX_DIMENSION=800
WORKSPACE_ENROLMENT_PHOTO_JPEG_QUALITY=80
WORKSPACE_PUNCH_PHOTO_MAX_DIMENSION=640
WORKSPACE_PUNCH_PHOTO_JPEG_QUALITY=72

# --- Blob storage ---
# 'local' writes AES-256-GCM encrypted files under STORAGE_LOCAL_PATH. That is the
# dev/test default and is NOT viable in production: the deployed host's filesystem
# is ephemeral, so blobs vanish on every redeploy. Production MUST set 's3'.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=var/storage
# 32-byte key, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Blobs are encrypted client-side with this, so the storage provider never holds
# decryptable biometric data. Losing this key makes every stored photo unreadable.
STORAGE_ENCRYPTION_KEY=changeme-64-hex-chars
# Cloudflare R2 (S3-compatible). Endpoint is https://<account-id>.r2.cloudflarestorage.com
# The same settings work against Supabase Storage or Backblaze B2.
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=buildcore-blobs
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# R2 and most S3-compatible providers need path-style addressing; real AWS S3 does not.
# STORAGE_S3_FORCE_PATH_STYLE=true
